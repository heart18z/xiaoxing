<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.system.mapper.PeopleGroupMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="groupResultMap" type="org.springblade.modules.system.entity.PeopleGroup">
        <result column="id" property="id"/>
        <result column="group_name" property="groupName"/>
        <result column="group_type" property="groupType"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="create_user" property="createUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <select id="selectGroupIdByUserId" resultType="java.lang.Long">
        select DISTINCT people_group_id from blade_people_group_child
        where people_id = #{userId}
    </select>


</mapper>
