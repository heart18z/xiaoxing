<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.desk.mapper.GroupUserMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="groupUserResultMap" type="org.springblade.modules.desk.entity.GroupUserEntity">
        <result column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="group_id" property="groupId"/>
    </resultMap>


    <select id="selectGroupUserPage" resultMap="groupUserResultMap">
        select * from blade_group_user where is_deleted = 0
    </select>


    <select id="exportGroupUser" resultType="org.springblade.modules.desk.excel.GroupUserExcel">
        SELECT * FROM blade_group_user ${ew.customSqlSegment}
    </select>

</mapper>
