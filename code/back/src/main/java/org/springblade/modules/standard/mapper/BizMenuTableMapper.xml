<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.standard.mapper.BizMenuTableMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="bizMenuTableResultMap" type="org.springblade.modules.standard.entity.BizMenuTableEntity">
        <result column="id" property="id"/>
        <result column="table_name" property="tableName"/>
        <result column="menu_id" property="menuId"/>
        <result column="table_func" property="tableFunc"/>
        <result column="table_create_time" property="tableCreateTime"/>
        <result column="remark" property="remark"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="datasource_id" property="datasourceId" />
    </resultMap>


    <select id="selectBizMenuTablePage" resultMap="bizMenuTableResultMap">
        select * from blade_biz_menu_table where is_deleted = 0
    </select>


    <select id="exportBizMenuTable" resultType="org.springblade.modules.standard.excel.BizMenuTableExcel">
        SELECT * FROM blade_biz_menu_table ${ew.customSqlSegment}
    </select>

</mapper>
