<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.system.mapper.PropertyRegionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="propertyRegionResultMap" type="org.springblade.modules.system.entity.PropertyRegionEntity">
        <result column="id" property="id"/>
        <result column="property_code" property="propertyCode"/>
        <result column="property_name" property="propertyName"/>
        <result column="admin" property="admin"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="is_sync" property="isSync"/>
    </resultMap>


    <select id="selectPropertyRegionPage" resultMap="propertyRegionResultMap">
        select * from blade_property_region where is_deleted = 0
    </select>


    <select id="exportPropertyRegion" resultType="org.springblade.modules.system.excel.PropertyRegionExcel">
        SELECT * FROM blade_property_region ${ew.customSqlSegment}
    </select>

</mapper>
