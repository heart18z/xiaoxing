<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.modules.system.mapper.InteractiveMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="interactiveResultMap" type="org.springblade.modules.system.entity.InteractiveEntity">
        <result column="id" property="id"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="remark" property="remark"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="interactive_name" property="interactiveName"/>
        <result column="interactive_type" property="interactiveType"/>
        <result column="interactive_method" property="interactiveMethod"/>
        <result column="target_system" property="targetSystem"/>
        <result column="purpose" property="purpose"/>
        <result column="address" property="address"/>
    </resultMap>


    <select id="selectInteractivePage" resultMap="interactiveResultMap">
        select * from blade_interactive where is_deleted = 0
    </select>


    <select id="exportInteractive" resultType="org.springblade.modules.system.excel.InteractiveExcel">
        SELECT * FROM blade_interactive ${ew.customSqlSegment}
    </select>

</mapper>
