<template>
  <view class="select" :style="{ zIndex: rendered ? 20 : 1 }">
    <view :id="fieldId" :class="['select-field', open ? 'focused' : '']" @click="toggle()">
      <text class="app-font value">{{ options[value] }}</text>
      <view class="select-arrow" :style="{ transform: open ? 'rotate(180deg)' : 'rotate(0deg)' }">
        <UiIcon name="down" :size="17" />
      </view>
    </view>
    <!-- #ifndef WEB -->
    <view v-if="rendered" class="select-dismiss" @click="close()" />
    <!-- #endif -->
    <view v-if="rendered" class="options" :style="optionsStyle">
      <scroll-view :scroll-y="true" :style="{ height: listHeight + 'px' }" :bounces="false">
        <view
          v-for="(option, index) in options"
          :key="index"
          :class="['option', index == value ? 'chosen' : '']"
          @click="choose(index)"
        >
          <text class="app-font" :class="['option-text', index == value ? 'chosen-text' : '']">
            {{ option }}
          </text>
          <text v-if="index == defaultIndex" class="app-font badge">系统默认</text>
        </view>
      </scroll-view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { ref, computed, onUnmounted } from 'vue';
import { dropdownRect } from '@/core/overlayLayout.uts';
import UiIcon from './UiIcon.uvue';
const props = defineProps({
  options: { type: Array as PropType<string[]>, default: (): string[] => [] },
  value: { type: Number, default: 0 },
  defaultIndex: { type: Number, default: -1 },
});
const emit = defineEmits(['change']);
const fieldId = 'select-' + Math.random().toString(36).slice(2);
const panelLeft = ref(0),
  panelTop = ref(0),
  panelWidth = ref(0);
const panelHeight = ref(0);
const listHeight = computed((): number => {
  // #ifndef WEB
  return Math.max(0, panelHeight.value - 14);
  // #endif
  // #ifdef WEB
  return Math.min(props.options.length * 48, 260);
  // #endif
});
const open = ref(false),
  rendered = ref(false);
const optionsStyle = computed((): UTSJSONObject => {
  const opacity = open.value ? 1 : 0;
  const transform = open.value ? 'translateY(0px) scale(1)' : 'translateY(-8px) scale(0.98)';
  // Explicit properties avoid spreading UTSJSONObject into a Kotlin map.
  // #ifndef WEB
  return {
    left: panelLeft.value + 'px',
    top: panelTop.value + 'px',
    width: panelWidth.value + 'px',
    opacity: opacity,
    transform: transform,
  };
  // #endif
  // #ifdef WEB
  return { opacity: opacity, transform: transform };
  // #endif
});
let animationTimer: number = 0;
function close() {
  clearTimeout(animationTimer);
  open.value = false;
  animationTimer = setTimeout(() => {
    rendered.value = false;
  }, 200);
}
function toggle() {
  if (open.value) {
    close();
    return;
  }
  clearTimeout(animationTimer);
  // Native fixed elements are hosted at the page root, outside the settings scroll-view.
  // #ifndef WEB
  const element = uni.getElementById(fieldId);
  if (element == null) return;
  const rect = element.getBoundingClientRect();
  const info = uni.getWindowInfo();
  const panel = dropdownRect(
    { left: rect.left, top: rect.top, width: rect.width, height: rect.height },
    info.windowWidth,
    info.windowHeight,
    info.safeAreaInsets.top,
    info.safeAreaInsets.bottom,
    props.options.length,
  );
  panelLeft.value = panel.left;
  panelTop.value = panel.top;
  panelWidth.value = panel.width;
  panelHeight.value = panel.height;
  // #endif
  rendered.value = true;
  animationTimer = setTimeout(() => {
    open.value = true;
  }, 30);
}
onUnmounted(() => clearTimeout(animationTimer));
onHide(() => {
  clearTimeout(animationTimer);
  open.value = false;
  rendered.value = false;
});
function choose(index: number) {
  if (!open.value) return;
  close();
  emit('change', index);
}
</script>
<style scoped>
.select {
  position: relative;
  margin-bottom: 14px;
  overflow: visible;
}
.select-field {
  height: 46px;
  padding: 0 13px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #f9faff;
  border: 1px solid #e0e2ea;
  border-radius: 14px;
}
.focused {
  border-color: #949bdc;
  box-shadow: 0 0 0 3px #8999d814;
}
.value {
  font-size: 16px;
  color: #4b5565;
  flex: 1;
}
.select-arrow {
  transition-property: transform;
  transition-duration: 200ms;
  transition-timing-function: ease-out;
}
.options {
  transition-property: opacity, transform;
  transition-duration: 200ms;
  transition-timing-function: ease-out;
  position: absolute;
  top: 58px;
  left: 0;
  right: 0;
  border-radius: 16px;
  padding: 6px;
  background-color: #ffffff;
  border: 1px solid #e7e9f0;
  box-shadow: 0 9px 20px #67759420;
  z-index: 30;
}
.option {
  height: 48px;
  flex-shrink: 0;
  padding: 0 12px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-radius: 9px;
}
.chosen {
  background-color: #edf2ff;
}
.option-text {
  font-size: 14px;
  line-height: 24px;
  color: #56606f;
}
.chosen-text {
  color: #5964d6;
  font-weight: 600;
}
.badge {
  font-size: 10px;
  color: #727fc0;
  margin-left: 8px;
}
/* #ifdef WEB */
@media (prefers-reduced-motion: reduce) {
  .options,
  .select-arrow {
    transition-duration: 0ms;
  }
}
/* #endif */
/* #ifndef WEB */
.options {
  position: fixed;
  right: auto;
  z-index: 201;
  flex-shrink: 0;
}
.select-dismiss {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
}
/* #endif */
</style>
