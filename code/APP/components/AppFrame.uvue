<template>
  <view class="frame" :style="frameStyle">
    <image class="background" :src="background" mode="scaleToFill" />
    <view style="flex-shrink: 0" :style="{ height: top + 'px' }" />
    <view
      v-if="theme != 'profile'"
      :class="[
        'header',
        tab == 'events' ? 'events-header' : '',
        theme == 'chat' ? 'chat-header' : '',
      ]"
    >
      <view v-if="backButton" class="back-button" @click="back()">
        <text class="app-font back-glyph">‹</text>
      </view>
      <view v-if="theme == 'chat'" class="chat-side"><slot name="left" /></view>
      <view :class="['header-title', theme == 'chat' ? 'center-title' : '']">
        <text
          class="app-font"
          :class="[
            'title',
            tab == 'events' ? 'events-title' : '',
            theme == 'chat' ? 'chat-title' : '',
          ]"
        >
          {{ title }}
        </text>
        <text v-if="subtitle.length > 0" class="app-font subtitle">{{ subtitle }}</text>
      </view>
      <view :class="['right', theme == 'chat' ? 'chat-side' : '']"><slot name="right" /></view>
    </view>
    <view class="content">
      <slot />
    </view>
    <view
      v-if="tab.length > 0"
      class="dock"
      :style="{
        paddingBottom: keyboardHeight > 0 ? '0px' : bottom + 'px',
        height: keyboardHeight > 0 ? '0px' : 68 + bottom + 'px',
      }"
    >
      <view class="tab" @click="go('events')">
        <view :class="['tab-inner', tab == 'events' ? 'tab-selected' : '']">
          <view v-if="tab == 'events'" class="tab-marker" />
          <view :class="['calendar', tab == 'events' ? 'calendar-active' : '']">
            <view :class="['binder binder-left', tab == 'events' ? 'binder-active' : '']" />
            <view :class="['binder binder-right', tab == 'events' ? 'binder-active' : '']" />
            <text class="app-font" :class="['counter', tab == 'events' ? 'active' : '']">
              {{ n(session.summary, 'activeEventCount') }}
            </text>
          </view>
          <text class="app-font" :class="['tab-label', tab == 'events' ? 'active' : '']">
            {{ t('事件') }}
          </text>
        </view>
      </view>
      <view class="tab" @click="go('chat')">
        <view :class="['tab-inner', tab == 'chat' ? 'tab-selected' : '']">
          <view v-if="tab == 'chat'" class="tab-marker" />
          <image class="ai-icon" src="/static/images/ai-assistant-tab.png" mode="aspectFit" />
          <text class="app-font" :class="['tab-label', tab == 'chat' ? 'active' : '']">
            {{ t('AI助手') }}
          </text>
        </view>
      </view>
      <view class="tab" @click="go('me')">
        <view :class="['tab-inner', tab == 'me' ? 'tab-selected' : '']">
          <view v-if="tab == 'me'" class="tab-marker" />
          <!-- #ifdef WEB -->
          <image
            class="people-icon"
            :src="'/static/icons/tab-people-' + (tab == 'me' ? 'active' : 'muted') + '.svg'"
          />
          <!-- #endif -->
          <!-- #ifndef WEB -->
          <image
            class="people-icon"
            :src="'/static/icons/tab-people-' + (tab == 'me' ? 'active' : 'muted') + '.png'"
          />
          <!-- #endif -->
          <view v-if="n(session.summary, 'pendingFriendRequests') > 0" class="nav-badge">
            <text class="app-font nav-badge-text">
              {{
                n(session.summary, 'pendingFriendRequests') > 99
                  ? '99+'
                  : n(session.summary, 'pendingFriendRequests').toString()
              }}
            </text>
          </view>
          <text class="app-font" :class="['tab-label', tab == 'me' ? 'active' : '']">
            {{ t('我的') }}
          </text>
        </view>
      </view>
    </view>
  </view>
  <PageLoading :active="loading" />
  <TopTip />
</template>
<script setup lang="uts">
import { startupReady } from '@/store/startup.uts';
import PageLoading from './PageLoading.uvue';
import TopTip from '@/components/TopTip.uvue';
import UiIcon from '@/components/UiIcon.uvue';
import { t as _t } from '@/core/locale.uts';
import { computed, onMounted } from 'vue';
import { SessionState, session as _session } from '@/store/session.uts';
import { n as _n } from '@/core/json.uts';
import { back as _back } from '@/core/ui.uts';
const session: SessionState = _session;
function t(value: string): string {
  return _t(value);
}
function n(row: UTSJSONObject, key: string): number {
  return _n(row, key);
}
function back(): void {
  _back();
}
const props = defineProps({
  keyboardHeight: { type: Number, default: 0 },
  loading: { type: Boolean, default: false },
  title: { type: String, default: '' },
  subtitle: { type: String, default: '' },
  tab: { type: String, default: '' },
  theme: { type: String, default: 'events' },
  backButton: { type: Boolean, default: false },
});
const info = uni.getWindowInfo(),
  top = info.statusBarHeight,
  bottom = info.safeAreaInsets.bottom;
// Avoid applying the same keyboard displacement twice when the OS resizes the window.
const keyboardInset = computed((): number => {
  const resized = Math.max(0, info.windowHeight - uni.getWindowInfo().windowHeight);
  return Math.max(0, props.keyboardHeight - resized);
});
const frameStyle = computed((): UTSJSONObject => {
  // iOS overlays the keyboard; size the fixed frame itself, never its padding.
  // A fixed top/bottom frame also remains bounded after the native tab bar hides.
  // #ifdef APP-IOS
  return { bottom: props.keyboardHeight + 'px' };
  // #endif
  // #ifndef APP-IOS
  return { paddingBottom: keyboardInset.value + 'px' };
  // #endif
});
const background = computed(
  () =>
    '/static/images/' +
    (props.theme == 'chat'
      ? 'chat-background-v2.jpg'
      : props.theme == 'profile'
        ? 'profile-background.jpg'
        : 'events-background-v2.jpg'),
);
onMounted(() => {
  if (props.tab.length > 0) uni.hideTabBar({ animation: false, fail: () => {} });
  startupReady();
});
function go(tab: string) {
  if (props.tab == tab) return;
  uni.switchTab({ url: '/pages/' + tab + '/index' });
}
</script>
<style scoped>
