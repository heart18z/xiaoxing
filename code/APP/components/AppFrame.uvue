  margin-right: 12px;
  border-radius: 12px;
  background-color: #ffffffbb;
  align-items: center;
  justify-content: center;
}
.back-glyph {
  font-size: 28px;
  font-weight: 700;
  color: #607a9e;
  line-height: 32px;
}
.page-enter {
  transition-property: opacity, transform;
  transition-duration: 220ms;
  transition-timing-function: ease-out;
}
.events-header .subtitle {
  font-size: 14px;
}
.content {
  overflow: hidden;
  flex: 1;
  min-height: 0;
}
.dock {
  flex-shrink: 0;
  overflow: hidden;
  flex-direction: row;
  background-color: #ffffffee;
  border-top-left-radius: 22px;
  border-top-right-radius: 22px;
}
/* #ifdef APP-IOS */
.dock {

}
/* #endif */
.tab {
  flex: 1;
  align-items: center;
  padding-top: 8px;
}
.tab-inner {
  overflow: visible;
  width: 76px;
  height: 51px;
  align-items: center;
  justify-content: center;
  border-radius: 24px;
}
.tab-selected {
  /* #ifdef WEB */
  background-image: linear-gradient(145deg, #eaf7ff, #f6f2ff);
  /* #endif */
  /* #ifndef WEB */
  background-image: linear-gradient(to bottom right, #eaf7ff, #f6f2ff);
  /* #endif */
}
.tab-marker {
  position: absolute;
  top: -3px;
  width: 18px;
