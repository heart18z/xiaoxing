  border-radius: 3px;
  /* #ifdef WEB */
  background-image: linear-gradient(90deg, #71c5f7, #8882f5);
  /* #endif */
  /* #ifndef WEB */
  background-image: linear-gradient(to right, #71c5f7, #8882f5);
  /* #endif */
}
.tab-label {
  font-size: 12px;
  margin-top: 3px;
  color: #999eb0;
}
