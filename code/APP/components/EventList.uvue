<template>
  <scroll-view
    :scroll-y="true"
    class="scroll event-list"
    refresher-enabled
    :refresher-triggered="refreshing"
    refresher-default-style="none"
    @refresherrefresh="emit('refresh')"
  >
    <view slot="refresher" class="refresh-status">
      <view
        v-if="refreshing && !refreshComplete"
        class="refresh-orbit"
        :style="{ transform: 'rotate(' + refreshAngle + 'deg)' }"
      />
      <text class="app-font refresh-label">
        {{
          refreshing
            ? refreshComplete
              ? error.length > 0
                ? t('更新失败，请重试')
                : t('事件已更新')
              : t('正在更新事件…')
            : t('下拉刷新，松开更新')
        }}
      </text>
    </view>
    <view class="padded">
      <view v-if="error.length > 0" class="card">
        <text class="app-font error">{{ error }}</text>
        <button class="app-font secondary" @click="emit('retry')">{{ t('重新加载') }}</button>
      </view>
      <view v-if="!loading && rows.length == 0" class="empty">
        <text class="app-font muted">{{ t('当前筛选下还没有事件') }}</text>
      </view>
      <view
        v-for="item in rows"
        :key="s(item, 'id')"
        class="card event-card"
        @click="openEvent(s(item, 'id'))"
      >
        <view class="event-top">
          <view
            :class="[
              'status',
              s(item, 'branchStatus', s(item, 'eventStatus')) == 'ACTIVE' ? '' : 'status-inactive',
            ]"
          >
            <view
              :class="[
                'status-dot',
                s(item, 'branchStatus', s(item, 'eventStatus')) == 'ACTIVE' ? '' : 'dot-inactive',
              ]"
            />
            <text
              class="app-font"
              :class="[
                'status-text',
                s(item, 'branchStatus', s(item, 'eventStatus')) == 'ACTIVE' ? '' : 'text-inactive',
              ]"
            >
              {{ statusText(s(item, 'branchStatus', s(item, 'eventStatus'))) }}
            </text>
          </view>
          <text class="app-font event-number">{{ s(item, 'eventNo') }}</text>
          <UiIcon name="chevron" :size="16" />
        </view>
        <text class="app-font event-title">{{ s(item, 'eventSummary') }}</text>
        <view class="people">
          <view v-if="people(item).length > 0" class="people-avatars">
            <image
              v-for="person in people(item)"
              :key="s(person, 'id')"
              class="person-avatar"
              :src="personAvatar(person)"
              mode="aspectFill"
            />
            <view
              v-if="type == 'sent' && n(item, 'recipientCount') > people(item).length"
              class="people-more"
            >
              <text class="app-font people-more-label">
                +{{ n(item, 'recipientCount') - people(item).length }}
              </text>
            </view>
          </view>
          <UiIcon v-else name="people" :size="17" />
          <text class="app-font muted">
            {{
              type == 'received'
                ? creatorLabel(item)
                : t('接收人 ') +
                  n(item, 'recipientCount') +
                  t(' 人 · 进行中 ') +
                  n(item, 'activeBranchCount') +
                  t(' 人')
            }}
          </text>
        </view>
        <view class="progress">
          <UiIcon name="note" tone="blue" :size="19" />
          <text class="app-font progress-label">{{ t('最新进展') }}</text>
          <text class="app-font progress-text">
            {{ progressText(item) }}
          </text>
        </view>
        <view class="event-dates">
          <view class="date-row">
            <UiIcon name="clock" :size="17" />
            <text class="app-font muted">
              {{ t('创建时间') }}　{{ displayTime(s(item, 'createTime')) }}
            </text>
          </view>
          <view class="date-row">
            <UiIcon name="calendar" :size="17" />
            <text class="app-font muted">
              {{ t('下次评估') }}　{{ s(item, 'nextEvaluateTime', t('无')) }}
            </text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
import { asset, openEvent } from '@/core/ui.uts';
import { arr, firstText, s as _s, n as _n } from '@/core/json.uts';
import UiIcon from './UiIcon.uvue';
import { latestProgress } from '@/core/events.uts';
import { t as _t } from '@/core/locale.uts';
import { statusText as _statusText, displayTime as _displayTime } from '@/core/time.uts';
const props = defineProps({
  rows: { type: Array as PropType<UTSJSONObject[]>, default: (): UTSJSONObject[] => [] },
  type: { type: String, default: 'sent' },
  loading: { type: Boolean, default: false },
  error: { type: String, default: '' },
  refreshing: { type: Boolean, default: false },
  refreshComplete: { type: Boolean, default: false },
  refreshAngle: { type: Number, default: 0 },
});
const emit = defineEmits(['refresh', 'retry']);
function t(value: string): string {
  return _t(value);
}
function progressText(item: UTSJSONObject): string {
  return _t(latestProgress(item));
}
function s(row: UTSJSONObject, key: string, fallback: string = ''): string {
  return _s(row, key, fallback);
}
function n(row: UTSJSONObject, key: string): number {
  return _n(row, key);
}
function displayTime(value: string): string {
  return _displayTime(value);
}
function statusText(value: string): string {
  return _statusText(value);
}
function creatorLabel(item: UTSJSONObject): string {
  return _t('发起人：') + firstText(item, ['creatorName', 'creatorRealName']);
}
function people(item: UTSJSONObject): UTSJSONObject[] {
  return arr(item, 'people').slice(0, 4);
}
function personAvatar(person: UTSJSONObject): string {
  const url = s(person, 'avatar').trim();
  return asset(url.length > 0 ? url : '/avatars/user/B1.png');
}
</script>
<style scoped>
.event-list {
  height: 100%;
  flex: 1;
}

.people-avatars {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  padding-left: 4px;
  padding-right: 9px;
  border-right: 1px solid #e5eaf4;
}
.person-avatar {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  border: 2px solid #ffffff;
  margin-left: -4px;
  background-color: #eef2ff;
}
.people-more {
  min-width: 30px;
  height: 30px;
  padding: 0 3px;
  border-radius: 15px;
  border: 2px solid #ffffff;
  margin-left: -2px;
  background-color: #eff3ff;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.people-more-label {
  color: #7886a4;
  text-align: center;
  font-size: 11px;
  line-height: 20px;
}

.padded {
  padding: 0 17px 4px;
}
.event-card {
  padding: 16px 17px 18px;
  border-radius: 22px;
  margin-bottom: 13px;
}
.event-top {
  flex-direction: row;
  align-items: center;
}
.status {
  flex-direction: row;
  align-items: center;
  padding: 5px 9px;
  border-radius: 11px;
  background-color: #eeefff;
}
.status-dot {
  width: 7px;
  height: 7px;
  background-color: #315bff;
  border-radius: 4px;
  margin-right: 6px;
}
.status-text {
  font-size: 12px;
  line-height: 18px;
  font-weight: 600;
  color: #315bff;
}
.status-inactive {
  background-color: #f0f2f7;
}
.dot-inactive {
  background-color: #9ba5b7;
}
.text-inactive {
  color: #8f96a5;
}
.event-number {
  flex: 1;
  min-width: 0;
  font-size: 11px;
  color: #9295a1;
  margin-left: 12px;
  padding-left: 12px;
  border-left: 1px solid #e1e6f0;
}
.event-title {
  font-size: 16px;
  line-height: 25px;
  font-weight: 700;
  color: #182138;
  margin: 12px 0 9px;
}
.people {
  flex-direction: row;
  align-items: center;
}
.progress {
  flex-direction: row;
  align-items: center;
  padding: 11px 10px;
  margin: 13px 0 11px;
  /* #ifdef WEB */
  background-image: linear-gradient(100deg, #f1f3ff, #f7f7fc);
  /* #endif */
  /* #ifndef WEB */
  background-image: linear-gradient(to right, #f1f3ff, #f7f7fc);
  /* #endif */
  border-radius: 12px;
}
.progress-label {
  flex-shrink: 0;
  font-size: 12px;
  font-weight: 600;
  color: #2856e4;
  margin-left: 8px;
  margin-right: 8px;
}
.progress-text {
  flex: 1;
  min-width: 0;
  font-weight: 500;
  lines: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  border-left: 1px solid #ccd5e7;
  padding-left: 9px;
  font-size: 12px;
  line-height: 19px;
  color: #35415c;
}
.event-dates {
  border-top: 1px solid #edf0f6;
  padding-top: 7px;
}
.date-row {
  flex-direction: row;
  align-items: center;
  margin-top: 4px;
}
.muted {
  color: #9699a5;
}
.people .muted {
  flex: 1;
  min-width: 0;
  margin-left: 9px;
}
.date-row .muted {
  font-size: 12px;
  margin-left: 9px;
}
.refresh-status {
  height: 58px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.refresh-orbit {
  width: 15px;
  height: 15px;
  border: 2px solid #dce6ff;
  border-top-color: #537cff;
  border-radius: 9px;
  margin-right: 8px;
  transition-property: transform;
  transition-duration: 50ms;
  transition-timing-function: linear;
}
.refresh-label {
  color: #7189bc;
  font-size: 12px;
  background-color: #edf3ff;
  border-radius: 15px;
  padding: 7px 18px;
}
