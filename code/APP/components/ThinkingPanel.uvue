<template>
  <view :id="panelId" class="thinking-panel">
    <view class="thinking-toggle" @click.stop="emit('toggle')">
      <view
        :class="['thinking-mark', streaming ? 'thinking-active' : '']"
        :style="{ opacity: streaming && pulse ? 0.55 : 1 }"
      >
        <UiIcon name="spark" tone="blue" :size="15" />
      </view>
      <view class="thinking-label-wrap">
        <text class="app-font thinking-label">{{ streaming ? t('正在思考…') : t('AI 思考') }}</text>
        <view v-if="streaming" class="thinking-shimmer" :style="{ transform: 'translateX(' + shine + 'px)' }" />
      </view>
      <text class="app-font thinking-action">{{ open ? t('收起') : t('查看') }}</text>
      <view
        class="thinking-chevron"
        :style="{ transform: open ? 'rotate(90deg)' : 'rotate(0deg)' }"
      >
        <UiIcon name="chevron" :size="20" />
      </view>
    </view>
    <view class="thinking-window" :style="{ height: windowOpen ? '146px' : '0px' }">
    <scroll-view :scroll-y="true" class="thinking-content" :scroll-into-view="anchor">
      <text class="app-font thinking-text" selectable>{{ displayed }}</text>
      <view id="reasoning-end" style="height: 1px" />
    </scroll-view>
    </view>
  </view>
</template>
<script setup lang="uts">
import UiIcon from './UiIcon.uvue';
import { ref, watch, nextTick, onUnmounted, onMounted } from 'vue';
import { t as _t } from '@/core/locale.uts';
const props = defineProps<{ content: string; open: boolean; streaming: boolean; panelId: string }>();
const emit = defineEmits(['toggle', 'layout']);
const shine = ref(-90);
const windowOpen = ref(false);
let settleTimer: number = 0;
function settledLayout() { clearTimeout(settleTimer); settleTimer = setTimeout(() => { emit('layout'); }, 200); }
onUnmounted(() => clearTimeout(settleTimer));
onMounted(() => { nextTick(() => { windowOpen.value = props.open; emit('layout'); settledLayout(); }); });
watch((): boolean => props.open, (open: boolean) => { windowOpen.value = open; });
const anchor = ref('');
const displayed = ref('');
let revealTimer: number = 0;
function revealContent() {
  clearInterval(revealTimer);
  if (!props.streaming || !props.content.startsWith(displayed.value)) {
    displayed.value = props.content;
    return;
  }
  // Reveal only text already received from the server; snapshots can arrive in bursts.
  revealTimer = setInterval(() => {
    const remaining = props.content.length - displayed.value.length;
    if (remaining <= 0) {
      clearInterval(revealTimer);
      return;
    }
    displayed.value = props.content.slice(
      0,
      displayed.value.length + Math.max(2, Math.ceil(remaining / 12)),
    );
  }, 32);
}
watch((): string => props.content, revealContent, { immediate: true });
watch((): boolean => props.streaming, revealContent);
onUnmounted(() => clearInterval(revealTimer));
const pulse = ref(false);
let pulseTimer: number = 0;
function stopPulse() {
  if (pulseTimer > 0) clearInterval(pulseTimer);
  pulseTimer = 0;
  pulse.value = false;
}
watch(
  (): boolean => props.streaming,
  (streaming: boolean) => {
    stopPulse();
    if (streaming)
      pulseTimer = setInterval(() => {
        shine.value = ((Date.now() % 1800) / 1800) * 220 - 90;
      }, 40);
  },
  { immediate: true },
);
onUnmounted(stopPulse);
function t(value: string): string {
  return _t(value);
}
watch(
  (): string => displayed.value,
  () => {
    if (!props.open || !props.streaming) return;
    anchor.value = '';
    nextTick(() => {
      anchor.value = 'reasoning-end';
    });
  },
);
watch((): boolean => props.open, () => { nextTick(() => { emit('layout'); settledLayout(); }); });
</script>
<style scoped>
.thinking-panel {
  width: 100%;
}
.thinking-toggle {
  flex-direction: row;
  align-items: center;
  padding: 1px 0 9px;
  border-bottom: 1px solid #edf0f6;
}
.thinking-chevron {
  width: 28px;
  height: 28px;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.thinking-mark {
  width: 22px;
  height: 22px;
  border-radius: 8px;
  background-color: #eef2ff;
  align-items: center;
  justify-content: center;
  margin-right: 7px;
}
.thinking-active {
  background-color: #dce5ff;
}
.thinking-label-wrap { flex: 1; flex-direction: row; }
.thinking-shimmer { position: absolute; top: 0; bottom: 0; left: 0; width: 40px; background-image: linear-gradient(to right, #ffffff00, #ffffffbb, #ffffff00); transition-property: transform; transition-duration: 40ms; transition-timing-function: linear; }
.thinking-label-wrap { position: relative; overflow: hidden; }
.thinking-label {
  color: #596780;
  font-size: 13px;
  font-weight: 600;
}
.thinking-action {
  color: #9aa4b5;
  font-size: 11px;
  margin-right: 8px;
}
.thinking-window { overflow: hidden; transition-property: height; transition-duration: 180ms; transition-timing-function: ease-out; }
.thinking-content {
  height: 138px;
  flex-shrink: 0;
  margin-top: 8px;
}
.thinking-text {
  font-size: 12px;
  line-height: 20px;
  color: #747f94;
  padding: 2px 1px 4px;
}
</style>
