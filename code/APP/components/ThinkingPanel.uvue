<template>
  <view :id="panelId" class="thinking-panel">
    <view class="thinking-toggle" @click.stop="emit('toggle')">
      <view
        :class="['thinking-mark', streaming ? 'thinking-active' : '']"
        :style="{ opacity: streaming && pulse ? 0.55 : 1 }"
      >
        <UiIcon name="spark" tone="blue" :size="15" />
      </view>
      <view class="thinking-label-wrap">
        <text class="app-font thinking-label">{{ streaming ? t('正在思考…') : t('AI 思考') }}</text>
        <view v-if="streaming && visible != false" class="thinking-shimmer" :style="{ transform: 'translateX(' + shine + 'px)' }" />
      </view>
      <text class="app-font thinking-action">{{ open ? t('收起') : t('查看') }}</text>
      <view
        class="thinking-chevron"
        :style="{ transform: open ? 'rotate(90deg)' : 'rotate(0deg)' }"
      >
        <UiIcon name="chevron" :size="20" />
      </view>
    </view>
    <view class="thinking-window" :style="{ height: windowOpen ? '146px' : '0px' }">
    <scroll-view v-if="windowOpen && visible != false" :scroll-y="true" :id="panelId + '-scroll'" class="thinking-content" @touchstart="following = false">
      <view :id="panelId + '-text'"><text class="app-font thinking-text" selectable>{{ displayed }}</text></view>
    </scroll-view>
    </view>
  </view>
</template>
<script setup lang="uts">
import UiIcon from './UiIcon.uvue';
import { ref, watch, nextTick, onUnmounted, onMounted } from 'vue';
import { t as _t } from '@/core/locale.uts';
const props = defineProps<{ content: string; open: boolean; streaming: boolean; panelId: string; visible?: boolean }>();
const emit = defineEmits(['toggle', 'layout']);
const shine = ref(-90), pulse = ref(false), windowOpen = ref(props.open);
// Keep received text when a cached page becomes visible; never replay from an empty label.
const displayed = ref(props.content);
let settleTimer: number = 0, revealTimer: number = 0, pulseTimer: number = 0, scrollTimer: number = 0;
let following = true;
function settledLayout() { clearTimeout(settleTimer); settleTimer = setTimeout(() => { if (props.visible != false) emit('layout'); }, 200); }
function followText() {
  if (scrollTimer != 0 || props.visible == false || !props.open || !props.streaming || !following) return;
  scrollTimer = setTimeout(() => {
    scrollTimer = 0;
    nextTick(() => {
      if (props.visible == false || !props.open || !following) return;
      // Do not toggle scroll-into-view to an empty ID for every text fragment on iOS.
      // #ifdef APP
      const viewport = uni.getElementById(props.panelId + '-scroll');
      const content = uni.getElementById(props.panelId + '-text');
      if (viewport != null && content != null) {
        const target = Math.max(0, content.getBoundingClientRect().height - viewport.getBoundingClientRect().height);
        if (Math.abs(viewport.scrollTop - target) > 1) viewport.scrollTop = target;
      }
      // #endif
      // #ifdef WEB
      const browserViewport = document.getElementById(props.panelId + '-scroll');
      if (browserViewport != null) browserViewport.scrollTop = browserViewport.scrollHeight;
      // #endif
    });
  }, 100);
}
function stopReveal() { clearInterval(revealTimer); revealTimer = 0; }
function revealContent() {
  if (props.visible == false) { stopReveal(); return; }
  if (!props.streaming || !props.content.startsWith(displayed.value)) {
    stopReveal(); displayed.value = props.content; return;
  }
  if (revealTimer != 0 || props.content == displayed.value) return;
  revealTimer = setInterval(() => {
    const remaining = props.content.length - displayed.value.length;
    if (remaining <= 0 || props.visible == false) { stopReveal(); return; }
    let end = Math.min(props.content.length, displayed.value.length + Math.max(2, Math.ceil(remaining / 8)));
    const last = props.content.charCodeAt(end - 1) ?? 0;
    if (end < props.content.length && last >= 0xd800 && last <= 0xdbff) end++;
    displayed.value = props.content.slice(0, end);
  }, 50);
}
function updatePulse() {
  clearInterval(pulseTimer); pulseTimer = 0;
  if (props.streaming && props.visible != false) pulseTimer = setInterval(() => {
    shine.value = ((Date.now() % 1800) / 1800) * 220 - 90;
  }, 80);
}
watch((): string => props.content, revealContent);
watch((): boolean => props.streaming, () => { revealContent(); updatePulse(); });
watch((): boolean => props.visible != false, (visible: boolean) => {
  stopReveal(); clearTimeout(scrollTimer); scrollTimer = 0;
  if (visible) { displayed.value = props.content; nextTick(followText); }
  updatePulse();
});
watch((): string => displayed.value, followText);
watch((): boolean => props.open, (open: boolean) => {
  windowOpen.value = open; following = true;
  nextTick(() => { if (props.visible != false) emit('layout'); settledLayout(); followText(); });
});
onMounted(() => { updatePulse(); nextTick(followText); });
onUnmounted(() => { stopReveal(); clearInterval(pulseTimer); clearTimeout(scrollTimer); clearTimeout(settleTimer); });
function t(value: string): string { return _t(value); }
</script>
<style scoped>
.thinking-panel {
  width: 100%;
}
.thinking-toggle {
  flex-direction: row;
  align-items: center;
  padding: 1px 0 9px;
  border-bottom: 1px solid #edf0f6;
}
.thinking-chevron {
  width: 28px;
  height: 28px;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.thinking-mark {
  width: 22px;
  height: 22px;
  border-radius: 8px;
  background-color: #eef2ff;
  align-items: center;
  justify-content: center;
  margin-right: 7px;
}
.thinking-active {
  background-color: #dce5ff;
}
.thinking-label-wrap { flex: 1; flex-direction: row; }
.thinking-shimmer { position: absolute; top: 0; left: 0; width: 40px; height: 20px; background-image: linear-gradient(to right, #ffffff00, #ffffffbb, #ffffff00); transition-property: transform; transition-duration: 40ms; transition-timing-function: linear; }
.thinking-label-wrap { position: relative; overflow: hidden; }
.thinking-label {
  color: #596780;
  font-size: 13px;
  font-weight: 600;
}
.thinking-action {
  color: #9aa4b5;
  font-size: 11px;
  margin-right: 8px;
}
.thinking-window { overflow: hidden; transition-property: height; transition-duration: 180ms; transition-timing-function: ease-out; }
.thinking-content {
  height: 138px;
  flex-shrink: 0;
  margin-top: 8px;
}
.thinking-text {
  font-size: 12px;
  line-height: 20px;
  color: #747f94;
  padding: 2px 1px 4px;
}
</style>
