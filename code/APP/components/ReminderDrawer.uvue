  transition-property: opacity;
  transition-duration: 240ms;
  transition-timing-function: ease-out;
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background-color: rgba(24, 30, 42, 0.56);
}
.drawer {
  transition-property: transform;
  transition-duration: 240ms;
  transition-timing-function: ease-out;
  width: 92%;
  max-width: 560px;
  height: 100%;
  padding: 28px 12px 24px;
  /* #ifdef WEB */
  background-image: linear-gradient(125deg, #f8fbff, #eef4ff, #f8fbff);
  /* #endif */
  /* #ifndef WEB */
  background-image: linear-gradient(to bottom right, #f8fbff, #f8fbff);
  /* #endif */
  border-top-right-radius: 26px;
  border-bottom-right-radius: 26px;
}
.drawer-heading {
  flex-direction: row;
  align-items: center;
  padding: 0 6px;
}
.drawer-title {
  font-size: 23px;
  font-weight: 700;
  color: #13234b;
}
.drawer-subtitle {
  font-size: 13px;
  color: #8b91a8;
  margin-top: 7px;
}
.drawer-close {
  width: 42px;
  height: 42px;
  border: 1px solid #ffffff;
  border-radius: 21px;
  align-items: center;
  justify-content: center;
}
.drawer-filter {
  flex-direction: row;
  margin-top: 19px;
}
.date-filter {
  flex: 1;
  min-width: 0;
  flex-direction: row;
  align-items: center;
  min-height: 46px;
  padding: 0 10px 0 7px;
  background-color: #ffffffc9;
  border: 1px solid #e2e9f6;
  border-radius: 15px;
}
.date-icon {
  width: 29px;
  height: 29px;
  border-radius: 10px;
  background-color: #edf3ff;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
}
.date-label {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  color: #969cad;
  line-height: 19px;
}
.reset {
  min-width: 64px;
  padding: 0 10px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border: 1px solid #e2e9f6;
  border-radius: 15px;
  background-color: #f3f5ff;
  margin-left: 8px;
}
.reset-text {
  font-size: 12px;
  color: #8997bd;
  margin-left: 5px;
}
.drawer-tabs {
  flex-direction: row;
  align-self: flex-start;
  background-color: #e9eff880;
  border-radius: 20px;
  padding: 3px;
  margin: 10px 0 13px;
}
.drawer-tab {
  font-size: 12px;
  color: #8c95a5;
  line-height: 32px;
  padding: 0 15px;
  border-radius: 17px;
}
.drawer-tab-selected {
  color: #ffffff;
  /* #ifdef WEB */
  background-image: linear-gradient(125deg, #54c2f7, #6584ff);
  /* #endif */
  /* #ifndef WEB */
  background-image: linear-gradient(to bottom right, #54c2f7, #6584ff);
  /* #endif */
}
.reminder-group {
  padding: 10px 6px 4px;
  border-radius: 19px;
  background-color: #eaf2fc75;
  margin-bottom: 12px;
}
.group-heading {
  flex-direction: row;
  align-items: center;
  margin: 0 6px 8px;
}
.group-title {
  font-size: 15px;
  font-weight: 700;
  color: #172b4c;
}
.group-count {
  font-size: 15px;
  font-weight: 700;
  color: #4799e5;
  margin-left: 10px;
}
.count-sent {
  color: #37b293;
}
.count-tomorrow {
  color: #8655e9;
}
.count-later {
  color: #e79a29;
}
.drawer-card {
  flex-direction: row;
  align-items: center;
  background-color: #ffffffed;
  border-radius: 17px;
  padding: 10px 8px;
  margin-bottom: 6px;
  min-height: 64px;
  flex-shrink: 0;
}
.drawer-symbol {
  width: 30px;
  height: 30px;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 15px;
  background-color: #eaf3ff;
  margin-right: 7px;
}
.symbol-sent {
  background-color: #e7faf0;
}
.symbol-tomorrow {
  background-color: #f0eaff;
}
.symbol-later {
  background-color: #fff5e7;
}
.drawer-event-title {
  /* #ifdef APP */
  lines: 2;
  /* #endif */
  text-overflow: ellipsis;
  font-size: 14px;
  font-weight: 600;
  line-height: 21px;
  color: #172746;
}
.drawer-event-meta {
  font-size: 12px;
  color: #929baa;
  line-height: 18px;
  margin-top: 3px;
}
.drawer-status {
  flex-shrink: 0;
  font-size: 11px;
  font-weight: 600;
  color: #4799da;
  background-color: #ecf3ff;
  padding: 4px 7px;
  border-radius: 18px;
  margin: 0 7px;
}
.status-sent {
  color: #45ab92;
  background-color: #e7faf0;
}
.status-tomorrow {
  color: #8655e9;
