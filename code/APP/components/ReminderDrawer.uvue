<template>
  <view
    v-if="rendered"
    class="drawer-mask"
    :style="{ opacity: visible ? 1 : 0 }"
    @click="emit('close')"
  >
    <view
      class="drawer"
      :style="{ transform: visible ? 'translateX(' + dragX + 'px)' : 'translateX(-100%)', transitionDuration: dragging ? '0ms' : '240ms' }"
      @touchstart="swipeStart" @touchmove="swipeMove" @touchend="swipeEnd" @touchcancel="swipeCancel"
      @click.stop="noop"
    >
      <view class="drawer-sheen" />
      <view class="drawer-safe-top" :style="{ height: top + 'px' }" />
      <view class="drawer-heading">
        <view class="grow">
          <text class="app-font drawer-title">{{ t('提醒列表') }}</text>
          <text class="app-font drawer-subtitle">{{ t('查看与管理全部提醒') }}</text>
        </view>
        <view class="drawer-close" @click="emit('close')"><UiIcon name="close" tone="purple" :size="24" /></view>
      </view>
      <view class="drawer-filter">
        <view class="date-filter" @click="dateOpen = true">
          <view class="date-icon"><UiIcon name="calendar" tone="purple" :size="20" /></view>
          <text class="app-font date-label">
            {{ start.length > 0 ? start + t(' 至 ') + end : t('选择日期范围') }}
          </text>
          <UiIcon name="down" :size="16" />
        </view>
        <view
          class="reset"
          @click="
            start = '';
            end = '';
            type = 0;
            load();
          "
        >
          <UiIcon name="reset" tone="purple" :size="21" />
          <text class="app-font reset-text">{{ t('还原') }}</text>
        </view>
      </view>
      <view class="drawer-tabs">
        <text
          class="app-font"
          v-for="(label, index) in labels"
          :key="label"
          :class="['drawer-tab', type == index ? 'drawer-tab-selected' : '']"
          @click="
            type = index;
            load();
          "
        >
          {{ t(label) }}
        </text>
      </view>
      <scroll-view :scroll-y="true" class="scroll">
        <text v-if="loading" class="app-font muted">{{ t('正在读取…') }}</text>
        <view v-if="error.length > 0">
          <text class="app-font error">{{ error }}</text>
          <button class="app-font secondary" @click="load()">{{ t('重试') }}</button>
        </view>
        <view v-for="group in groups" :key="group.key" :class="['reminder-group', 'group-' + group.key]">
          <view class="group-heading">
            <view class="group-heading-main">
              <view :class="['group-icon', 'group-icon-' + group.key]">
                <UiIcon :name="group.key == 'sent' ? 'check' : group.key == 'later' ? 'note' : 'clock'" tone="white" :size="16" />
              </view>
              <text class="app-font group-title">{{ t(group.title) }}</text>
              <text class="app-font" :class="['group-count', 'count-' + group.key]">{{ group.items.length }}</text>
            </view>
            <text class="app-font group-description">{{ t(groupDescription(group.key)) }}</text>
          </view>
          <view
            v-for="item in group.items"
            :key="s(item, 'eventId')"
            class="drawer-card"
            @click="
              openEvent(s(item, 'eventId'));
            "
          >
            <view :class="['drawer-symbol', 'symbol-' + group.key]">
              <UiIcon
                :name="group.key == 'sent' ? 'check' : 'clock'"
                :tone="
                  group.key == 'sent'
                    ? 'green'
                    : group.key == 'tomorrow'
                      ? 'violet'
                      : group.key == 'later'
                        ? 'amber'
                        : 'blue'
                "
                :size="25"
              />
            </view>
            <view class="drawer-event-main">
              <text class="app-font drawer-event-title">
                {{ firstText(item, ['summary', 'taskContent', 'eventSummary']) }}
              </text>
              <text class="app-font drawer-event-meta">
                {{ t('发给') }}{{ s(item, 'people') }} ·
                {{ displayTime(s(item, 'displayTime')).slice(5)
                }}{{ b(item, 'differentTimes') ? t(' · 多个时间') : '' }}
              </text>
            </view>
            <text class="app-font" :class="['drawer-status', 'status-' + group.key]">
              {{ group.key == 'sent' ? t('已提醒') : t('待提醒') }}
            </text>
            <UiIcon name="chevron" :size="16" />
          </view>
        </view>
      </scroll-view>
      <text class="app-font drawer-footer">
        {{ t('按北京时间分组 · 待提醒按计划评估时间展示') }}
      </text>
    </view>
  </view>
  <DateRange
    :open="dateOpen"
    :start="start"
    :end="end"
    @close="dateOpen = false"
    @apply="applyRange"
  />
</template>
<script setup lang="uts">
import { HorizontalSwipe } from '@/core/swipe.uts';
import UiIcon from '@/components/UiIcon.uvue';
import { t as _t } from '@/core/locale.uts';
import { ref, computed, watch, onUnmounted } from 'vue';
import { reminder } from '@/api/request.uts';
import { firstText as _firstText, s as _s, b as _b, message } from '@/core/json.uts';
import { ReminderGroup, reminderGroups } from '@/core/reminders.uts';
import { displayTime as _displayTime } from '@/core/time.uts';
import { openEvent as _openEvent } from '@/core/ui.uts';
import DateRange from './DateRange.uvue';
function firstText(row: UTSJSONObject, keys: string[]): string {
  return _firstText(row, keys);
}
function t(value: string): string {
  return _t(value);
}
function s(row: UTSJSONObject, key: string, fallback: string = ''): string {
  return _s(row, key, fallback);
}
function b(row: UTSJSONObject, key: string): boolean {
  return _b(row, key);
}
function displayTime(value: string): string {
  return _displayTime(value);
}
function groupDescription(key: string): string {
  if (key == 'sent') return '今日已发送的提醒';
  if (key == 'tomorrow') return '明天需关注的提醒';
  if (key == 'later') return '过往创建且未到期的提醒';
  return '今日需关注的提醒';
}
const props = defineProps({ open: { type: Boolean, default: false } });
const emit = defineEmits(['close']);
const top = uni.getWindowInfo().safeAreaInsets.top,
  labels = ['全部', '我发起的', '我收到的'],
  type = ref(0),
  rows = ref<UTSJSONObject[]>([]),
  loading = ref(false),
  error = ref(''),
  dateOpen = ref(false),
  start = ref(''),
  end = ref('');
let ticket = 0;
const groups = computed<ReminderGroup[]>(() =>
  reminderGroups(rows.value, Date.now(), start.value, end.value),
);
async function load() {
  const current = ++ticket;
  loading.value = true;
  error.value = '';
  try {
    const result: UTSJSONObject[] = [];
    for (const side of type.value == 0
      ? ['sent', 'received']
      : [type.value == 1 ? 'sent' : 'received']) {
      const data = await reminder('events/drawer', null, { type: side });
      result.push(...((data['value'] as UTSJSONObject[]) ?? []));
    }
    if (current == ticket) {
      const ids = new Set<string>();
      rows.value = result.filter((row: UTSJSONObject): boolean => {
        const id = s(row, 'eventId') + ':' + s(row, 'branchId');
        if (ids.has(id)) return false;
        ids.add(id);
        return true;
      });
    }
  } catch (e) {
    if (current == ticket) error.value = message(e);
  } finally {
    if (current == ticket) loading.value = false;
  }
}
function applyRange(a: string, b: string) {
  start.value = a;
  end.value = b;
}
function noop() {}
const swipe = new HorizontalSwipe();
const dragX = ref(0), dragging = ref(false);
let ignoreClickUntil = 0;
function openEvent(id: string): void {
  if (Date.now() < ignoreClickUntil) return;
  emit('close');
  return _openEvent(id);
}
function swipeCancel(): void { swipe.cancel(); dragging.value = false; dragX.value = 0; }
function swipeStart(e: UniTouchEvent): void {
  swipe.cancel();
  if (dateOpen.value || e.touches.length != 1) return;
  swipe.start(e.touches[0].clientX, e.touches[0].clientY);
}
function swipeMove(e: UniTouchEvent): void {
  if (e.touches.length != 1) { swipeCancel(); return; }
  const dx = swipe.move(e.touches[0].clientX, e.touches[0].clientY);
  if (dx != 0 || dragging.value) { dragging.value = true; dragX.value = Math.min(0, dx); ignoreClickUntil = Date.now() + 400; }
}
function swipeEnd(e: UniTouchEvent): void {
  dragging.value = false;
  if (e.changedTouches.length > 0 && swipe.end(e.changedTouches[0].clientX, e.changedTouches[0].clientY) < 0) emit('close');
  dragX.value = 0;
}
const rendered = ref(false),
  visible = ref(false);
let animationTimer: number = 0;
onUnmounted(() => clearTimeout(animationTimer));

watch(
  (): boolean => props.open,
  (value: boolean) => {
    clearTimeout(animationTimer);
    swipeCancel();
    if (value) {
      rendered.value = true;
      animationTimer = setTimeout(() => {
        visible.value = true;
      }, 30);
      void load();
    } else {
      ticket++;
      dateOpen.value = false;
      visible.value = false;
      animationTimer = setTimeout(() => {
        rendered.value = false;
      }, 260);
    }
  },
  { immediate: true },
);
</script>
<style scoped>
.drawer-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 80;
  background-color: rgba(24, 30, 42, 0.56);
  transition-property: opacity; transition-duration: 240ms; transition-timing-function: ease-out;
}
.drawer {
  width: 100%; max-width: 560px; height: 100%; padding: 16px 14px 20px;
  background-color: #f6faff;
  /* #ifdef WEB */
  background-image: linear-gradient(125deg, #f9fcff, #eaf3ff, #f8fbff);
  /* #endif */
  /* #ifndef WEB */
  background-image: linear-gradient(to bottom right, #f9fcff, #edf5ff);
  /* #endif */
  border-top-right-radius: 26px; border-bottom-right-radius: 26px;
  transition-property: transform; transition-duration: 240ms; transition-timing-function: ease-out;
}
.drawer-sheen {
  position: absolute; top: -36px; right: -100px; width: 290px; height: 230px;
  border-bottom-left-radius: 190px; background-color: #d4e7ff59;
}
.drawer-safe-top { flex-shrink: 0; }
.drawer-heading { flex-direction: row; align-items: flex-start; padding: 0 6px; flex-shrink: 0; }
.drawer-title { font-size: 26px; line-height: 34px; font-weight: 700; color: #08162f; }
.drawer-subtitle { font-size: 14px; line-height: 21px; color: #7c88a6; margin-top: 3px; }
.drawer-close {
  width: 38px; height: 38px; margin-top: 2px; border: 1px solid #ffffff;
  border-radius: 19px; background-color: #ffffff70; align-items: center; justify-content: center;
}
.drawer-filter { flex-direction: row; margin: 10px 5px 0; flex-shrink: 0; }
.date-filter {
  flex: 1; min-width: 0; flex-direction: row; align-items: center; min-height: 42px;
  padding: 0 12px 0 10px; background-color: #ffffffd9; border: 1px solid #dbe7fa; border-radius: 13px;
}
.date-icon {
  width: 28px; height: 28px; border-radius: 9px; background-color: #eef3ff;
  align-items: center; justify-content: center; margin-right: 10px; flex-shrink: 0;
}
.date-label { flex: 1; min-width: 0; font-size: 13px; color: #7986a3; line-height: 19px; }
.reset {
  width: 88px; flex-direction: row; align-items: center; justify-content: center;
  border: 1px solid #dfe6f7; border-radius: 13px; background-color: #ffffffb3; margin-left: 9px;
}
.reset-text { font-size: 14px; color: #53659f; margin-left: 8px; }
.drawer-tabs { flex-direction: row; align-self: flex-start; margin: 12px 4px 13px; flex-shrink: 0; }
.drawer-tab {
  min-width: 80px; font-size: 14px; text-align: center; color: #5f6e97; line-height: 32px;
  padding: 0 16px; border-radius: 13px; background-color: #eaf0ffb3; margin-right: 6px;
}
.drawer-tab-selected {
  color: #ffffff;
  /* #ifdef WEB */
  background-image: linear-gradient(125deg, #519eff, #2475ff);
  /* #endif */
  /* #ifndef WEB */
  background-image: linear-gradient(to bottom right, #519eff, #2475ff);
  /* #endif */
}
.reminder-group {
  padding: 10px 6px 2px; border-radius: 15px; background-color: #dcebff8c;
  border: 1px solid #ffffffcc; margin-bottom: 8px;
}
.group-heading { flex-direction: row; align-items: center; justify-content: space-between; margin: 0 6px 9px; min-height: 22px; }
.group-heading-main { flex-direction: row; align-items: center; flex-shrink: 0; }
.group-icon { width: 22px; height: 22px; border-radius: 11px; align-items: center; justify-content: center; background-color: #307bff; margin-right: 9px; }
.group-icon-sent { background-color: #26ac73; }
.group-icon-tomorrow { background-color: #8246f4; }
.group-icon-later { background-color: #e5a03e; }
.group-title { font-size: 14px; line-height: 22px; font-weight: 700; color: #0b1833; }
.group-count { font-size: 14px; line-height: 22px; font-weight: 700; color: #2778ff; margin-left: 8px; }
.count-sent { color: #129962; }
.count-tomorrow { color: #8449f1; }
.count-later { color: #f59327; }
.group-description { flex: 1; min-width: 0; text-align: right; font-size: 10px; line-height: 15px; color: #8190ac; margin-left: 6px; }
.drawer-card {
  flex-direction: row; align-items: center; background-color: #ffffffde; border: 1px solid #ffffffe6;
  border-radius: 13px; padding: 10px 9px; margin-bottom: 6px; min-height: 59px; flex-shrink: 0;
}
.drawer-symbol {
  width: 36px; height: 36px; align-items: center; justify-content: center; flex-shrink: 0;
  border-radius: 18px; background-color: #e7f0ff; margin-right: 12px;
}
.symbol-sent { background-color: #e0f8ee; }
.symbol-tomorrow { background-color: #efe7ff; }
.symbol-later { background-color: #fff1de; }
.drawer-event-main { flex: 1; min-width: 0; }
.drawer-event-title {
  /* #ifdef APP */
  lines: 2;
  /* #endif */
  text-overflow: ellipsis; font-size: 13px; font-weight: 600; line-height: 19px; color: #0d1933;
}
.drawer-event-meta { font-size: 11px; color: #7e8baa; line-height: 16px; margin-top: 3px; }
.drawer-status {
  flex-shrink: 0; font-size: 11px; font-weight: 600; color: #2475ff; background-color: #e7f1ff;
  padding: 5px 10px; border-radius: 16px; margin: 0 9px;
}
.status-sent { color: #079a5c; background-color: #e2f8ef; }
.status-tomorrow { color: #8041f3; background-color: #eee5ff; }
.status-later { color: #d58c25; background-color: #fff1de; }
.drawer-footer {
  font-size: 10px; line-height: 18px; color: #8190ae; text-align: center;
  border-top: 1px solid #dfe7f7; margin: 8px 9px 0; padding-top: 10px; padding-bottom: 0; flex-shrink: 0;
}
.drawer .scroll { flex: 1; min-height: 0; }
.date-label, .reset-text, .drawer-tab { font-weight: 600; }
.drawer-event-meta { font-weight: 500; }
.group-sent { background-color: #d9f3eb8c; }
.group-tomorrow { background-color: #ebe2ff8c; }
.group-later { background-color: #fff0da8c; }
/* #ifdef WEB */
.drawer-event-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
/* #endif */
/* #ifdef APP-IOS */
.drawer-title, .group-title, .group-count, .date-label, .reset-text, .drawer-tab, .drawer-event-title, .drawer-status { font-family: 'PingFangSC-Semibold'; }
.drawer-event-meta { font-family: 'PingFangSC-Medium'; }
/* #endif */
</style>
