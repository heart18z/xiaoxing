}
.status-later {
  color: #e79a29;
  background-color: #fff5e7;
}
.drawer-footer {
  font-size: 10px;
  line-height: 18px;
  color: #a0a6b5;
  text-align: center;
  border-top: 1px solid #dfe6f3;
  margin: 10px 7px 0;
  padding-top: 18px;
  padding-bottom: 25px;
}
/* #ifdef WEB */
.drawer-event-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
/* #endif */
.drawer-event-main {
  flex: 1;
  min-width: 0;
}
.drawer .scroll {
  flex: 1;
  min-height: 0;
}
.date-label, .reset-text, .drawer-tab, .drawer-event-title, .drawer-status { font-weight: 600; }
.drawer-event-meta { font-weight: 500; }
/* #ifdef APP-IOS */
.date-label, .reset-text, .drawer-tab, .drawer-event-title, .drawer-status { font-family: 'PingFangSC-Semibold'; }
.drawer-event-meta { font-family: 'PingFangSC-Medium'; }
/* #endif */
</style>
