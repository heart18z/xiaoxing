<template>
  <view
    v-if="rendered"
    class="drawer-mask"
    :style="{ opacity: visible ? 1 : 0 }"
    @click="emit('close')"
  >
    <view
      class="drawer"
      :style="{ transform: visible ? 'translateX(0px)' : 'translateX(-100%)' }"
      @click.stop="noop"
    >
      <view :style="{ height: top + 'px' }" />
      <view class="drawer-heading">
        <view class="grow">
          <text class="app-font drawer-title">{{ t('提醒列表') }}</text>
          <text class="app-font drawer-subtitle">{{ t('查看与管理全部提醒') }}</text>
        </view>
        <view class="drawer-close" @click="emit('close')"><UiIcon name="close" :size="24" /></view>
      </view>
      <view class="drawer-filter">
        <view class="date-filter" @click="dateOpen = true">
          <view class="date-icon"><UiIcon name="calendar" tone="purple" :size="17" /></view>
          <text class="app-font date-label">
            {{ start.length > 0 ? start + t(' 至 ') + end : t('选择日期范围') }}
          </text>
          <UiIcon name="down" :size="12" />
        </view>
        <view
          class="reset"
          @click="
            start = '';
            end = '';
            type = 0;
            load();
          "
        >
          <UiIcon name="reset" tone="purple" :size="17" />
          <text class="app-font reset-text">{{ t('还原') }}</text>
        </view>
      </view>
      <view class="drawer-tabs">
        <text
          class="app-font"
          v-for="(label, index) in labels"
          :key="label"
          :class="['drawer-tab', type == index ? 'drawer-tab-selected' : '']"
          @click="
            type = index;
            load();
          "
        >
          {{ t(label) }}
        </text>
      </view>
      <scroll-view :scroll-y="true" class="scroll">
        <text v-if="loading" class="app-font muted">{{ t('正在读取…') }}</text>
        <view v-if="error.length > 0">
          <text class="app-font error">{{ error }}</text>
          <button class="app-font secondary" @click="load()">{{ t('重试') }}</button>
        </view>
        <view v-for="group in groups" :key="group.key" class="reminder-group">
          <view class="group-heading">
            <text class="app-font group-title">{{ t(group.title) }}</text>
            <text class="app-font" :class="['group-count', 'count-' + group.key]">
              {{ group.items.length }}
            </text>
          </view>
          <text v-if="group.items.length == 0" class="app-font muted">{{ t('暂无提醒') }}</text>
          <view
            v-for="item in group.items"
            :key="s(item, 'eventId')"
            class="drawer-card"
            @click="
              emit('close');
              openEvent(s(item, 'eventId'));
            "
          >
            <view :class="['drawer-symbol', 'symbol-' + group.key]">
              <UiIcon
                :name="group.key == 'sent' ? 'check' : 'clock'"
                :tone="
                  group.key == 'sent'
                    ? 'green'
                    : group.key == 'tomorrow'
                      ? 'violet'
                      : group.key == 'later'
                        ? 'amber'
                        : 'blue'
                "
                :size="21"
              />
            </view>
            <view class="drawer-event-main">
              <text class="app-font drawer-event-title">
                {{ firstText(item, ['summary', 'taskContent', 'eventSummary']) }}
              </text>
              <text class="app-font drawer-event-meta">
                {{ t('发给') }}{{ s(item, 'people') }} ·
                {{ displayTime(s(item, 'displayTime')).slice(5)
                }}{{ b(item, 'differentTimes') ? t(' · 多个时间') : '' }}
              </text>
            </view>
            <text class="app-font" :class="['drawer-status', 'status-' + group.key]">
              {{ group.key == 'sent' ? t('已提醒') : t('待提醒') }}
            </text>
            <UiIcon name="chevron" :size="18" />
          </view>
        </view>
      </scroll-view>
      <text class="app-font drawer-footer">
        {{ t('按北京时间分组 · 待提醒按计划评估时间展示') }}
      </text>
    </view>
  </view>
  <DateRange
    :open="dateOpen"
    :start="start"
    :end="end"
    @close="dateOpen = false"
    @apply="applyRange"
  />
</template>
<script setup lang="uts">
import UiIcon from '@/components/UiIcon.uvue';
import { t as _t } from '@/core/locale.uts';
import { ref, computed, watch, onUnmounted } from 'vue';
import { reminder } from '@/api/request.uts';
import { firstText as _firstText, s as _s, b as _b, message } from '@/core/json.uts';
import { ReminderGroup, reminderGroups } from '@/core/reminders.uts';
import { displayTime as _displayTime } from '@/core/time.uts';
import { openEvent as _openEvent } from '@/core/ui.uts';
import DateRange from './DateRange.uvue';
function firstText(row: UTSJSONObject, keys: string[]): string {
  return _firstText(row, keys);
}
function t(value: string): string {
  return _t(value);
}
function s(row: UTSJSONObject, key: string, fallback: string = ''): string {
  return _s(row, key, fallback);
}
function b(row: UTSJSONObject, key: string): boolean {
  return _b(row, key);
}
function displayTime(value: string): string {
  return _displayTime(value);
}
function openEvent(id: string): void {
  return _openEvent(id);
}
const props = defineProps({ open: { type: Boolean, default: false } });
const emit = defineEmits(['close']);
const top = uni.getWindowInfo().safeAreaInsets.top,
  labels = ['全部', '我发起的', '我收到的'],
  type = ref(0),
  rows = ref<UTSJSONObject[]>([]),
  loading = ref(false),
  error = ref(''),
  dateOpen = ref(false),
  start = ref(''),
  end = ref('');
let ticket = 0;
const groups = computed<ReminderGroup[]>(() =>
  reminderGroups(rows.value, Date.now(), start.value, end.value),
);
async function load() {
  const current = ++ticket;
  loading.value = true;
  error.value = '';
  try {
    const result: UTSJSONObject[] = [];
    for (const side of type.value == 0
      ? ['sent', 'received']
      : [type.value == 1 ? 'sent' : 'received']) {
      const data = await reminder('events/drawer', null, { type: side });
      result.push(...((data['value'] as UTSJSONObject[]) ?? []));
    }
    if (current == ticket) {
      const ids = new Set<string>();
      rows.value = result.filter((row: UTSJSONObject): boolean => {
        const id = s(row, 'eventId') + ':' + s(row, 'branchId');
        if (ids.has(id)) return false;
        ids.add(id);
        return true;
      });
    }
  } catch (e) {
    if (current == ticket) error.value = message(e);
  } finally {
    if (current == ticket) loading.value = false;
  }
}
function applyRange(a: string, b: string) {
  start.value = a;
  end.value = b;
}
function noop() {}
const rendered = ref(false),
  visible = ref(false);
let animationTimer: number = 0;
onUnmounted(() => clearTimeout(animationTimer));

watch(
  (): boolean => props.open,
  (value: boolean) => {
    clearTimeout(animationTimer);
    if (value) {
      rendered.value = true;
      animationTimer = setTimeout(() => {
        visible.value = true;
      }, 30);
      void load();
    } else {
      ticket++;
      dateOpen.value = false;
      visible.value = false;
      animationTimer = setTimeout(() => {
        rendered.value = false;
      }, 260);
    }
  },
  { immediate: true },
);
</script>
<style scoped>
