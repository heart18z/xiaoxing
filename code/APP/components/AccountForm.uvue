<template>
  <Popup
    variant="account"
    :open="open"
    :title="register ? t('创建小醒账号') : t('重置密码')"
    :busy="busy"
    @close="emit('close')"
  >
    <view v-if="register">
      <view class="form-columns">
        <view class="grow">
          <text class="form-label">{{ t('登录账号 *') }}</text>
          <input class="input" v-model="account" maxlength="32" />
        </view>
        <view class="grow second-column">
          <text class="form-label">{{ t('姓名 *') }}</text>
          <input class="input" v-model="name" maxlength="20" />
        </view>
      </view>
      <text class="form-help">
        {{
          suggesting
            ? t('正在生成推荐账号…')
            : t('账号已自动生成，可修改。支持4–32位字母、数字、下划线或短横线。')
        }}
      </text>
    </view>
    <view v-else>
      <text class="label">{{ t('原密码') }}</text>
      <input
        class="input"
        v-model="oldPassword"
        :password="!show"
        :placeholder="t('请输入原密码')"
      />
    </view>
    <text class="form-label">{{ register ? t('密码 *') : t('新密码') }}</text>
    <view class="password-input">
      <input
        class="password-field"
        v-model="password"
        :password="!show"
        maxlength="64"
        :placeholder="t('8–64 位密码')"
      />
      <view @click="show = !show"><UiIcon :name="show ? 'eye' : 'eyeOff'" :size="20" /></view>
    </view>
    <view v-if="register">
      <text class="form-help">{{ t('已预填默认密码，建议修改（8–64位）。') }}</text>
      <view class="contact">
        <text class="label">{{ t('联系方式') }}</text>
        <text class="form-help">{{ t('手机号 / 邮箱至少填写一项') }}</text>
        <view class="form-columns">
          <view class="grow">
            <text class="form-label">{{ t('手机号') }}</text>
            <input
              class="input"
              v-model="phone"
              type="number"
              maxlength="11"
              :placeholder="t('11位手机号')"
            />
          </view>
          <view class="grow second-column">
            <text class="form-label">{{ t('邮箱') }}</text>
            <input class="input" v-model="email" maxlength="45" :placeholder="t('常用邮箱')" />
          </view>
        </view>
        <text class="form-help">{{ t('填写的手机号、邮箱不能与其他账号重复。') }}</text>
      </view>
    </view>
    <view v-else>
      <text class="label">{{ t('确认新密码') }}</text>
      <input
        class="input"
        v-model="confirmation"
        :password="!show"
        :placeholder="t('再次输入新密码')"
      />
    </view>
    <text class="error" v-if="error.length > 0">{{ error }}</text>
    <button class="primary" :loading="busy" :disabled="busy" @click="submit()">
      {{ register ? t('注册') : t('修改密码') }}
    </button>
  </Popup>
</template>
<script setup lang="uts">
import UiIcon from '@/components/UiIcon.uvue';
import { t as _t } from '@/core/locale.uts';
import { ref, watch } from 'vue';
import Popup from './Popup.uvue';
import { post } from '@/api/request.uts';
import { s, message } from '@/core/json.uts';
function t(value: string): string {
  return _t(value);
}
const props = defineProps({
  open: { type: Boolean, default: false },
  register: { type: Boolean, default: false },
});
const emit = defineEmits(['close', 'success']);
const account = ref(''),
  name = ref(''),
  password = ref(''),
  oldPassword = ref(''),
  confirmation = ref(''),
  phone = ref(''),
  email = ref(''),
  error = ref(''),
  busy = ref(false),
  show = ref(false),
  suggesting = ref(false);
let ticket = 0;
async function opened(value: boolean): Promise<void> {
  const current = ++ticket;
  if (!value) return;
  account.value = '';
  name.value = '';
  password.value = props.register ? 'admin@123' : '';
  oldPassword.value = '';
  confirmation.value = '';
  phone.value = '';
  email.value = '';
  error.value = '';
  show.value = false;
  if (!props.register) return;
  suggesting.value = true;
  try {
    const data = await post('/app/account/suggest-account', null, {}, 15000, false);
    if (ticket == current && account.value.length == 0) account.value = s(data, 'data');
  } catch (_) {
    if (ticket == current) error.value = '推荐账号暂未生成，可手动填写';
  } finally {
    if (ticket == current) suggesting.value = false;
  }
}
async function submit() {
  if (busy.value) return;
  error.value = '';
  if (
    password.value.trim().length == 0 ||
    password.value.length < 8 ||
    password.value.length > 64
  ) {
    error.value = '密码须为8–64个字符';
    return;
  }
  if (props.register) {
    if (!/^[A-Za-z0-9][A-Za-z0-9_-]{3,31}$/.test(account.value) || name.value.trim().length == 0) {
      error.value = '账号须为4–32位字母、数字、下划线或短横线，首位为字母或数字，并填写姓名';
      return;
    }
    if (phone.value.length == 0 && email.value.length == 0) {
      error.value = '手机号和邮箱至少填写一项';
      return;
    }
    if (phone.value.length > 0 && !/^1[3-9]\d{9}$/.test(phone.value)) {
      error.value = '请输入正确的手机号';
      return;
    }
    if (email.value.length > 0 && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
      error.value = '请输入正确的邮箱';
      return;
    }
  } else if (oldPassword.value.length == 0 || password.value != confirmation.value) {
    error.value = '请填写原密码，并确认两次新密码一致';
    return;
  }
  busy.value = true;
  try {
    await post(
      '/app/account/' + (props.register ? 'register' : 'password'),
      props.register
        ? {
            account: account.value,
            name: name.value.trim(),
            password: password.value,
            phone: phone.value,
            email: email.value,
          }
        : {
            oldPassword: oldPassword.value,
            password: password.value,
            confirmation: confirmation.value,
          },
      {},
      15000,
      !props.register,
    );
    emit('success', account.value);
    emit('close');
    password.value = props.register ? 'admin@123' : '';
    oldPassword.value = '';
    confirmation.value = '';
  } catch (e) {
    error.value = message(e);
  } finally {
    busy.value = false;
  }
}

watch(
  (): boolean => props.open,
  (value: boolean) => {
    void opened(value);
  },
);
</script>

<style scoped>
.form-columns {
  flex-direction: row;
}
.form-label {
  font-size: 14px;
  color: #374151;
  margin-bottom: 8px;
}
.form-help {
  font-size: 12px;
  line-height: 19px;
  color: #9096a2;
  margin-bottom: 10px;
}
.input {
  background-color: #f9faff;
  margin-bottom: 0;
}
.password-input {
  height: 45px;
  flex-direction: row;
  align-items: center;
  padding: 0 13px;
  background-color: #f9faff;
  border: 1px solid #dedfe7;
  border-radius: 13px;
  margin-bottom: 10px;
}
.password-field {
  flex: 1;
  min-width: 0;
  font-size: 16px;
}
.contact {
  border-top: 1px solid #edf0f6;
  padding-top: 14px;
  margin-top: 3px;
}
.primary {
  margin-top: 4px;
}
.label {
  margin-bottom: 4px;
}
.second-column {
  margin-left: 10px;
}
</style>
