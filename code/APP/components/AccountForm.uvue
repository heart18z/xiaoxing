<template>
  <Popup
    variant="account"
    :fixed-footer="true"
    :panel-height="register ? 640 : 410"
    :open="open"
    :title="register ? t('创建小醒账号') : t('重置密码')"
    :busy="busy"
    @close="emit('close')"
  >
    <view v-if="register">
      <view class="form-columns">
        <view class="grow">
          <text class="app-font form-label">{{ t('登录账号 *') }}</text>
          <input class="app-font input" v-model="account" maxlength="32" />
        </view>
        <view class="grow second-column">
          <text class="app-font form-label">{{ t('姓名 *') }}</text>
          <input class="app-font input" v-model="name" maxlength="20" />
        </view>
      </view>
      <text class="app-font form-help">
        {{
          suggesting
            ? t('正在生成推荐账号…')
            : t('账号已自动生成，可修改。支持4–32位字母、数字、下划线或短横线。')
        }}
      </text>
    </view>
    <view v-else>
      <text class="app-font label">{{ t('原密码') }}</text>
      <input
        class="app-font input"
        v-model="oldPassword"
        :password="!show"
        :placeholder="t('请输入原密码')"
      />
    </view>
    <text class="app-font form-label">{{ register ? t('密码 *') : t('新密码') }}</text>
    <view class="password-input">
      <input
        class="app-font password-field"
        v-model="password"
        :password="!show"
        maxlength="64"
        :placeholder="t('8–64 位密码')"
      />
      <view @click="show = !show"><UiIcon :name="show ? 'eye' : 'eyeOff'" :size="20" /></view>
    </view>
    <view v-if="register">
      <text class="app-font form-help">
        {{ t('已预填默认密码，建议修改（8–64位）。') }}
      </text>
      <view class="contact">
        <text class="app-font label">{{ t('联系方式') }}</text>
        <text class="app-font form-help">{{ t('邮箱必填，手机号选填') }}</text>
        <view class="contact-fields">
          <view class="contact-field">
            <text class="app-font form-label">{{ t('手机号') }}</text>
            <input
              class="app-font input"
              v-model="phone"
              :disabled="busy || sending"
              type="number"
              maxlength="11"
              :placeholder="t('11位手机号')"
              @blur="checkContact('phone')"
            />
            <text v-if="phoneHint.length > 0" class="app-font contact-hint">{{ phoneHint }}</text>
          </view>
          <view class="contact-field">
            <text class="app-font form-label">{{ t('邮箱 *') }}</text>
            <input
              class="app-font input"
              v-model="email"
              :disabled="busy || sending"
              maxlength="45"
              :placeholder="t('常用邮箱')"
              @blur="checkContact('email')"
            />
            <text v-if="emailHint.length > 0" class="app-font contact-hint">{{ emailHint }}</text>
          </view>
          <view class="contact-field">
            <text class="app-font form-label">{{ t('邮箱验证码 *') }}</text>
            <view class="code-row">
              <input class="app-font input code-input" v-model="emailCode" type="number" maxlength="6" :disabled="busy" :placeholder="t('6位验证码')" />
              <view class="code-send" :class="{ 'code-disabled': sending || cooldown > 0 || busy }" @click="sendCode()">
                <text class="app-font code-label">{{ sending ? t('发送中…') : cooldown > 0 ? cooldown + 's' : t('获取验证码') }}</text>
              </view>
            </view>
            <text class="app-font form-help">{{ t('验证码10分钟内有效，验证通过后才能注册') }}</text>
          </view>
        </view>
        <text class="app-font form-help">
          {{ t('填写的手机号、邮箱不能与其他账号重复。') }}
        </text>
      </view>
    </view>
    <view v-else>
      <text class="app-font label">{{ t('确认新密码') }}</text>
      <input
        class="app-font input"
        v-model="confirmation"
        :password="!show"
        :placeholder="t('再次输入新密码')"
      />
    </view>
    <text class="app-font error" v-if="error.length > 0">{{ error }}</text>
    <template #footer>
      <LoginButton :busy="busy" :label="register ? t('注册') : t('修改密码')"
        :busy-label="register ? t('正在注册…') : t('正在修改…')" @click="submit()" />
    </template>
  </Popup>
</template>
<script setup lang="uts">
import UiIcon from '@/components/UiIcon.uvue';
import { t as _t } from '@/core/locale.uts';
import { ref, watch, onUnmounted } from 'vue';
import Popup from './Popup.uvue';
import LoginButton from './LoginButton.uvue';
import { post } from '@/api/request.uts';
import { s, b, obj, message } from '@/core/json.uts';
function t(value: string): string {
  return _t(value);
}
const props = defineProps({
  open: { type: Boolean, default: false },
  register: { type: Boolean, default: false },
});
const emit = defineEmits(['close', 'success']);
const account = ref(''),
  name = ref(''),
  password = ref(''),
  oldPassword = ref(''),
  confirmation = ref(''),
  phone = ref(''),
  email = ref(''),
  error = ref(''),
  busy = ref(false),
  show = ref(false),
  suggesting = ref(false);
let ticket = 0;
const emailCode = ref(''), emailHint = ref(''), phoneHint = ref(''), sending = ref(false), cooldown = ref(0);
let emailTimer: number = 0, phoneTimer: number = 0, codeTimer: number = 0, emailCheck = 0, phoneCheck = 0;
function stopContactChecks(): void {
  clearTimeout(emailTimer); clearTimeout(phoneTimer); clearInterval(codeTimer);
  emailCheck++; phoneCheck++; cooldown.value = 0;
}
async function checkContact(field: string): Promise<boolean> {
  const isEmail = field == 'email';
  if (isEmail) clearTimeout(emailTimer); else clearTimeout(phoneTimer);
  const value = isEmail ? email.value.trim().toLowerCase() : phone.value.trim();
  const serial = isEmail ? ++emailCheck : ++phoneCheck, owner = ticket;
  if (!props.open || !props.register || value.length == 0) return !isEmail;
  const valid = isEmail ? /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value) : /^1[3-9]\d{9}$/.test(value);
  const hint = isEmail ? emailHint : phoneHint;
  if (!valid) { hint.value = isEmail ? '请输入正确的邮箱' : '请输入正确的11位手机号'; return false; }
  hint.value = '正在检查…';
  try {
    const response = await post('/app/account/check-contact', { field: field, value: value }, {}, 10000, false);
    if (owner != ticket || serial != (isEmail ? emailCheck : phoneCheck)) return false;
    const available = b(obj(response, 'data'), 'available');
    hint.value = available ? (isEmail ? '邮箱可以使用' : '手机号可以使用') : (isEmail ? '邮箱已被使用，请更换邮箱' : '手机号已被使用，请更换手机号');
    return available;
  } catch (e) {
    if (owner == ticket && serial == (isEmail ? emailCheck : phoneCheck)) hint.value = message(e);
    return false;
  }
}
async function sendCode(): Promise<void> {
  if (sending.value || busy.value || cooldown.value > 0) return;
  sending.value = true; error.value = '';
  const owner = ticket;
  try {
    if (!await checkContact('email')) return;
    const target = email.value.trim().toLowerCase();
    await post('/app/account/email-code', { email: target }, {}, 45000, false);
    if (owner != ticket) return;
    cooldown.value = 60;
    clearInterval(codeTimer);
    codeTimer = setInterval(() => { cooldown.value--; if (cooldown.value <= 0) clearInterval(codeTimer); }, 1000);
    if (target == email.value.trim().toLowerCase()) emailHint.value = '验证码已发送，请检查邮箱或垃圾邮件';
  } catch (e) { if (owner == ticket) error.value = message(e); }
  finally { if (owner == ticket) sending.value = false; }
}
watch((): string => email.value, () => {
  clearTimeout(emailTimer); emailCheck++; emailCode.value = ''; emailHint.value = '';
  if (props.open && props.register) emailTimer = setTimeout(() => { void checkContact('email'); }, 500);
});
watch((): string => phone.value, () => {
  clearTimeout(phoneTimer); phoneCheck++; phoneHint.value = '';
  if (props.open && props.register) phoneTimer = setTimeout(() => { void checkContact('phone'); }, 500);
});
onUnmounted(() => { ticket++; stopContactChecks(); });
async function opened(value: boolean): Promise<void> {
  const current = ++ticket;
  stopContactChecks(); sending.value = false; emailCode.value = ''; emailHint.value = ''; phoneHint.value = '';
  if (!value) return;
  account.value = '';
  name.value = '';
  password.value = props.register ? 'admin@123' : '';
  oldPassword.value = '';
  confirmation.value = '';
  phone.value = '';
  email.value = '';
  error.value = '';
  show.value = false;
  if (!props.register) return;
  suggesting.value = true;
  try {
    const data = await post('/app/account/suggest-account', null, {}, 15000, false);
    if (ticket == current && account.value.length == 0) account.value = s(data, 'data');
  } catch (_) {
    if (ticket == current) error.value = '推荐账号暂未生成，可手动填写';
  } finally {
    if (ticket == current) suggesting.value = false;
  }
}
async function submit() {
  if (busy.value || sending.value) return;
  error.value = '';
  if (
    password.value.trim().length == 0 ||
    password.value.length < 8 ||
    password.value.length > 64
  ) {
    error.value = '密码须为8–64个字符';
    return;
  }
  if (props.register) {
    if (!/^[A-Za-z0-9][A-Za-z0-9_-]{3,31}$/.test(account.value) || name.value.trim().length == 0) {
      error.value = '账号须为4–32位字母、数字、下划线或短横线，首位为字母或数字，并填写姓名';
      return;
    }
    if (email.value.trim().length == 0) {
      error.value = '请填写邮箱';
      return;
    }
    if (phone.value.length > 0 && !/^1[3-9]\d{9}$/.test(phone.value)) {
      error.value = '请输入正确的手机号';
      return;
    }
    if (email.value.length > 0 && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
      error.value = '请输入正确的邮箱';
      return;
    }
    if (!/^\d{6}$/.test(emailCode.value)) { error.value = '请输入6位邮箱验证码'; return; }
  } else if (oldPassword.value.length == 0 || password.value != confirmation.value) {
    error.value = '请填写原密码，并确认两次新密码一致';
    return;
  }
  busy.value = true;
  try {
    if (props.register) {
      clearTimeout(emailTimer); clearTimeout(phoneTimer);
      if (!await checkContact('email') || !await checkContact('phone')) { error.value = '请检查邮箱和手机号的提示'; return; }
    }
    await post(
      '/app/account/' + (props.register ? 'register' : 'password'),
      props.register
        ? {
            account: account.value,
            name: name.value.trim(),
            password: password.value,
            phone: phone.value,
            email: email.value.trim(),
            emailCode: emailCode.value,
          }
        : {
            oldPassword: oldPassword.value,
            password: password.value,
            confirmation: confirmation.value,
          },
      {},
      15000,
      !props.register,
    );
    emit('success', account.value, props.register ? password.value : '');
    emit('close');
    password.value = props.register ? 'admin@123' : '';
    oldPassword.value = '';
    confirmation.value = '';
  } catch (e) {
    error.value = message(e);
  } finally {
    busy.value = false;
  }
}

watch(
  (): boolean => props.open,
  (value: boolean) => {
    void opened(value);
  },
);
</script>

<style scoped>
.contact-hint { font-size: 12px; line-height: 19px; color: #66708a; margin-top: 4px; }
.code-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.code-input { flex: 1; min-width: 0; }
.code-send { flex-shrink: 0; height: 45px; padding: 0 12px; margin-left: 8px; border-radius: 13px; background-color: #eef0ff; align-items: center; justify-content: center; }
.code-label { font-size: 13px; font-weight: 600; color: #4c5cff; }
.code-disabled { opacity: 0.55; }
.contact-field {
  margin-bottom: 10px;
}
.form-columns {
  flex-direction: row;
}
.form-label {
  font-size: 14px;
  color: #374151;
  margin-bottom: 8px;
}
.form-help {
  font-size: 12px;
  line-height: 19px;
  color: #9096a2;
  margin-bottom: 10px;
}
.input {
  background-color: #f9faff;
  margin-bottom: 0;
}
.password-input {
  height: 45px;
  flex-direction: row;
  align-items: center;
  padding: 0 13px;
  background-color: #f9faff;
  border: 1px solid #dedfe7;
  border-radius: 13px;
  margin-bottom: 10px;
}
.password-field {
  flex: 1;
  min-width: 0;
  font-size: 16px;
}
.contact {
  border-top: 1px solid #edf0f6;
  padding-top: 14px;
  margin-top: 3px;
}
.primary {
  flex-shrink: 0;
  height: 44px;
  min-height: 44px;
  margin-top: 4px;
}
.label {
  margin-bottom: 4px;
}
.second-column {
  margin-left: 10px;
}
</style>
