<template>
  <view
    v-if="rendered"
    :class="[
      'mask',
      sheet ? 'sheet-mask' : '',
      variant == 'conversation' ? 'conversation-mask' : '',
    ]"
    :style="{
      opacity: visible ? 1 : 0,
      paddingTop:
        variant == 'conversation' ? info.windowHeight * 0.08 + 'px' : sheet ? '0px' : '20px',
    }"
    @click="close()"
  >
    <view
      :class="[
        'panel',
        sheet ? 'sheet-panel' : '',
        variant == 'conversation' ? 'conversation-panel' : '',
        variant == 'account' ? 'account-panel' : '',
        variant == 'friend-search' ? 'friend-search-panel' : '',
        variant == 'personal-qr' ? 'personal-qr-panel' : '',
      ]"
      @click.stop="noop"
      :style="{
        maxHeight: maxHeight + 'px',
        height: fixedFooter ? Math.min(maxHeight, panelHeight) + 'px' : 'auto',
        transform: visible ? 'translateY(0px)' : 'translateY(16px)',
      }"
    >
      <view class="popup-head">
        <text class="app-font title">{{ title }}</text>
        <view class="close" role="button" aria-label="关闭弹窗" @click.stop="close()">
          <UiIcon name="close" tone="muted" :size="20" />
        </view>
      </view>
      <view v-if="variant == 'conversation'" class="popup-body"><slot /></view>
      <scroll-view v-else :scroll-y="true" class="popup-scroll">
        <view class="popup-body"><slot /></view>
      </scroll-view>
      <view v-if="fixedFooter" class="popup-footer"><slot name="footer" /></view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { ref, watch, onUnmounted } from 'vue';
import UiIcon from './UiIcon.uvue';
const props = defineProps({
  open: { type: Boolean, default: false },
  title: { type: String, default: '' },
  busy: { type: Boolean, default: false },
  sheet: { type: Boolean, default: false },
  variant: { type: String, default: '' },
  fixedFooter: { type: Boolean, default: false },
  panelHeight: { type: Number, default: 640 },
});
const emit = defineEmits(['close', 'opened']);
const rendered = ref(false),
  visible = ref(false);
let animationTimer: number = 0;
watch(
  (): boolean => props.open,
  (open: boolean) => {
    clearTimeout(animationTimer);
    if (open) {
      rendered.value = true;
      animationTimer = setTimeout(() => {
        visible.value = true;
        animationTimer = setTimeout(() => {
          if (props.open) emit('opened');
        }, 180);
      }, 30);
    } else {
      visible.value = false;
      animationTimer = setTimeout(() => {
        rendered.value = false;
      }, 180);
    }
  },
  { immediate: true },
);
onUnmounted(() => clearTimeout(animationTimer));
const info = uni.getWindowInfo(),
  maxHeight = ref(info.windowHeight - info.safeAreaInsets.top - info.safeAreaInsets.bottom - 48);
const keyboard = (e: OnKeyboardHeightChangeCallbackResult) => {
  maxHeight.value = Math.max(160, info.windowHeight - info.safeAreaInsets.top - e.height - 48);
};
// #ifdef APP
const keyboardId = uni.onKeyboardHeightChange(keyboard);
onUnmounted(() => uni.offKeyboardHeightChange(keyboardId));
// #endif
function close() {
  if (!props.busy) emit('close');
}
function noop() {}
</script>
<style scoped>
.mask {
  transition-property: opacity;
  transition-duration: 180ms;
  transition-timing-function: ease-out;
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(24, 30, 42, 0.56);
  z-index: 100;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.panel {
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: ease-out;
  width: 100%;
  max-width: 520px;
  border-radius: 22px;
  background-color: #ffffff;
  overflow: hidden;
}
.popup-head {
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20px 18px 12px;
  border-bottom: 1px solid #edf1f7;
  border-bottom-width: 0;
}
.close {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  padding: 0;
  margin: 0 0 0 12px;
  border-radius: 20px;
  background-color: #f4f6fa;
  border-width: 0;
  align-items: center;
  justify-content: center;
}
.popup-head {
  flex-shrink: 0;
}
.popup-head .title {
  flex: 1;
}
.popup-scroll {
  flex-shrink: 1;
  min-height: 0;
}
.popup-body {
  flex-shrink: 0;
  padding: 0 18px 18px;
}
.account-panel .popup-scroll {
  flex: 1;
  height: 0;
}
.popup-footer {
  min-height: 80px;
  flex-shrink: 0;
  padding: 12px 18px 20px;
  border-top: 1px solid #edf1f7;
  background-color: #ffffff;
}
.sheet-mask {
  padding: 0;
  justify-content: flex-end;
}
.sheet-panel {
  max-width: 760px;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  padding-bottom: 34px;
}
.popup-head .title {
  font-size: 16px;
}
.popup-head {
  padding-top: 19px;
  padding-bottom: 8px;
}
.sheet-panel .title {
  font-size: 18px;
}
.account-panel .title {
  font-size: 20px;
}
.conversation-mask {
  justify-content: flex-start;
}
.conversation-panel .popup-body {
  padding-bottom: 8px;
}
.friend-search-panel .popup-head {
  border-bottom: 1px solid #edf0f7;
  margin: 0 18px 12px;
  padding-left: 0;
  padding-right: 0;
}
.personal-qr-panel {
  background-color: #eef3ff;
  /* #ifdef WEB */
  background-image: linear-gradient(145deg, #eaf6ff, #f3efff);
  /* #endif */
  /* #ifndef WEB */
  background-image: linear-gradient(to bottom right, #eaf6ff, #f3efff);
  /* #endif */
  border: 1px solid #ffffff;
  border-radius: 26px;
}
</style>
