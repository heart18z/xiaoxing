<template>
  <view :class="['message', user ? 'user' : 'assistant']">
    <view v-if="avatarUrl.length == 0" class="initial">
      <text>{{ s(session.profile, 'name', t('我')).slice(0, 1) }}</text>
    </view>
    <image v-else class="message-avatar" :src="avatarUrl" />
    <view
      :class="[
        'message-main',
        !user && (reason.length > 0 || candidate || notification) ? 'wide-message' : '',
      ]"
      :style="{ maxWidth: messageWidth + 'px', width: user ? 'auto' : messageWidth + 'px' }"
    >
      <view
        v-if="!notification && (!candidate || s(item, 'content').length > 0 || reason.length > 0)"
        :class="['bubble', user ? 'user-bubble' : '', !user ? 'thought-bubble' : '']"
      >
        <ThinkingPanel
          v-if="reason.length > 0 && !user"
          :content="reason"
          :open="expanded"
          :streaming="isStreaming"
          @toggle="expanded = !expanded"
        />
        <view
          style="align-self: stretch"
          v-if="s(item, 'content').length > 0"
          :class="[reason.length > 0 ? 'reply-after-thinking' : '']"
        >
          <text v-if="user" class="user-text" selectable>{{ s(item, 'content') }}</text>
          <rich-text v-else :nodes="markdown(replyText(item))" />
        </view>
        <ReplyProgress v-if="isStreaming && reason.length == 0 && s(item, 'content').length == 0" />
        <text
          v-if="strings(payload(item), 'fileNames').length > 0"
          :class="['sent-files', user ? 'user-files' : '']"
        >
          {{ t('附件：') }}{{ strings(payload(item), 'fileNames').join('、') }}
        </text>
        <view v-if="s(item, 'messageType') == 'EVENT_ASSIGNED'" class="card-footer">
          <text class="event-link" @click="openEvent(s(item, 'eventId'))">
            {{ t('查看事件详情 ›') }}
          </text>
          <text class="message-time">{{ messageTime }}</text>
        </view>
        <text
          v-for="id in strings(payload(item), 'eventIds')"
          :key="id"
          class="event-link"
          @click="openEvent(id)"
        >
          {{ t('查看事件 / 设置本机闹铃 ›') }}
        </text>
      </view>
      <view
        v-if="notification"
        :class="['notice', noticeClass]"
        @click="openEvent(s(item, 'eventId'))"
      >
        <view v-if="reason.length > 0" class="notice-thinking" @click.stop>
          <ThinkingPanel
            :content="reason"
            :open="expanded"
            :streaming="isStreaming"
            @toggle="expanded = !expanded"
          />
        </view>
        <text :class="['notice-label', noticeClass]">{{ t(label) }}</text>
        <view
          :class="[
            'notification-focus',
            s(item, 'messageType') == 'REMINDER' ? 'reminder-focus' : '',
          ]"
        >
          <text class="notification-content" selectable>
            {{
              s(item, 'messageType') == 'FEEDBACK'
                ? s(payload(item), 'fact', s(item, 'content'))
                : s(item, 'content')
            }}
          </text>
          <text
            v-if="s(item, 'messageType') == 'FEEDBACK' && s(payload(item), 'actor').length > 0"
            class="notification-actor"
          >
            {{ t('反馈人：') }}{{ s(payload(item), 'actor') }}
          </text>
          <text v-if="s(payload(item), 'eventSummary').length > 0" class="related">
            <text :class="['related-label', 'related-' + noticeClass]">{{ t('关联事件') }}</text>
            　{{ s(payload(item), 'eventSummary') }}
          </text>
        </view>
        <view class="card-footer">
          <text v-if="s(item, 'eventId').length > 0" class="event-link">
            {{ t('查看事件详情 ›') }}
          </text>
          <text class="message-time">{{ messageTime }}</text>
        </view>
      </view>
      <view v-if="candidate" :class="['candidate', macro ? 'macro-card' : '']">
        <text :class="['notice-label', macro ? 'macro-label' : '']">
          {{ macro ? '◎' : '◷' }} {{ t(candidateHeading) }}
        </text>
        <text v-if="conflict && s(item, 'messageType') == 'CANDIDATE'" class="schedule-warning">
          {{ t('发现不同事项的时间冲突，只有选择“仍要安排”后才会创建并通知接收人。') }}
        </text>
        <view
          v-for="(event, index) in arr(payload(item), 'events')"
          :key="index"
          :class="['candidate-event', eventMacro(event) ? 'macro-event' : '']"
        >
          <text class="candidate-title">{{ s(event, 'summary') }}</text>
          <text class="muted">{{ t('接收人：') }}{{ recipients(event) }}</text>
          <text class="muted">
            {{ eventMacro(event) ? t('目标周期') : t('事件时间') }}：{{
              s(event, 'timeDescription', s(event, 'eventTime', t('持续跟进')))
            }}
          </text>
          <text class="muted">
            {{ eventMacro(event) ? t('首次跟进') : t('首次评估') }}：{{
              s(event, 'firstEvaluateTime')
            }}
          </text>
          <view v-if="s(item, 'messageType') == 'CANDIDATE'" class="alarm-choice">
            <view
              :class="['alarm-checkbox', alarms.includes(index) ? 'alarm-checked' : '']"
              @click="toggleAlarm(index)"
            >
              <text v-if="alarms.includes(index)" class="alarm-tick">✓</text>
            </view>
            <text class="alarm-copy">{{ t('同时设置本机系统闹铃（iOS 26+）') }}</text>
          </view>
          <text
            v-if="s(item, 'messageType') == 'CANDIDATE' && alarms.includes(index)"
            class="alarm-hint"
          >
            {{ t('仅为自己接收的任务设置，需系统授权；其他手机不会自动设置。') }}
          </text>
        </view>
        <view v-if="s(item, 'messageType') != 'CANDIDATE'" class="confirmed">
          <text class="confirmed-text">{{ t(candidateLabel) }}</text>
        </view>
        <button
          v-else
          :class="['primary', macro ? 'macro-button' : '']"
          :disabled="busy"
          :loading="busy"
          @click="emit('confirm', item, alarms)"
        >
          {{ t(candidateLabel) }}
        </button>
      </view>
    </view>
  </view>
</template>
<script setup lang="uts">
import UiIcon from '@/components/UiIcon.uvue';
import { t as _t } from '@/core/locale.uts';
import ThinkingPanel from './ThinkingPanel.uvue';
import ReplyProgress from './ReplyProgress.uvue';
import { timeOf, dayOf } from '@/core/time.uts';
import { ref, computed, watch } from 'vue';
import { SessionState, session as _session } from '@/store/session.uts';
import {
  firstText,
  s as _s,
  b,
  payload as _payload,
  arr as _arr,
  strings as _strings,
} from '@/core/json.uts';
import { asset, openEvent as _openEvent } from '@/core/ui.uts';
import { markdown as _markdown } from '@/core/markdown.uts';
const session: SessionState = _session;
function t(value: string): string {
  return _t(value);
}
function s(row: UTSJSONObject, key: string, fallback: string = ''): string {
  return _s(row, key, fallback);
}
function arr(row: UTSJSONObject, key: string): UTSJSONObject[] {
  return _arr(row, key);
}
function strings(row: UTSJSONObject, key: string): string[] {
  return _strings(row, key);
}
function payload(row: UTSJSONObject): UTSJSONObject {
  return _payload(row);
}
function markdown(value: string): string {
  return _markdown(value);
}
function openEvent(id: string): void {
  return _openEvent(id);
}
const messageWidth = Math.max(180, (uni.getWindowInfo().windowWidth - 70) * 0.94);
const props = defineProps<{ item: UTSJSONObject; busy: boolean }>();
const emit = defineEmits(['confirm']);
const expanded = ref(false),
  alarms = ref<number[]>([]);
const user = computed(() => s(props.item, 'messageRole') == 'user'),
  avatarUrl = computed(() =>
    asset(
      user.value
        ? s(session.profile, 'avatar')
        : s(session.summary, 'aiAvatar', '/avatars/assistant/A3.png'),
    ),
  );
const reason = computed(() =>
    s(props.item, 'reasoningContent').length > 0
      ? s(props.item, 'reasoningContent')
      : s(payload(props.item), 'reasoningContent'),
  ),
  candidate = computed(() => s(props.item, 'messageType').startsWith('CANDIDATE'));
const notification = computed(
  () =>
    ['REMINDER', 'QUESTION', 'FEEDBACK', 'CONFLICT'].includes(s(props.item, 'messageType')) &&
    !(s(props.item, 'messageType') == 'CONFLICT' && s(payload(props.item), 'detail').length > 0),
);
const label = computed(() => {
  const type = s(props.item, 'messageType');
  return type == 'FEEDBACK'
    ? '✓ 进展反馈'
    : type == 'REMINDER'
      ? '◷ 提醒消息'
      : type == 'QUESTION'
        ? '! 异常提醒'
        : '! 冲突处理';
});
function replyText(item: UTSJSONObject): string {
  const text = s(item, 'content');
  return text == '该事件已结束，不能再提交反馈。'
    ? '这条提醒已经结束了，本次没有追加进展。如果还需要提醒，告诉我新的时间就好。'
    : text;
}
function eventMacro(event: UTSJSONObject): boolean {
  const description = s(event, 'timeDescription');
  if (
    s(event, 'eventTime').length == 0 &&
    (description.includes('年') ||
      description.includes('长期') ||
      description.includes('目标') ||
      s(event, 'deadlineTime').length == 0)
  )
    return true;
  const deadline = timeOf(s(event, 'deadlineTime'));
  return deadline - Date.now() > 30 * 86400000;
}
const macro = computed(() =>
  arr(payload(props.item), 'events').some((event: UTSJSONObject): boolean => eventMacro(event)),
);
const conflict = computed(() =>
  arr(payload(props.item), 'events').some(
    (event: UTSJSONObject): boolean => arr(event, 'scheduleConflicts').length > 0,
  ),
);
const candidateHeading = computed(() => {
  const type = s(props.item, 'messageType');
  return type == 'CANDIDATE_CONFIRMED'
    ? '事件已创建'
    : type == 'CANDIDATE_CANCELLED'
      ? '事件已取消'
      : type == 'CANDIDATE_EXPIRED'
        ? '操作已失效'
        : macro.value
          ? '长期目标确认'
          : '近期事件确认';
});
const messageTime = computed(() => {
  const value = s(props.item, 'createTime').replace('T', ' ');
  return value.length > 0
    ? value.slice(0, 10) == dayOf()
      ? t('今天') + ' ' + value.slice(11, 16)
      : value.slice(5, 16)
    : '';
});
const noticeClass = computed(() => {
  const type = s(props.item, 'messageType');
  return type == 'FEEDBACK'
    ? 'feedback-card'
    : type == 'REMINDER'
      ? 'reminder-card'
      : type == 'QUESTION'
        ? 'exception-card'
        : 'conflict-card';
});
const candidateLabel = computed(() => {
  const type = s(props.item, 'messageType');
  return type == 'CANDIDATE'
    ? props.busy
      ? '正在创建…'
      : conflict.value
        ? '仍要安排'
        : macro.value
          ? '确认开始跟进'
          : '确认创建'
    : type == 'CANDIDATE_CONFIRMED'
      ? '已创建'
      : type == 'CANDIDATE_CANCELLED'
        ? '已取消'
        : '已失效';
});
function recipients(event: UTSJSONObject): string {
  return arr(event, 'recipients')
    .map((person: UTSJSONObject): string =>
      firstText(person, ['friendRemark', 'name', 'realName', 'displayName', 'account']),
    )
    .join('、');
}
function toggleAlarm(index: number) {
  alarms.value = alarms.value.includes(index)
    ? alarms.value.filter((i: number): boolean => i != index)
    : alarms.value.concat([index]);
}

watch(
  (): string => s(props.item, 'id'),
  () => {
    expanded.value = b(props.item, 'streaming');
    alarms.value = arr(payload(props.item), 'events')
      .map((event: UTSJSONObject, index: number): number =>
        b(event, 'alarmRequested') ? index : -1,
      )
      .filter((index: number): boolean => index >= 0);
  },
  { immediate: true },
);

const isStreaming = computed(() => b(props.item, 'streaming'));
</script>
