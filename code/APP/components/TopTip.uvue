<template>
  <!-- #ifndef WEB -->
  <StartupMask />
  <!-- #endif -->
  <view
    v-if="tip.rendered"
    :class="['top-tip', 'tip-' + tip.tone]"
    :style="{
      top: topStyle,
      left: side + 'px',
      right: side + 'px',
      opacity: tip.visible ? 1 : 0,
      transform: tip.visible ? 'translateY(0px) scale(1)' : 'translateY(-20px) scale(0.96)',
    }"
  >
    <view :class="['tip-mark', 'mark-' + tip.tone]">
      <UiIcon
        :name="tip.tone == 'success' ? 'tipSuccess' : tip.tone == 'error' ? 'tipError' : 'tipInfo'"
        :tone="'white'"
        :size="19"
      />
    </view>
    <text class="app-font tip-text">{{ tip.text }}</text>
  </view>
</template>
<script setup lang="uts">
import StartupMask from './StartupMask.uvue';
import UiIcon from './UiIcon.uvue';
import { tip as _tip, TipState } from '@/store/tip.uts';
const tip: TipState = _tip;
const info = uni.getWindowInfo();
const side = Math.max(24, (info.windowWidth - 360) / 2);
const top = Math.max(info.safeAreaInsets.top, info.statusBarHeight) + 8;
let topStyle = top + 'px';
// #ifdef WEB
topStyle = 'max(' + top + 'px, calc(env(safe-area-inset-top, 0px) + 8px))';
// #endif
</script>
<style scoped>
.top-tip {
  pointer-events: none;
  position: fixed;
  z-index: 9999;
  flex-direction: row;
  align-items: center;
  min-height: 58px;
  padding: 13px 16px;
  border-radius: 17px;
  background-color: #243556;
  border: 1px solid #6984b8;
  box-shadow: 0 10px 28px #14234055;
  transition-property: opacity, transform;
  transition-duration: 240ms;
  transition-timing-function: ease-out;
}
.tip-mark {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  border-radius: 10px;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
}
.mark-info {
  background-color: #4778ff;
}
.mark-success {
  background-color: #1fa879;
}
.mark-error {
  background-color: #e36b78;
}
.tip-text {
  flex: 1;
  color: #ffffff;
  font-size: 15px;
  font-weight: 600;
  line-height: 23px;
}
.tip-success {
  background-color: #193f38;
  border-color: #4c9b82;
}
.tip-error {
  background-color: #552e3b;
  border-color: #b67186;
}
/* #ifdef WEB */
.tip-text {
  overflow-wrap: anywhere;
}
@media (prefers-reduced-motion: reduce) {
  .top-tip {
    transition-duration: 0ms;
  }
}
/* #endif */
</style>
