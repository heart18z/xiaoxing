<template>
  <!-- #ifndef WEB -->
  <StartupMask />
  <!-- #endif -->
  <view
    v-if="tip.rendered"
    :class="['top-tip', 'tip-' + tip.tone]"
    :style="{
      top: topStyle,
      left: side + 'px',
      right: side + 'px',
      opacity: tip.visible ? 1 : 0,
      transform: tip.visible ? 'translateY(0px) scale(1)' : 'translateY(-20px) scale(0.96)',
    }"
  >
    <view :class="['tip-halo', 'halo-' + tip.tone]">
      <view :class="['tip-mark', 'mark-' + tip.tone]">
        <UiIcon
          :name="tip.tone == 'success' ? 'check' : tip.tone == 'error' ? 'close' : 'tipInfo'"
          tone="white"
          :size="22"
        />
      </view>
    </view>
    <text class="app-font tip-text">{{ tip.text }}</text>
    <view class="tip-close" role="button" aria-label="关闭提示" @click.stop="hideTip()">
      <UiIcon name="close" tone="muted" :size="20" />
    </view>
  </view>
</template>
<script setup lang="uts">
import StartupMask from './StartupMask.uvue';
import UiIcon from './UiIcon.uvue';
import { tip as _tip, TipState, hideTip as _hideTip } from '@/store/tip.uts';
function hideTip(): void { _hideTip(); }
const tip: TipState = _tip;
const info = uni.getWindowInfo();
const side = Math.max(24, (info.windowWidth - 360) / 2);
const top = Math.max(info.safeAreaInsets.top, info.statusBarHeight) + 8;
let topStyle = top + 'px';
// #ifdef WEB
topStyle = 'max(' + top + 'px, calc(env(safe-area-inset-top, 0px) + 8px))';
// #endif
</script>
<style scoped>
.top-tip {
  position: fixed;
  z-index: 9999;
  flex-direction: row;
  align-items: center;
  min-height: 60px;
  padding: 8px 10px 8px 14px;
  border-radius: 20px;
  background-color: #f5f9ff;
  background-image: linear-gradient(to right, #f8fcff, #eaf1ff);
  border: 1px solid #ffffff;
  box-shadow: 0 10px 28px #4d73d94d;
  transition-property: opacity, transform;
  transition-duration: 240ms;
  transition-timing-function: ease-out;
}
.tip-halo {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  border-radius: 21px;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}
.halo-info { background-color: #dde7ff; }
.halo-success { background-color: #dcf7ec; }
.halo-error { background-color: #ffeaed; }
.tip-mark {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  align-items: center;
  justify-content: center;
}
.mark-info {
  background-color: #6083ef;
}
.mark-success {
  background-color: #28c58d;
}
.mark-error {
  background-color: #ed8495;
}
.tip-text {
  flex: 1;
  min-width: 0;
  color: #192c4d;
  font-size: 15px;
  font-weight: 600;
  line-height: 23px;
}
.tip-close {
  width: 36px;
  height: 40px;
  flex-shrink: 0;
  margin-left: 6px;
  align-items: center;
  justify-content: center;
}
/* #ifdef WEB */
.tip-text {
  overflow-wrap: anywhere;
}
@media (prefers-reduced-motion: reduce) {
  .top-tip {
    transition-duration: 0ms;
  }
}
/* #endif */
</style>
