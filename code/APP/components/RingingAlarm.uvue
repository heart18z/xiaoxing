<template>
  <view v-if="alarmState.ringing" class="ringing-bar">
    <view class="ringing-copy" @click="open()">
      <text class="app-font ringing-title">正在响铃</text>
      <text class="app-font ringing-detail" :lines="1">{{ alarmState.title }}</text>
      <text class="app-font ringing-link">查看闹铃 ›</text>
    </view>
    <button class="app-font ringing-stop" :disabled="busy" @click="stop()">{{ busy ? '正在停止…' : '停止响铃' }}</button>
  </view>
</template>
<script setup lang="uts">
import { ref } from 'vue';
import { alarmState, stopRingingAlarm, openRingingAlarm } from '@/services/native.uts';
import { toast } from '@/core/ui.uts';
import { message } from '@/core/json.uts';
const busy = ref(false);
async function stop() {
  if (busy.value) return;
  busy.value = true;
  try { await stopRingingAlarm(); toast('闹铃已关闭'); }
  catch(e) { toast(message(e)); }
  finally { busy.value = false; }
}
async function open() { try { await openRingingAlarm(); } catch(e) { toast(message(e)); } }
</script>
<style scoped>
.ringing-bar { flex-shrink: 0; flex-direction: row; align-items: center; margin: 4px 16px 8px; padding: 12px; border-radius: 16px; background-color: #fff1e3; border: 1px solid #f1ce9f; }
.ringing-copy { flex: 1; min-width: 0; }
.ringing-title { font-size: 16px; font-weight: 700; color: #934508; }
.ringing-detail { margin-top: 3px; font-size: 12px; color: #7a6050; lines: 1; text-overflow: ellipsis; }
.ringing-link { margin-top: 3px; font-size: 12px; font-weight: 600; color: #934508; }
.ringing-stop { flex-shrink: 0; height: 42px; min-height: 42px; line-height: 42px; margin: 0 0 0 10px; padding: 0 14px; border-radius: 12px; background-color: #c75324; color: #ffffff; font-size: 14px; font-weight: 700; }
</style>
