<template>
  <Popup
    :open="open"
    :title="t(creating ? '创建群组' : '群组资料')"
    :busy="saving"
    variant="group-compact"
    :fixed-footer="true"
    :panel-height="456"
    @close="emit('close')"
  >
    <view class="editor-summary">
      <view class="avatar-column">
        <text class="app-font field-title">{{ t('群组头像') }}</text>
        <view class="upload-cover" @click="pickAvatar()">
          <image class="group-picture" :src="asset(avatar)" mode="aspectFill" />
        </view>
        <text class="app-font avatar-hint" @click="pickAvatar()">
          {{ t(saving ? '上传中…' : '点击头像更换') }}
        </text>
      </view>
      <view class="fields-column">
        <text class="app-font field-title">
          {{ t('群组名称') }}
          <text class="required">*</text>
        </text>
        <input
          class="app-font name-input"
          v-model="name"
          maxlength="60"
          :adjust-position="false"
          :placeholder="t('请输入群组名称')"
        />
        <text class="app-font field-title intro-title">{{ t('群组介绍') }}</text>
        <view class="intro-field">
          <textarea
            class="app-font intro-input"
            v-model="introduction"
            maxlength="200"
            :adjust-position="false"
            :placeholder="t('请输入群组介绍')"
          />
          <text class="app-font counter">{{ introduction.length }}/200</text>
        </view>
      </view>
    </view>
    <text class="app-font field-title avatar-title">{{ t('选择头像') }}</text>
    <view class="avatar-grid">
      <view
        v-for="url in groupAvatars"
        :key="url"
        class="avatar-cell"
        @click="!saving && (avatar = url)"
      >
        <view :class="['avatar-border', avatar == url ? 'avatar-selected' : '']">
          <image class="preset-image" :src="asset(url)" mode="aspectFit" />
          <view v-if="avatar == url" class="selected-dot">
            <UiIcon name="check" tone="white" :size="18" />
          </view>
        </view>
      </view>
    </view>
    <text v-if="error.length > 0" class="app-font error">{{ t(error) }}</text>
    <template #footer>
      <view class="form-actions">
        <button class="app-font secondary form-button" :disabled="saving" @click="emit('close')">
          {{ t('取消') }}
        </button>
        <button
          class="app-font primary form-button"
          :disabled="saving"
          :loading="saving"
          @click="save()"
        >
          {{ t(creating ? '创建' : '保存') }}
        </button>
      </view>
    </template>
  </Popup>
</template>
<script setup lang="uts">
import { ref, watch } from 'vue';
import Popup from './Popup.uvue';
import UiIcon from './UiIcon.uvue';
import { t } from '@/core/locale.uts';
import { s, obj, message } from '@/core/json.uts';
import { reminder, upload } from '@/api/request.uts';
import { asset } from '@/core/ui.uts';
import { pickImages } from '@/services/images.uts';
import { groupAvatars } from '@/core/groups.uts';
const props = defineProps({
  open: { type: Boolean, default: false },
  group: { type: Object, default: (): UTSJSONObject => ({}) },
  creating: { type: Boolean, default: false },
});
const emit = defineEmits(['close', 'saved']);
const name = ref(''),
  avatar = ref(groupAvatars[0]),
  introduction = ref(''),
  error = ref(''),
  saving = ref(false);
watch(
  (): boolean => props.open,
  (open: boolean) => {
    if (!open) return;
    const group = props.group as UTSJSONObject;
    name.value = props.creating ? '' : s(group, 'name');
    avatar.value = props.creating
      ? groupAvatars[Math.floor(Math.random() * groupAvatars.length)]
      : s(group, 'avatar', groupAvatars[0]);
    introduction.value = props.creating ? '' : s(group, 'introduction');
    error.value = '';
  },
);
function pickAvatar(): void {
  if (saving.value) return;
  pickImages(1, (result) => {
    if (result.tempFiles[0].size > 2 * 1024 * 1024) {
      error.value = '头像不能超过2MB';
      return;
    }
    void uploadAvatar(result.tempFilePaths[0]);
  });
}
async function uploadAvatar(path: string) {
  saving.value = true;
  error.value = '';
  try {
    const result = await upload('/blade-resource/oss/endpoint/put-file', path, 120000);
    const url = s(result, 'link', s(result, 'url'));
    if (url.length == 0) throw new Error('上传未返回头像地址');
    avatar.value = url;
  } catch (e) {
    error.value = message(e);
  } finally {
    saving.value = false;
  }
}
async function save() {
  if (saving.value) return;
  if (name.value.trim().length == 0) {
    error.value = '请输入群组名称';
    return;
  }
  saving.value = true;
  error.value = '';
  try {
    const result = obj(
      await reminder(props.creating ? 'groups/create' : 'groups/save', {
        groupId: props.creating ? null : s(props.group as UTSJSONObject, 'id'),
        name: name.value.trim(),
        avatar: avatar.value,
        introduction: introduction.value.trim(),
        groupType: 'CUSTOM',
      }),
      'value',
    );
    emit('saved', result);
  } catch (e) {
    error.value = message(e);
  } finally {
    saving.value = false;
  }
}
</script>
