<template>
  <view class="alarm" :class="active ? 'alarm-active' : ''">
    <view class="alarm-header">
      <UiIcon name="clock" :size="17" tone="blue" />
      <text class="app-font alarm-title">{{ t('本机闹铃') }}</text>
      <text class="app-font alarm-state" :class="active ? 'alarm-state-active' : ''">
        {{ !ready ? t('读取中…') : active ? t('已开启') : t('未开启') }}
      </text>
    </view>
    <view class="alarm-main">
      <view class="alarm-copy">
        <text class="app-font alarm-time">
          {{
            active
              ? scheduledTime.length > 0
                ? scheduledTime
                : t('时间读取中')
              : t('按我的任务时间响铃')
          }}
        </text>
        <text class="app-font alarm-caption">
          {{ active ? t('响铃时间 · 北京时间') : t('仅在这台设备生效') }}
        </text>
      </view>
      <button
        class="app-font alarm-button"
        :class="active ? 'alarm-cancel' : ''"
        :loading="busy"
        :disabled="busy || !ready"
        @click="toggle()"
      >
        {{ busy ? t('处理中') : active ? t('关闭') : t('开启闹铃') }}
      </button>
    </view>
    <text class="app-font alarm-help" @click="helpOpen = true">{{ t('闹铃说明') }} ›</text>
    <text v-if="error.length > 0" class="app-font alarm-error">{{ error }}</text>
  </view>
  <Popup :open="helpOpen" :title="t('闹铃说明')" @close="helpOpen = false">
    <text class="app-font body-text">
      {{ t('仅为自己接收的任务设置；好友需在自己的手机上操作。') }}
    </text>
    <text class="app-font muted">
      {{ t('需要 iOS 26 及支持 AlarmKit 的安装包，普通提醒继续生效。') }}
    </text>
  </Popup>
</template>
<script setup lang="uts">
import { t as _t } from '@/core/locale.uts';
import Popup from './Popup.uvue';
import UiIcon from './UiIcon.uvue';
import { alarmTime } from '@/core/alarms.uts';
import { ref, computed, onMounted } from 'vue';
import { alarmList, setAlarm, cancelAlarm } from '@/services/native.uts';
import { s as _s, b, obj, arr, message } from '@/core/json.uts';
import { toast } from '@/core/ui.uts';
function t(value: string): string {
  return _t(value);
}
function s(row: UTSJSONObject, key: string, fallback: string = ''): string {
  return _s(row, key, fallback);
}
const props = defineProps<{ detail: UTSJSONObject }>();
const helpOpen = ref(false);
const ready = ref(false);
const supported = ref(false),
  items = ref<UTSJSONObject[]>([]),
  busy = ref(false),
  error = ref('');
const activeItem = computed(
  () =>
    items.value.find(
      (row: UTSJSONObject): boolean =>
        s(row, 'eventId') == s(obj(props.detail, 'event'), 'id') && b(row, 'active'),
    ) ?? ({} as UTSJSONObject),
);
const active = computed(() => s(activeItem.value, 'id').length > 0);
const scheduledTime = computed(() => alarmTime(activeItem.value));
async function refresh() {
  const data = await alarmList();
  supported.value = b(data, 'supported');
  items.value = arr(data, 'alarms');
}
async function toggle() {
  if (busy.value || !ready.value) return;
  if (!supported.value) {
    helpOpen.value = true;
    return;
  }
  busy.value = true;
  error.value = '';
  try {
    if (active.value) await cancelAlarm(s(obj(props.detail, 'event'), 'id'));
    else await setAlarm(props.detail);
    await refresh();
    toast(active.value ? '闹铃已设置 · ' + scheduledTime.value : '本机闹铃已取消');
  } catch (e) {
    error.value = message(e);
  } finally {
    busy.value = false;
  }
}
onMounted(() => {
  refresh()
    .catch((e) => {
      error.value = message(e);
    })
    .finally(() => {
      ready.value = true;
    });
});
</script>

<style scoped>
.alarm {
  margin-top: 14px;
  padding: 12px;
  background-color: #f4f6ff;
  border: 1px solid #e8ecfa;
  border-radius: 14px;
}
.alarm-active {
  background-color: #f0f8f6;
  border-color: #dceee8;
}
.alarm-header {
  flex-direction: row;
  align-items: center;
}
.alarm-title {
  flex: 1;
  margin-left: 6px;
  font-size: 13px;
  font-weight: 600;
  color: #455371;
}
.alarm-state {
  font-size: 10px;
  line-height: 18px;
  padding: 0 6px;
  border-radius: 6px;
  color: #8590a5;
  background-color: #e9edf6;
}
.alarm-state-active {
  color: #248774;
  background-color: #ddf1e9;
}
.alarm-main {
  flex-direction: row;
  align-items: center;
  margin-top: 10px;
}
.alarm-copy {
  flex: 1;
  min-width: 0;
}
.alarm-time {
  font-size: 14px;
  line-height: 21px;
  font-weight: 600;
  color: #263b56;
}
.alarm-caption {
  margin-top: 3px;
  font-size: 10px;
  line-height: 16px;
  color: #8994a7;
}
.alarm-button {
  flex-shrink: 0;
  height: 32px;
  min-height: 32px;
  line-height: 32px;
  margin: 0 0 0 8px;
  padding: 0 10px;
  font-size: 12px;
  font-weight: 600;
  border-width: 0;
  border-radius: 9px;
  color: #ffffff;
  background-color: #4a60ff;
}
.alarm-cancel {
  color: #65718a;
  background-color: #e6eeed;
}
.alarm-help {
  align-self: flex-start;
  margin-top: 6px;
  padding: 4px 0;
  font-size: 10px;
  line-height: 16px;
  color: #7b88a1;
}
.alarm-error {
  font-size: 11px;
  line-height: 18px;
  color: #be515e;
  margin-top: 4px;
}
</style>
