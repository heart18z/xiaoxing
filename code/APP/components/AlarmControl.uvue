<template>
  <view class="alarm">
    <text class="app-font label">{{ t('本机闹铃') }}</text>
    <text class="app-font muted">
      {{ active ? displayTime(s(activeItem, 'displayTime')) : t('未设置 · 按我的任务时间响铃') }}
    </text>
    <button
      class="app-font"
      :class="[active ? 'danger' : 'primary', 'alarm-button']"
      :loading="busy"
      :disabled="busy"
      @click="toggle()"
    >
      {{ active ? t('取消本机闹铃') : t('设置本机闹铃') }}
    </button>
    <text class="app-font alarm-help" @click="helpOpen = true">{{ t('闹铃说明') }}</text>
    <text v-if="error.length > 0" class="app-font error">{{ error }}</text>
  </view>
  <Popup :open="helpOpen" :title="t('闹铃说明')" @close="helpOpen = false">
    <text class="app-font body-text">
      {{ t('仅为自己接收的任务设置；好友需在自己的手机上操作。') }}
    </text>
    <text class="app-font muted">
      {{ t('需要 iOS 26 及支持 AlarmKit 的安装包，普通提醒继续生效。') }}
    </text>
  </Popup>
</template>
<script setup lang="uts">
import { t as _t } from '@/core/locale.uts';
import Popup from './Popup.uvue';
import { ref, computed, onMounted } from 'vue';
import { alarmList, setAlarm, cancelAlarm } from '@/services/native.uts';
import { s as _s, b, obj, arr, message } from '@/core/json.uts';
import { displayTime as _displayTime } from '@/core/time.uts';
import { toast } from '@/core/ui.uts';
function t(value: string): string {
  return _t(value);
}
function s(row: UTSJSONObject, key: string, fallback: string = ''): string {
  return _s(row, key, fallback);
}
function displayTime(value: string): string {
  return _displayTime(value);
}
const props = defineProps<{ detail: UTSJSONObject }>();
const helpOpen = ref(false);
const supported = ref(false),
  items = ref<UTSJSONObject[]>([]),
  busy = ref(false),
  error = ref('');
const activeItem = computed(
  () =>
    items.value.find(
      (row: UTSJSONObject): boolean =>
        s(row, 'eventId') == s(obj(props.detail, 'event'), 'id') && b(row, 'active'),
    ) ?? ({} as UTSJSONObject),
);
const active = computed(() => s(activeItem.value, 'id').length > 0);
async function refresh() {
  try {
    const data = await alarmList();
    supported.value = b(data, 'supported');
    items.value = arr(data, 'alarms');
  } catch (e) {
    error.value = message(e);
  }
}
async function toggle() {
  if (busy.value) return;
  if (!supported.value) {
    helpOpen.value = true;
    return;
  }
  busy.value = true;
  error.value = '';
  try {
    if (active.value) await cancelAlarm(s(obj(props.detail, 'event'), 'id'));
    else await setAlarm(props.detail);
    await refresh();
    toast(active.value ? '本机系统闹铃已设置' : '本机闹铃已取消');
  } catch (e) {
    error.value = message(e);
  } finally {
    busy.value = false;
  }
}
onMounted(() => {
  void refresh();
});
</script>
<style scoped>
.alarm {
  margin-top: 18px;
  padding: 15px 14px;
  background-color: #f1f2ff;
  border-radius: 17px;
}
.label {
  font-size: 15px;
  color: #5d647a;
  margin-bottom: 8px;
}
.alarm-button {
  align-self: flex-start;
  font-size: 12px;
  font-weight: 400;
  padding: 0 10px;
  line-height: 38px;
  min-height: 38px;
  margin-top: 10px;
  margin-bottom: 10px;
  background-color: #5865ff;
}
.alarm-help {
  font-size: 12px;
  color: #969cab;
  padding: 4px 0;
}
</style>
