<template>
  <view class="groups-area">
    <view class="group-heading">
      <view class="grow">
        <text class="app-font group-title">{{ t('我的组织') }}</text>
        <text class="app-font group-help">{{ t('按成员标签，灵活发起提醒') }}</text>
      </view>
      <button class="app-font primary create-group" @click="emit('create')">
        ＋ {{ t('创建组织') }}
      </button>
    </view>
    <scroll-view class="group-scroll" :scroll-y="true" :bounces="false">
      <view v-if="error.length > 0" class="group-empty">
        <text class="app-font error">{{ t(error) }}</text>
        <button class="app-font secondary" @click="emit('retry')">{{ t('重新加载') }}</button>
      </view>
      <view v-else-if="rows.length == 0" class="group-empty">
        <UiIcon name="people" tone="blue" :size="36" />
        <text class="app-font empty-title">{{ t(loading ? '正在读取…' : '还没有群组') }}</text>
        <text class="app-font group-help">{{ t('创建群组、邀请好友，为成员设置多个标签') }}</text>
      </view>
      <view
        v-for="group in rows"
        :key="s(group, 'id')"
        :class="['group-row', compact ? 'group-row-compact' : '']"
        @click="open(group)"
      >
        <image
          class="group-avatar"
          :src="asset(s(group, 'avatar', groupAvatars[0]))"
          mode="aspectFill"
        />
        <view class="group-main">
          <text class="app-font row-name" :lines="1">{{ s(group, 'name') }}</text>
          <text class="app-font row-description" :lines="1">
            {{ s(group, 'introduction').length > 0 ? s(group, 'introduction') : t('自定义群组') }}
          </text>
          <view class="group-meta">
            <text class="app-font" :class="['role-chip', 'role-' + s(group, 'myRole')]">
              {{ t(groupRoleLabel(s(group, 'myRole'))) }}
            </text>
            <view class="member-previews">
              <image
                v-for="(person, index) in previews(group)"
                :key="s(person, 'id')"
                :class="['preview-avatar', index == 0 ? 'preview-first' : '']"
                :src="asset(s(person, 'avatar', '/avatars/user/B1.png'))"
                mode="aspectFill"
              />
              <view class="preview-more">
                <text class="app-font preview-number">+{{ remaining(group) }}</text>
              </view>
            </view>
            <text class="app-font member-separator">|</text>
            <text class="app-font member-count">{{ n(group, 'memberCount') }} {{ t('人') }}</text>
          </view>
        </view>
        <view class="group-open" @click.stop="open(group)">
          <UiIcon name="chevron" tone="ink" :size="20" />
        </view>
      </view>
    </scroll-view>
  </view>
</template>
<script setup lang="uts">
import UiIcon from './UiIcon.uvue';
import { t } from '@/core/locale.uts';
import { s, n, arr } from '@/core/json.uts';
import { asset } from '@/core/ui.uts';
import { groupRoleLabel, groupAvatars } from '@/core/groups.uts';
defineProps<{ rows: UTSJSONObject[]; loading: boolean; error: string }>();
const emit = defineEmits(['create', 'retry']);
const compact = uni.getWindowInfo().windowWidth < 360;
function previews(group: UTSJSONObject): UTSJSONObject[] {
  return arr(group, 'memberPreviews').slice(0, 4);
}
function remaining(group: UTSJSONObject): number {
  return Math.max(0, n(group, 'memberCount') - previews(group).length);
}
function open(group: UTSJSONObject): void {
  uni.navigateTo({ url: '/pages/group-detail/index?id=' + s(group, 'id') });
}
</script>
<style scoped>
.groups-area {
  width: 100%;
  min-width: 0;
  flex: 1;
  min-height: 0;
}
.group-heading {
  flex-direction: row;
  align-items: center;
  padding: 1px 2px 14px;
}
.group-title {
  font-size: 17px;
  font-weight: 600;
  color: #142146;
}
.group-help {
  font-size: 11px;
  line-height: 18px;
  color: #8996b0;
  margin-top: 3px;
}
