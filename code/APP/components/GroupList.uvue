  height: 40px;
  min-height: 40px;
  line-height: 40px;
  padding: 0 13px;
  margin: 0 0 0 6px;
  font-size: 13px;
  border-radius: 14px;
}
.group-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}
.group-row {
  flex-direction: row;
  align-items: center;
  padding: 13px 11px;
  margin-bottom: 10px;
  border-radius: 24px;
  background-color: #fffffff2;
  border: 1px solid #fff;
}
.group-avatar {
  width: 64px;
  height: 64px;
  border-radius: 17px;
  margin-right: 11px;
  flex-shrink: 0;
  background-color: #edf0ff;
}
.group-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.row-name {
  font-size: 15px;
  font-weight: 600;
  color: #152448;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-description {
  font-size: 11px;
  line-height: 17px;
  height: 17px;
  color: #8794ad;
  margin-top: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.group-meta {
  flex-direction: row;
  align-items: center;
  margin-top: 7px;
}
.role-chip {
  font-size: 10px;
  line-height: 17px;
  padding: 2px 7px;
  border-radius: 10px;
  flex-shrink: 0;
  margin-right: 6px;
}
.role-OWNER {
  color: #326bf3;
  background-color: #e8f0ff;
}
.role-ADMIN {
  color: #8a56df;
  background-color: #f0e9ff;
}
.role-MEMBER {
  color: #169c72;
  background-color: #e2f6ec;
}
.member-previews {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  overflow: visible;
  padding: 1px;
}
.preview-avatar {
  width: 24px;
  height: 24px;
  border: 2px solid #fff;
  border-radius: 13px;
  margin-left: -6px;
  flex-shrink: 0;
}
.preview-first {
  margin-left: 0;
}
.preview-more {
  width: 25px;
  height: 25px;
  margin-left: 1px;
  border-radius: 13px;
  background-color: #eef2ff;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.preview-number {
  color: #7e8eb9;
  font-size: 10px;
  font-weight: 600;
}
.member-separator {
  font-size: 12px;
  color: #c2cadd;
  margin: 0 6px;
  flex-shrink: 0;
}
.member-count {
  font-size: 11px;
  color: #8996b0;
  flex-shrink: 0;
}
.group-open {
  width: 20px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-left: 6px;
  padding: 8px 0;
}
.group-empty {
  align-items: center;
  padding: 34px 14px;
  border-radius: 22px;
  background-color: #ffffffd9;
}
.empty-title {
  font-size: 15px;
  font-weight: 600;
  color: #52617c;
  margin-top: 13px;
}
.group-row-compact .group-avatar {
  width: 50px;
  height: 50px;
  margin-right: 8px;
}
.group-row-compact .role-chip {
  font-size: 9px;
  padding: 2px 5px;
  margin-right: 4px;
}
.group-row-compact .preview-avatar {
  width: 20px;
