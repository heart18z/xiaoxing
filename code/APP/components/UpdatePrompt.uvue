<template>
  <view v-if="updates.prompt" class="update-mask" @click.stop="noop">
    <view class="update-panel" @click.stop="noop">
      <text class="app-font update-heading">
        {{ t(updates.required ? '需要更新 APP' : '发现新版本') }}
      </text>
      <text class="app-font update-version">{{ s(updates.release, 'versionName') }}</text>
      <scroll-view class="update-notes" :scroll-y="true">
        <text class="app-font notes-copy">{{ s(updates.release, 'notes') }}</text>
      </scroll-view>
      <text v-if="updates.required" class="app-font required-copy">
        {{ t('此版本为强制更新，完成安装后才能继续使用。') }}
      </text>
      <UpdateProgress />
      <text class="app-font update-feedback">{{ t(updates.feedback) }}</text>
      <view class="update-actions">
        <button
          v-if="!updates.required"
          class="app-font secondary action"
          :disabled="updates.installing"
          @click="dismissUpdate()"
        >
          {{ t('稍后更新') }}
        </button>
        <button
          class="app-font primary action"
          :disabled="updates.installing"
          :loading="updates.installing"
          @click="installUpdate()"
        >
          {{ t(updates.installing ? '正在下载…' : '立即更新') }}
        </button>
      </view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { updates, dismissUpdate, installUpdate } from '@/services/updates.uts';
import { s } from '@/core/json.uts';
import { t } from '@/core/locale.uts';
import UpdateProgress from './UpdateProgress.uvue';
function noop(): void {}
</script>
