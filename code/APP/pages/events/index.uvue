<template>
  <AppFrame
    :loading="loading"
    :title="t('我的事件')"
    :subtitle="t('帮你持续跟进每一件事')"
    tab="events"
  >
    <template #right>
      <view
        class="filter"
        @click="
          all = !all;
          load();
        "
      >
        <UiIcon name="filter" tone="blue" :size="17" />
        <text class="app-font filter-label">{{ all ? t('只看进行中') : t('查看全部') }}</text>
      </view>
    </template>
    <view class="filters">
      <view class="event-tabs">
        <view :class="['event-tab', type == 'sent' ? 'selected' : '']" @click="changeType('sent')">
          <text class="app-font" :class="['tab-text', type == 'sent' ? 'tab-blue' : '']">
            {{ t('我发起的') }}
          </text>
          <text class="app-font" :class="['count', type == 'sent' ? 'count-blue' : '']">
            {{ n(session.summary, 'sentActiveEventCount') }}
          </text>
          <view v-if="type == 'sent'" class="underline" />
        </view>
        <view
          :class="['event-tab', type == 'received' ? 'selected' : '']"
          @click="changeType('received')"
        >
          <text class="app-font" :class="['tab-text', type == 'received' ? 'tab-blue' : '']">
            {{ t('我收到的') }}
          </text>
          <text class="app-font" :class="['count', type == 'received' ? 'count-blue' : '']">
            {{ n(session.summary, 'receivedActiveEventCount') }}
          </text>
          <view v-if="type == 'received'" class="underline" />
        </view>
      </view>
      <view class="search-box">
        <UiIcon name="search" :size="22" />
        <input
          class="app-font search-input"
          v-model="keyword"
          :placeholder="t('搜索事件内容、编号或发起人')"
        />
      </view>
    </view>
    <scroll-view
      scroll-y
      class="scroll"
      refresher-enabled
      :refresher-triggered="refreshing"
      refresher-default-style="none"
      @refresherrefresh="refresh()"
    >
      <view slot="refresher" class="refresh-status">
        <view
          v-if="refreshing && !refreshComplete"
          class="refresh-orbit"
          :style="{ transform: 'rotate(' + refreshAngle + 'deg)' }"
        />
        <text class="app-font refresh-label">
          {{
            refreshing
              ? refreshComplete
                ? error.length > 0
                  ? t('更新失败，请重试')
                  : t('事件已更新')
                : t('正在更新事件…')
              : t('下拉刷新，松开更新')
          }}
        </text>
      </view>
      <view class="padded">
        <view v-if="error.length > 0" class="card">
          <text class="app-font error">{{ error }}</text>
          <button class="app-font secondary" @click="load()">{{ t('重新加载') }}</button>
        </view>
        <view v-if="!loading && filtered.length == 0" class="empty">
          <text class="app-font muted">{{ t('当前筛选下还没有事件') }}</text>
        </view>
        <view
          v-for="item in filtered"
          :key="s(item, 'id')"
          class="card event-card"
          @click="openEvent(s(item, 'id'))"
        >
          <view class="event-top">
            <view
              :class="[
                'status',
                s(item, 'branchStatus', s(item, 'eventStatus')) == 'ACTIVE'
                  ? ''
                  : 'status-inactive',
              ]"
            >
              <view
                :class="[
                  'status-dot',
                  s(item, 'branchStatus', s(item, 'eventStatus')) == 'ACTIVE' ? '' : 'dot-inactive',
                ]"
              />
              <text
                class="app-font"
                :class="[
                  'status-text',
                  s(item, 'branchStatus', s(item, 'eventStatus')) == 'ACTIVE'
                    ? ''
                    : 'text-inactive',
                ]"
              >
                {{ statusText(s(item, 'branchStatus', s(item, 'eventStatus'))) }}
              </text>
            </view>
            <text class="app-font event-number">{{ s(item, 'eventNo') }}</text>
            <UiIcon name="chevron" :size="16" />
          </view>
          <text class="app-font event-title">{{ s(item, 'eventSummary') }}</text>
          <view class="people">
            <UiIcon name="people" :size="17" />
            <text class="app-font muted">
              {{
                type == 'received'
                  ? t('发起人：') + s(item, 'creatorName', s(item, 'creatorRealName'))
                  : t('接收人 ') +
                    n(item, 'recipientCount') +
                    t(' 人 · 进行中 ') +
                    n(item, 'activeBranchCount') +
                    t(' 人')
              }}
            </text>
          </view>
          <view class="progress">
            <UiIcon name="note" tone="blue" :size="19" />
            <text class="app-font progress-label">{{ t('最新进展') }}</text>
            <text class="app-font progress-text">
              {{ progressText(item) }}
            </text>
          </view>
          <view class="event-dates">
            <view class="date-row">
              <UiIcon name="clock" :size="17" />
              <text class="app-font muted">
                {{ t('创建时间') }}　{{ displayTime(s(item, 'createTime')) }}
              </text>
            </view>
            <view class="date-row">
              <UiIcon name="calendar" :size="17" />
              <text class="app-font muted">
                {{ t('下次评估') }}　{{ s(item, 'nextEvaluateTime', t('无')) }}
              </text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </AppFrame>
</template>
<script setup lang="uts">
import UiIcon from '@/components/UiIcon.uvue';
import { latestProgress } from '@/core/events.uts';
import { t as _t } from '@/core/locale.uts';
import { ref, computed } from 'vue';
import AppFrame from '@/components/AppFrame.uvue';
import { reminder, bootstrap } from '@/api/request.uts';
import { SessionState, session as _session, requireSession } from '@/store/session.uts';
import { s as _s, n as _n, message } from '@/core/json.uts';
import { openEvent as _openEvent } from '@/core/ui.uts';
import { statusText as _statusText, displayTime as _displayTime } from '@/core/time.uts';
const session: SessionState = _session;
function t(value: string): string {
  return _t(value);
}
function progressText(item: UTSJSONObject): string {
  return _t(latestProgress(item));
}
function s(row: UTSJSONObject, key: string, fallback: string = ''): string {
  return _s(row, key, fallback);
}
function n(row: UTSJSONObject, key: string): number {
  return _n(row, key);
}
function displayTime(value: string): string {
  return _displayTime(value);
}
function statusText(value: string): string {
  return _statusText(value);
}
function openEvent(id: string): void {
  return _openEvent(id);
}
const type = ref('sent'),
  all = ref(false),
  keyword = ref(''),
  rows = ref<UTSJSONObject[]>([]),
  loading = ref(false),
  refreshing = ref(false),
  refreshComplete = ref(false),
  refreshAngle = ref(0),
  error = ref('');
let ticket = 0,
  timer: number = 0,
  refreshAnimation: number = 0,
  refreshRun = 0,
  loadingRequest = false;
const filtered = computed(() =>
  rows.value.filter((row: UTSJSONObject): boolean =>
    [
      s(row, 'eventSummary'),
      s(row, 'eventNo'),
      s(row, 'creatorName'),
      s(row, 'creatorRealName'),
      s(row, 'latestFact'),
    ]
      .join(' ')
      .toLowerCase()
      .includes(keyword.value.toLowerCase()),
  ),
);
async function load(silent: boolean = false) {
  if (silent && (loadingRequest || refreshing.value)) return;
  const current = ++ticket;
  loadingRequest = true;
  if (!silent) loading.value = true;
  try {
    const response = await reminder('events', null, {
      type: type.value,
      status: all.value ? '' : 'ACTIVE',
    });
    if (current != ticket) return;
    rows.value = (response['value'] as UTSJSONObject[]) ?? [];
    error.value = '';
    void bootstrap().catch(() => {});
  } catch (e) {
    if (current == ticket && !silent) error.value = message(e);
  } finally {
    if (current == ticket) {
      loading.value = false;
      loadingRequest = false;
    }
  }
}
async function refresh() {
  if (refreshing.value) return;
  const run = ++refreshRun,
    start = Date.now();
  refreshing.value = true;
  refreshComplete.value = false;
  refreshAnimation = setInterval(() => {
    refreshAngle.value = (Date.now() - start) * 0.36;
  }, 50);
  try {
    await load();
  } finally {
    const remaining = Math.max(0, 850 - (Date.now() - start));
    await new Promise<void>((resolve) => {
      setTimeout(() => resolve(), remaining);
    });
    if (run == refreshRun) {
      clearInterval(refreshAnimation);
      refreshComplete.value = true;
      await new Promise<void>((resolve) => {
        setTimeout(() => resolve(), 400);
      });
      if (run == refreshRun) refreshing.value = false;
    }
  }
}
function changeType(value: string) {
  type.value = value;
  void load();
}
function stop() {
  ticket++;
  refreshRun++;
  refreshing.value = false;
  loadingRequest = false;
  clearInterval(refreshAnimation);
  clearInterval(timer);
}
onShow(() => {
  if (!requireSession()) return;
  void load();
  timer = setInterval(() => {
    void load(true);
  }, 10000);
});
onHide(stop);
onUnload(stop);
</script>
