}
.status-inactive {
  background-color: #f0f2f7;
}
.dot-inactive {
  background-color: #9ba5b7;
}
.text-inactive {
  color: #8f96a5;
}
.event-number {
  flex: 1;
  min-width: 0;
  font-size: 11px;
  color: #9295a1;
  margin-left: 12px;
  padding-left: 12px;
  border-left: 1px solid #e1e6f0;
}
.event-title {
  font-size: 16px;
  line-height: 25px;
  font-weight: 700;
  color: #182138;
  margin: 12px 0 9px;
}
.people {
  flex-direction: row;
  align-items: center;
}
.progress {
  flex-direction: row;
  align-items: center;
  padding: 11px 10px;
  margin: 13px 0 11px;
  /* #ifdef WEB */
  background-image: linear-gradient(100deg, #f1f3ff, #f7f7fc);
  /* #endif */
  /* #ifndef WEB */
  background-image: linear-gradient(to right, #f1f3ff, #f7f7fc);
  /* #endif */
  border-radius: 12px;
}
.progress-label {
  flex-shrink: 0;
  font-size: 12px;
  font-weight: 600;
  color: #2856e4;
  margin-left: 8px;
  margin-right: 8px;
}
.progress-text {
  flex: 1;
  min-width: 0;
  font-weight: 500;
  lines: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  border-left: 1px solid #ccd5e7;
  padding-left: 9px;
  font-size: 12px;
  line-height: 19px;
  color: #35415c;
}
.event-dates {
  border-top: 1px solid #edf0f6;
  padding-top: 7px;
}
.date-row {
  flex-direction: row;
  align-items: center;
  margin-top: 4px;
}
.muted {
  color: #9699a5;
}
.people .muted {
  margin-left: 9px;
}
.date-row .muted {
  font-size: 12px;
  margin-left: 9px;
}
.refresh-status {
  height: 58px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.refresh-orbit {
  width: 15px;
  height: 15px;
  border: 2px solid #dce6ff;
  border-top-color: #537cff;
  border-radius: 9px;
  margin-right: 8px;
  transition-property: transform;
  transition-duration: 50ms;
  transition-timing-function: linear;
}
.refresh-label {
  color: #7189bc;
  font-size: 12px;
  background-color: #edf3ff;
  border-radius: 15px;
  padding: 7px 18px;
}
</style>
