  flex-direction: row;
  background-color: #e8edf6b3;
  border: 10px solid #ffffff9c;
  border-radius: 20px;
  margin: 0 -5px 14px;
}
.event-tab {
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 40px;
  border-radius: 13px;
}
