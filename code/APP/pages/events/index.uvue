<template>
  <AppFrame
    :loading="loading"
    :title="t('我的事件')"
    :subtitle="t('帮你持续跟进每一件事')"
    tab="events"
  >
    <template #right>
      <view
        class="filter"
        @click="
          all = !all;
          load();
        "
      >
        <UiIcon name="filter" tone="blue" :size="17" />
        <text class="app-font filter-label">{{ all ? t('只看进行中') : t('查看全部') }}</text>
      </view>
    </template>
    <view class="filters">
      <view class="event-tabs">
        <view :class="['event-tab', type == 'sent' ? 'selected' : '']" @click="changeType('sent')">
          <text class="app-font" :class="['tab-text', type == 'sent' ? 'tab-blue' : '']">
            {{ t('我发起的') }}
          </text>
          <text class="app-font" :class="['count', type == 'sent' ? 'count-blue' : '']">
            {{ n(session.summary, 'sentActiveEventCount') }}
          </text>
          <view v-if="type == 'sent'" class="underline" />
        </view>
        <view
          :class="['event-tab', type == 'received' ? 'selected' : '']"
          @click="changeType('received')"
        >
          <text class="app-font" :class="['tab-text', type == 'received' ? 'tab-blue' : '']">
            {{ t('我收到的') }}
          </text>
          <text class="app-font" :class="['count', type == 'received' ? 'count-blue' : '']">
            {{ n(session.summary, 'receivedActiveEventCount') }}
          </text>
          <view v-if="type == 'received'" class="underline" />
        </view>
      </view>
      <view class="search-box">
        <UiIcon name="search" :size="22" />
        <input
          class="app-font search-input"
          v-model="keyword"
          :placeholder="t('搜索事件内容、编号或发起人')"
        />
      </view>
    </view>
    <swiper
      class="event-pager"
      :current="type == 'sent' ? 0 : 1"
      :duration="260"
      @change="pageChanged"
    >
      <swiper-item class="event-page">
        <EventList
          type="sent"
          :rows="filteredSent"
          :loading="loading"
          :error="sentError"
          :refreshing="refreshing && refreshType == 'sent'"
          :refresh-complete="refreshComplete"
          :refresh-angle="refreshAngle"
          @refresh="refresh('sent')"
          @retry="load()"
        />
      </swiper-item>
      <swiper-item class="event-page">
        <EventList
          type="received"
          :rows="filteredReceived"
          :loading="loading"
          :error="receivedError"
          :refreshing="refreshing && refreshType == 'received'"
          :refresh-complete="refreshComplete"
          :refresh-angle="refreshAngle"
          @refresh="refresh('received')"
          @retry="load()"
        />
      </swiper-item>
    </swiper>
  </AppFrame>
</template>
<script setup lang="uts">
import { ref, computed } from 'vue';
import UiIcon from '@/components/UiIcon.uvue';
import EventList from '@/components/EventList.uvue';
import AppFrame from '@/components/AppFrame.uvue';
import { t as _t } from '@/core/locale.uts';
import { reminder, bootstrap } from '@/api/request.uts';
import { SessionState, session as _session, requireSession } from '@/store/session.uts';
import { s as _s, n as _n, message } from '@/core/json.uts';
const session: SessionState = _session;
function t(value: string): string {
  return _t(value);
}
function n(row: UTSJSONObject, key: string): number {
  return _n(row, key);
}
const type = ref('sent'),
  all = ref(false),
  keyword = ref('');
const sentRows = ref<UTSJSONObject[]>([]),
  receivedRows = ref<UTSJSONObject[]>([]);
const sentError = ref(''),
  receivedError = ref('');
const loading = ref(false),
  refreshing = ref(false),
  refreshType = ref('sent');
const refreshComplete = ref(false),
  refreshAngle = ref(0);
let ticket = 0,
  timer: number = 0,
  refreshAnimation: number = 0,
  refreshRun = 0;
let loadingRequest = false,
  loaded = false,
  owner = '';
function matches(row: UTSJSONObject): boolean {
  return ['eventSummary', 'eventNo', 'creatorName', 'creatorRealName', 'latestFact']
    .map((key: string): string => _s(row, key))
    .join(' ')
    .toLowerCase()
    .includes(keyword.value.toLowerCase());
}
const filteredSent = computed((): UTSJSONObject[] => sentRows.value.filter(matches));
const filteredReceived = computed((): UTSJSONObject[] => receivedRows.value.filter(matches));
async function loadKind(kind: string, status: string, current: number, requestOwner: string) {
  try {
    const response = await reminder('events', null, { type: kind, status: status });
    if (current != ticket || requestOwner != session.userId) return;
    const value = (response['value'] as UTSJSONObject[]) ?? [];
    if (kind == 'sent') {
      sentRows.value = value;
      sentError.value = '';
    } else {
      receivedRows.value = value;
      receivedError.value = '';
    }
  } catch (e) {
    if (current != ticket || requestOwner != session.userId) return;
    if (kind == 'sent') sentError.value = message(e);
    else receivedError.value = message(e);
  }
}
async function load(silent: boolean = false) {
  if (silent && (loadingRequest || refreshing.value)) return;
  const current = ++ticket,
    requestOwner = session.userId,
    status = all.value ? '' : 'ACTIVE';
  loadingRequest = true;
  // Keep both lists mounted, including their scroll positions. A tab switch performs no I/O.
  if (!silent && !loaded) loading.value = true;
  try {
    await Promise.all([
      loadKind('sent', status, current, requestOwner),
      loadKind('received', status, current, requestOwner),
    ]);
    if (current == ticket && requestOwner == session.userId) {
      loaded = true;
      void bootstrap().catch(() => {});
    }
  } finally {
    if (current == ticket) {
      loading.value = false;
      loadingRequest = false;
    }
  }
}
async function refresh(kind: string) {
  if (refreshing.value) return;
  const run = ++refreshRun,
    start = Date.now();
  refreshType.value = kind;
  refreshing.value = true;
  refreshComplete.value = false;
  refreshAnimation = setInterval(() => {
    refreshAngle.value = (Date.now() - start) * 0.36;
  }, 50);
  try {
    await load();
  } finally {
    await new Promise<void>((resolve) => {
      setTimeout(() => resolve(), Math.max(0, 650 - (Date.now() - start)));
    });
    if (run == refreshRun) {
      clearInterval(refreshAnimation);
      refreshComplete.value = true;
      await new Promise<void>((resolve) => {
        setTimeout(() => resolve(), 300);
      });
      if (run == refreshRun) refreshing.value = false;
    }
  }
}
function changeType(value: string) {
  type.value = value;
}
function pageChanged(e: UniSwiperChangeEvent): void {
  type.value = e.detail.current == 0 ? 'sent' : 'received';
}
function stop() {
  ticket++;
  refreshRun++;
  refreshing.value = false;
  loading.value = false;
  loadingRequest = false;
  clearInterval(refreshAnimation);
  clearInterval(timer);
}
onShow(() => {
  if (!requireSession()) return;
  if (owner != session.userId) {
    owner = session.userId;
    loaded = false;
    type.value = 'sent';
    keyword.value = '';
    all.value = false;
    sentRows.value = [];
    receivedRows.value = [];
    sentError.value = '';
    receivedError.value = '';
  }
  clearInterval(timer);
  void load();
  timer = setInterval(() => {
    void load(true);
  }, 10000);
});
onHide(stop);
onUnload(stop);
</script>
<style scoped>
.event-pager {
  flex: 1;
  height: 0;
  min-height: 0;
}
.event-page {
  height: 100%;
}
.filters {
  padding: 0 16px;
}
.filter {
  flex-direction: row;
  align-items: center;
  padding: 9px 13px;
  border-radius: 24px;
  background-color: #ffffffd9;
}
.filter-label {
  font-size: 12px;
  font-weight: 700;
  color: #1a286b;
  margin-left: 5px;
}
.event-tabs {
  flex-direction: row;
  background-color: #e8edf6b3;
  border: 10px solid #ffffff9c;
  border-radius: 20px;
  margin: 0 -5px 14px;
}
.event-tab {
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 40px;
  border-radius: 13px;
}
.tab-text {
  font-size: 15px;
  font-weight: 700;
  color: #7a8396;
}
.tab-blue {
  color: #315bff;
}
.count {
  font-size: 12px;
  line-height: 21px;
  min-width: 21px;
  height: 21px;
  text-align: center;
  margin-left: 5px;
  border-radius: 11px;
  background-color: #e1e7f2;
  color: #818b9e;
}
.count-blue {
  background-color: #315bff;
  color: #ffffff;
}
.underline {
  position: absolute;
  bottom: -1px;
  width: 38px;
  height: 3px;
  border-radius: 3px;
  /* #ifdef WEB */
  background-image: linear-gradient(90deg, #79a0ff, #3548ee);
  /* #endif */
  /* #ifndef WEB */
  background-image: linear-gradient(to right, #79a0ff, #3548ee);
  /* #endif */
}
.search-box {
  height: 44px;
  flex-direction: row;
  align-items: center;
  background-color: #ffffffec;
  border-radius: 20px;
  padding: 0 15px;
  margin-bottom: 12px;
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  margin-left: 16px;
  color: #35415c;
}
</style>
