  color: #315bff;
}
.count {
  font-size: 12px;
  line-height: 21px;
  min-width: 21px;
  height: 21px;
  text-align: center;
  margin-left: 5px;
  border-radius: 11px;
  background-color: #e1e7f2;
  color: #818b9e;
}
.count-blue {
  background-color: #315bff;
  color: #ffffff;
}
.underline {
  position: absolute;
  bottom: -1px;
  width: 38px;
  height: 3px;
  border-radius: 3px;
  /* #ifdef WEB */
  background-image: linear-gradient(90deg, #79a0ff, #3548ee);
  /* #endif */
  /* #ifndef WEB */
  background-image: linear-gradient(to right, #79a0ff, #3548ee);
  /* #endif */
}
.search-box {
  height: 44px;
  flex-direction: row;
  align-items: center;
  background-color: #ffffffec;
  border-radius: 20px;
  padding: 0 15px;
  margin-bottom: 12px;
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  margin-left: 16px;
  color: #35415c;
}
.padded {
  padding: 0 17px 4px;
}
.event-card {
  padding: 16px 17px 18px;
  border-radius: 22px;
  margin-bottom: 13px;
}
.event-top {
  flex-direction: row;
  align-items: center;
}
.status {
  flex-direction: row;
  align-items: center;
  padding: 5px 9px;
