<template>
  <scroll-view :scroll-y="true" :show-scrollbar="false" class="login">
    <view class="canvas" :class="{ compact: compact }" :style="{ minHeight: viewportHeight + 'px' }">
      <image class="login-bg" src="/static/images/login-background.png" mode="widthFix" />
      <view class="language-switch" :style="{ top: (top + 12) + 'px' }" role="button" :aria-label="t('切换语言')" @click="languageOpen = true">
        <UiIcon name="globe" tone="blue" :size="16" />
        <text class="app-font language-label">{{ session.language == 'en-us' ? 'English' : '简体中文' }}</text>
        <view class="language-chevron"><UiIcon name="down" tone="blue" :size="16" /></view>
      </view>
      <view class="brand" :style="{ marginTop: top + 'px', height: heroHeight + 'px' }">
        <view class="brand-line">
          <image class="brand-icon" src="/static/avatars/assistant/A3.png" mode="aspectFit" />
          <text class="app-font brand-title">{{ t('AI小醒') }}</text>
        </view>
        <text class="app-font tagline">{{ t('理解你的计划，') }}</text>
        <text class="app-font tagline tagline-second">{{ t('在合适的时候重新判断') }}</text>
      </view>
      <view
        class="login-panel"
        :style="{
          opacity: entered ? 1 : 0,
          transform: entered ? 'none' : 'translateY(12px)',
        }"
      >
        <view class="login-modes">
          <view class="mode-surface" :class="{ 'email-surface': codeMode }">
            <view class="mode-white" />
            <view class="mode-curve"><view class="mode-curve-cutout" /></view>
            <view class="mode-body-corner"><view class="mode-body-white" /></view>
          </view>
          <view class="mode" role="button" :aria-label="t('账号登录')" @click="switchMode(false)">
            <text class="app-font mode-label" :class="{ active: !codeMode }">{{ t('账号登录') }}</text>
            <view v-if="!codeMode" class="mode-indicator" />
          </view>
          <view class="mode" role="button" :aria-label="t('邮箱登录')" @click="switchMode(true)">
            <text class="app-font mode-label" :class="{ active: codeMode }">{{ t('邮箱登录') }}</text>
            <view v-if="codeMode" class="mode-indicator" />
          </view>
        </view>
        <view class="login-body">
        <view class="login-fields" :style="{ opacity: modeLeaving ? 0 : 1, transform: modeLeaving ? 'translateY(5px)' : 'translateY(0px)' }">
        <text class="app-font label">{{ t(codeMode ? '邮箱' : '账号 / 邮箱') }}</text>
        <view class="login-input">
          <UiIcon name="user" tone="purple" :size="19" />
          <input
            class="app-font field"
            v-model="account"
            :placeholder="t(codeMode ? '请输入邮箱' : '请输入账号或邮箱')"
            :disabled="busy"
          />
        </view>
        <view v-if="!codeMode">
          <text class="app-font label password-label">{{ t('密码') }}</text>
          <view class="login-input">
            <UiIcon name="lock" tone="purple" :size="19" />
            <input
              class="app-font field"
              v-model="password"
              :password="!show"
              :placeholder="t('请输入密码')"
              :disabled="busy"
              @confirm="submit()"
            />
            <view class="eye" @click="show = !show">
              <UiIcon :name="show ? 'eye' : 'eyeOff'" tone="purple" :size="20" />
            </view>
          </view>
        </view>
        <view v-else class="code-section">
          <EmailCodeField v-model="emailCode" :email="account" :disabled="busy" />
        </view>
        <view v-if="captchaEnabled && !codeMode" class="row">
          <input
            class="app-font input"
            v-model="captchaCode"
            :placeholder="t('验证码')"
            :maxlength="8"
          />
          <image :src="captchaImage" style="width: 110px; height: 42px" @click="refreshCaptcha()" />
        </view>
        </view>
        <text class="app-font forgot" @click="forgot()">{{ t('忘记密码？') }}</text>

        <LegalConsent v-model="accepted" :open="consentOpen" :disabled="busy" :confirm-label="t('同意并登录')" @cancel="consentOpen = false" @confirm="agreeAndLogin" />
        <LoginButton
          :busy="busy"
          :label="t('登录')"
          :busy-label="t('正在登录…')"
          @click="submit()"
        />
        <text class="app-font register" @click="openRegister">
          {{ t('没有账号？注册账号') }}
        </text>
        </view>
      </view>
      <text class="app-font slogan">{{ t('更智能的提醒\u3000·\u3000更从容的生活') }}</text>
    </view>
  </scroll-view>
  <Popup :open="languageOpen" :title="t('切换语言')" @close="languageOpen = false">
    <view v-for="(mode,index) in languageModes" :key="mode" class="language-option" :class="{ 'language-selected': session.languageMode == mode }" @click="chooseLanguage(mode)">
      <text class="app-font language-option-label">{{ index == 0 ? t('跟随系统') : index == 1 ? '中文' : 'English' }}</text>
      <text v-if="session.languageMode == mode" class="app-font language-check">✓</text>
    </view>
  </Popup>
  <Popup :open="confirmOpen" :title="t('确认在此设备登录？')" :busy="busy" @close="cancelLogin">
    <text class="app-font dialog-copy">{{ t('账号已在其他设备登录，继续将退出其他设备。') }}</text>

    <view class="dialog-actions">
      <view class="dialog-continue dialog-cancel-wrap">
        <LoginButton :secondary="true" :label="t('取消')" @click="cancelLogin()" />
      </view>
      <view class="dialog-continue">
        <LoginButton
          :busy="busy"
          :label="t('继续登录')"
          :busy-label="t('正在登录…')"
          @click="continueLogin()"
        />
      </view>
    </view>
  </Popup>
  <TopTip />
</template>
<script setup lang="uts">
import { updates } from '@/services/updates.uts';
import { startupReady } from '@/store/startup.uts';
import LegalConsent from '@/components/LegalConsent.uvue';
import { LEGAL_VERSION } from '@/core/legal.uts';
import { loginLayout } from '@/core/login-layout.uts';
import TopTip from '@/components/TopTip.uvue';
import UiIcon from '@/components/UiIcon.uvue';
import { t as _t } from '@/core/locale.uts';
import { ref, computed, nextTick, onUnmounted } from 'vue';
import LoginButton from '@/components/LoginButton.uvue';
import EmailCodeField from '@/components/EmailCodeField.uvue';
import { login, emailLogin, post, ApiError } from '@/api/request.uts';
import Popup from '@/components/Popup.uvue';
import { hasSession, session, setLanguageMode } from '@/store/session.uts';
import { syncPush } from '@/services/native.uts';
import { message, s, obj } from '@/core/json.uts';
import { toast } from '@/core/ui.uts';
function t(value: string): string {
  return _t(value);
}
const languageOpen = ref(false);
const languageModes: string[] = ['system', 'zh-cn', 'en-us'];
function chooseLanguage(mode: string) {
  setLanguageMode(mode);
  languageOpen.value = false;
}
onHide(() => { languageOpen.value = false; });
const codeMode = ref(false),
  emailCode = ref('');
function openRegister() {
  uni.navigateTo({ url: '/pages/register/index' });
}
const entered = ref(false);
let entryTimer: number = 0;
const accepted = ref(false), consentOpen = ref(false), modeLeaving = ref(false);
let modeTimer: number = 0;
onUnmounted(() => { clearTimeout(entryTimer); clearTimeout(modeTimer); });

const windowInfo = uni.getWindowInfo();
const top = windowInfo.statusBarHeight;
const viewportHeight = ref(windowInfo.windowHeight);
const viewportWidth = ref(windowInfo.windowWidth);
onResize(() => {
  const next = uni.getWindowInfo();
  // Keyboard resize should scroll the form, not repeatedly resize the illustration.
  if (next.windowWidth != viewportWidth.value) {
    viewportWidth.value = next.windowWidth; viewportHeight.value = next.windowHeight;
  }
});
const compact = computed((): boolean => viewportHeight.value < 740);

const account = ref((uni.getStorageSync('last-account') as string | null) ?? ''),
  password = ref(''),
  show = ref(false),
  busy = ref(false),
  register = ref(false),
  error = ref('');
const forgotOpen = ref(false),
  confirmOpen = ref(false),
  pendingAccount = ref(''),
  confirmError = ref('');
let pendingPassword = '';
function switchMode(value: boolean) {
  if (busy.value || modeLeaving.value || codeMode.value == value) return;
  modeLeaving.value = true;
  clearTimeout(modeTimer);
  modeTimer = setTimeout(() => {
    codeMode.value = value;
    error.value = '';
    modeLeaving.value = false;
  }, 130);
}

function cancelLogin() {
  if (busy.value) return;
  confirmOpen.value = false;
  pendingAccount.value = '';
  pendingPassword = '';
  confirmError.value = '';
}
const captchaEnabled = ref(false),
  captchaKey = ref(''),
  captchaImage = ref(''),
  captchaCode = ref('');
const heroHeight = computed((): number => loginLayout(viewportWidth.value, viewportHeight.value, top, captchaEnabled.value && !codeMode.value));

async function refreshCaptcha() {
  captchaCode.value = '';
  try {
    const data = obj(await post('/blade-auth/oauth/captcha', null, {}, 15000, false), 'data');
    captchaKey.value = s(data, 'key');
    captchaImage.value = s(data, 'image');
  } catch (e) {
    error.value = message(e);
  }
}
async function loadCaptchaMode() {
  try {
    const data = obj(
      await post('/blade-system/param/login-page-param', null, {}, 15000, false),
      'data',
    );
    captchaEnabled.value = s(data, 'chekcode') == 'true';
    if (captchaEnabled.value) await refreshCaptcha();
  } catch (_) {
    error.value = t('无法读取登录配置，请检查网络后重试');
  }
}
async function submit(confirmed: boolean = false) {
  if (busy.value || modeLeaving.value) return;
  if (account.value.trim().length == 0 || (!codeMode.value && password.value.length == 0)) {
    error.value = codeMode.value ? '请输入邮箱' : '请输入账号或邮箱和密码';
    toast(error.value);
    return;
  }
  if (
    !codeMode.value &&
    captchaEnabled.value &&
    (captchaCode.value.trim().length == 0 || captchaKey.value.length == 0)
  ) {
    error.value = t('请输入验证码');
    toast(error.value);
    return;
  }
  if (
    codeMode.value &&
    (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(account.value.trim()) ||
      !/^[0-9]{6}$/.test(emailCode.value))
  ) {
    toast('请输入正确的邮箱和6位验证码');
    return;
  }
  if (!accepted.value) { consentOpen.value = true; return; }
  busy.value = true;
  error.value = '';
  try {
    uni.setStorageSync('xiaoxing:legal-consent', { version: LEGAL_VERSION, acceptedAt: Date.now(), account: account.value.trim() });
    await nextTick();
    await new Promise<void>((resolve) => {
      setTimeout(() => resolve(), 32);
    });
    if (codeMode.value) await emailLogin(account.value.trim(), emailCode.value, confirmed);
    else
      await login(
        account.value.trim(),
        password.value,
        captchaEnabled.value ? captchaKey.value : '',
        captchaCode.value.trim(),
        confirmed,
      );
    uni.setStorageSync('last-account', account.value.trim());
    password.value = '';
    emailCode.value = '';
    confirmOpen.value = false;
    pendingAccount.value = '';
    pendingPassword = '';
    void syncPush(true);
    await new Promise<void>((resolve, reject) => {
      uni.reLaunch({
        url: '/pages/chat/index',
        success: () => {
          toast('登录成功');
          resolve();
        },
        fail: () => reject(new Error('登录成功，但页面打开失败，请重新进入应用')),
      });
    });
  } catch (e) {
    if (e instanceof ApiError && e.status == 601 && !confirmed) {
      pendingAccount.value = account.value.trim();
      pendingPassword = codeMode.value ? emailCode.value : password.value;
      confirmError.value = '';
      confirmOpen.value = true;
      return;
    }
    toast(message(e));
    if (confirmed) confirmError.value = message(e);
    else error.value = message(e);
    if (captchaEnabled.value) await refreshCaptcha();
  } finally {
    busy.value = false;
  }
}
function agreeAndLogin() {
  if (!consentOpen.value || busy.value) return;
  consentOpen.value = false;
  accepted.value = true;
  void submit();
}
async function continueLogin() {
  if (
    account.value.trim() != pendingAccount.value ||
    (codeMode.value ? emailCode.value : password.value) != pendingPassword
  ) {
    cancelLogin();
    return;
  }
  await submit(true);
}
function forgot() {
  uni.navigateTo({ url: '/pages/reset-password/index' });
}
function registered(value: string, registeredPassword: string) {
  account.value = value;
  password.value = registeredPassword;
  toast('注册成功，正在登录…');
  void submit();
}
onReady(() => {
  entryTimer = setTimeout(() => {
    entered.value = true;
    startupReady();
  }, 30);
  if (hasSession()) {
    uni.reLaunch({ url: '/pages/chat/index' });
    return;
  }
  void loadCaptchaMode();
});
// #ifdef APP-ANDROID
onBackPress((): boolean => updates.required && updates.available);
// #endif
</script>
<style scoped>
.login { flex: 1; height: 100%; background-color: #f5f9ff; }
.canvas { position: relative; width: 100%; max-width: 560px; align-self: center; padding-bottom: 12px; }
.login-bg { position: absolute; left: 0; top: 0; width: 100%; }
.language-switch { position: absolute; right: 20px; z-index: 2; flex-direction: row; align-items: center; justify-content: center; padding: 0 14px; height: 34px; border-radius: 18px; border: 1px solid #ffffff99; background-color: #ffffffeb; }
.language-label { font-size: 13px; line-height: 20px; color: #355aab; margin-left: 7px; }
.language-chevron { width: 20px; height: 20px; margin-left: 6px; align-items: center; justify-content: center; }
.language-option { flex-direction: row; align-items: center; justify-content: space-between; padding: 15px 16px; margin-bottom: 8px; border-radius: 14px; background-color: #f6f8fc; }
.language-selected { background-color: #edf2ff; }
.language-option-label { font-size: 16px; color: #354563; }
.language-check { font-size: 17px; font-weight: 600; color: #5269ed; }

.brand { padding: 65px 30px 0; }
.brand-line { flex-direction: row; align-items: center; }
.brand-icon { width: 54px; height: 54px; border-radius: 15px; }
.brand-title { font-size: 30px; font-weight: 700; color: #ffffff; margin-left: 14px; }
.tagline { font-size: 15px; line-height: 24px; color: #ffffff; margin-top: 15px; }
.tagline-second { margin-top: 0; }
.login-panel { transition-property: opacity, transform; transition-duration: 240ms; transition-timing-function: ease-out; margin: 0 4px; background-color: #ffffff; border: 1px solid #ffffff; border-radius: 28px; }
.login-body { padding: 22px 28px 20px; }
.login-modes { position: relative; height: 56px; flex-shrink: 0; flex-direction: row; background-color: #eef0fb; border-top-left-radius: 27px; border-top-right-radius: 27px; overflow: visible; }
.mode-surface { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: visible; }
.email-surface { transform: scaleX(-1); }
.mode-white { position: absolute; left: 0; top: 0; bottom: 0; width: 50%; background-color: #ffffff; border-top-left-radius: 27px; border-top-right-radius: 28px; }
.mode-curve { position: absolute; left: 50%; bottom: 0; width: 28px; height: 28px; background-color: #ffffff; }
.mode-curve-cutout { width: 28px; height: 28px; background-color: #eef0fb; border-bottom-left-radius: 28px; }
.mode-body-corner { position: absolute; right: 0; bottom: -22px; width: 22px; height: 22px; background-color: #eef0fb; }
.mode-body-white { width: 22px; height: 22px; background-color: #ffffff; border-top-right-radius: 22px; }
.mode { position: relative; flex: 1; align-items: center; padding-top: 15px; }
.mode-label { font-size: 17px; line-height: 24px; font-weight: 600; color: #69739c; }
.active { color: #111b50; font-weight: 700; }
.mode-indicator { position: absolute; bottom: 8px; width: 22px; height: 5px; border-radius: 3px; background-color: #167aff; background-image: linear-gradient(to right, #0756ff, #23b4ff); }
.login-fields { transition-property: opacity, transform; transition-duration: 130ms; transition-timing-function: ease-out; }
.label { font-size: 14px; font-weight: 600; margin-bottom: 8px; color: #293956; }
.login-input { height: 48px; flex-direction: row; align-items: center; border: 1px solid #dce5f4; background-color: #f5f8fe; border-radius: 12px; padding: 0 14px; }
.field { flex: 1; min-width: 0; font-size: 15px; margin-left: 12px; color: #252e4c; }
.password-label { margin-top: 18px; }
.eye { padding: 10px 0 10px 10px; }
.code-section { margin-top: 18px; min-height: 76px; }
.forgot { text-align: right; color: #2368e8; font-size: 13px; padding: 12px 0 8px; line-height: 20px; }
.register { text-align: center; font-size: 13px; color: #4264e9; margin-top: 12px; padding: 8px 0; }
.slogan { text-align: center; font-size: 11px; color: #8492ae; padding: 16px 8px 8px; letter-spacing: 1px; }
.compact .brand { padding-top: 40px; }
.compact .brand-icon { width: 44px; height: 44px; border-radius: 12px; }
.compact .brand-title { font-size: 27px; }
.compact .tagline { font-size: 13px; line-height: 20px; margin-top: 10px; }
.compact .tagline-second { margin-top: 0; }
.compact .login-body { padding: 6px 24px 10px; }
.compact .login-modes { height: 52px; }
.compact .mode { padding-top: 12px; }
.compact .mode-label { font-size: 16px; }
.compact .login-input { height: 42px; }
.compact .code-section { margin-top: 12px; min-height: 66px; }
.compact .password-label { margin-top: 12px; }
.compact .forgot { padding: 6px 0 4px; }
.compact .register { margin-top: 0; }
.compact .slogan { padding-top: 10px; }
.dialog-copy {
  margin: 8px 0 22px;
  font-size: 14px;
  line-height: 24px;
  color: #6f7c91;
}
.dialog-actions {
  flex-direction: row;
  align-items: stretch;
}
.dialog-cancel {
  padding: 0;
  height: 48px;
  line-height: 48px;
  font-size: 18px;
  font-weight: 600;
  flex: 1;
  margin: 0 10px 0 0;
}
.dialog-primary {
  height: 44px;
  line-height: 44px;
  letter-spacing: 0;
  font-size: 16px;
  box-shadow: none;
}
.dialog-continue {
  height: 48px;
  flex: 1;
  width: 0;
  min-width: 0;
}
.dialog-cancel-wrap {
  margin-right: 10px;
}

/* #ifdef WEB */
@media (prefers-reduced-motion: reduce) { .login-fields, .login-panel { transition: none; } }
/* #endif */
</style>
