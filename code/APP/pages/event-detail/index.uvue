  margin-bottom: 11px;
}
.branch-conversation {
  padding: 7px 10px;
  background-color: #eff2ff;
  border-radius: 16px;
  font-size: 12px;
  font-weight: 600;
  color: #4264e9;
  margin-left: 6px;
}
.branch .body-text {
  font-size: 14px;
