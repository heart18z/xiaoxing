  padding: 0 0 0 7px;
}
.node-track {
  width: 26px;
  align-items: flex-start;
}
.node-line {
  position: absolute;
  width: 2px;
  top: 11px;
  bottom: -4px;
  left: 5px;
  background-color: #c4dbf5;
}
.line-ai {
  background-color: #d4c9ed;
}
.node-dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
  border: 3px solid #4262f2;
  background-color: #ffffff;
  margin-top: 3px;
}
.dot-ai {
  border-color: #8c63db;
}
.node-content {
  flex: 1;
