<template>
  <AppFrame
    :title="t('AI小醒')"
    :subtitle="t('智能提醒助手')"
    tab="chat"
    theme="chat"
    :keyboard-height="keyboard"
  >
    <template #left>
      <view class="toolbar" @click="drawer = true">
        <UiIcon name="menu" tone="ink" :size="20" />
      </view>
    </template>
    <template #right>
      <view class="toolbar" @click="requestClear()">
        <UiIcon name="eraser" tone="ink" :size="20" />
      </view>
    </template>
    <view v-if="chat.notice.length > 0 && s(chat.pending, 'requestId').length > 0" class="recovery">
      <text class="app-font error">{{ chat.notice }}</text>
      <view v-if="!chat.busy" class="row">
        <text class="app-font link" @click="resume()">{{ t('重新查询') }}</text>
        <text class="app-font link" @click="drawer = true">{{ t('核对事件') }}</text>
        <text v-if="!chat.busy" class="app-font link" @click="dismiss()">{{ t('结束等待') }}</text>
      </view>
    </view>
    <scroll-view
      :scroll-y="true"
      id="chat-scroll"
      class="scroll"
      :scroll-top="scrollTop"
      :scroll-with-animation="scrollAnimated"
      @scroll="scrolling"
      @touchstart="touchStarted()"
      @touchmove="touchMoved()"
      @touchend="touchEnded()"
      @touchcancel="touchEnded()"
    >
      <view id="chat-messages" class="messages">
        <view v-if="chat.loading" class="card">
          <text class="app-font muted">{{ t('正在加载对话记录…') }}</text>
        </view>
        <view v-if="chat.error.length > 0" class="card">
          <text class="app-font error">{{ chat.error }}</text>
          <button class="app-font secondary" @click="loadHistory()">{{ t('重新加载') }}</button>
        </view>
        <view
          v-if="
            !chat.loading &&
            chat.error.length == 0 &&
            chat.messages.length == 0 &&
            s(chat.pending, 'requestId').length == 0
          "
          class="card"
        >
          <text class="app-font heading">{{ t('今天想提醒什么？') }}</text>
          <text class="app-font body-text">
            {{ t('例如：“明天上午10点前提醒我确认合同，如果已完成就不要提醒。”') }}
          </text>
        </view>
        <ChatMessage
          v-for="item in displayedMessages"
          :key="rowKey(item)"
          :item="item"
          :busy="confirming == s(payload(item), 'candidateId')"
          @layout="scrollLatest"
          @reveal="revealThinking"
          @confirm="confirmCandidate"
        />
        <view id="latest" style="height: 12px" />
      </view>
    </scroll-view>
    <view v-if="!follow" class="latest-link" @click="jumpLatest()">
      <view style="transform: rotate(180deg)">
        <UiIcon name="arrowUp" tone="purple" :size="18" />
      </view>
      <text class="app-font latest-text">{{ t('回到最新') }}</text>
    </view>
    <view class="composer" :style="{ marginBottom: keyboard > 0 ? '0px' : '10px' }">
      <scroll-view v-if="files.length > 0" :scroll-x="true" class="file-strip">
        <view class="row">
          <view v-for="file in files" :key="file.key" class="file">
            <image v-if="file.image" :src="file.path" class="file-image" />
            <text class="app-font muted">
              {{ file.name }} ·
              {{
                file.state == 'loading'
                  ? t('解析中')
                  : file.state == 'ready'
                    ? t('已就绪')
                    : t('失败')
              }}
            </text>
            <text class="app-font link" v-if="file.state == 'error'" @click="uploadOne(file)">
              {{ t('重试') }}
            </text>
            <text class="app-font link" @click="removeFile(file.key)">×</text>
          </view>
        </view>
      </scroll-view>
      <view class="composer-box">
        <view class="input-row">
          <image class="orb" src="/static/icons/input-orb.png" mode="aspectFit" />
          <text v-if="recording || transcribing" class="app-font voice-draft">
            {{ draft.length > 0 ? draft : t('说说你想提醒的事…') }}
          </text>
          <textarea
            v-else
            id="chat-compose-input"
            class="app-font compose-input"
            :confirm-type="inputConfirmType"
            @confirm="confirmSend"
            :value="inputValue"
            @input="composerInput"
            :auto-height="true"
            :maxlength="20000"
            :disabled="recording || transcribing"
            :placeholder="t('说说你想提醒的事…')"
            :adjust-position="false"
            @keyboardheightchange="inputKeyboardChange"
            @focus="
              follow = true;
              scrollLatest();
            "
          />
        </view>
        <VoiceInputStatus
          v-if="recording || transcribing"
          :recording="recording"
          :level="voiceLevel"
          :live="liveSpeech"
          :stage="voiceStage"
          @confirm="finishRecording()"
          @cancel="cancelRecording()"
        />
        <view class="between">
          <view class="row">
            <view class="compose-action" @click="chooseAttachment()">
              <UiIcon name="plus" tone="purple" :size="24" />
            </view>
            <view class="compose-action" @click="startRecording()">
              <UiIcon name="microphone" tone="purple" :size="24" />
            </view>
          </view>
          <view
            role="button"
            aria-label="停止生成"
            v-if="chat.busy"
            class="send send-busy"
            @click="stopGeneration()"
          >
            <view class="stop-symbol" />
          </view>
          <view role="button" aria-label="发送" v-else class="send" @click="send()">
            <UiIcon name="arrowUp" tone="purple" :size="24" />
          </view>
        </view>
      </view>
    </view>
  </AppFrame>
  <ReminderDrawer :open="drawer" @close="drawer = false" />

  <Popup :open="clearOpen" :title="t('清除当前上下文')" :busy="clearing" @close="clearOpen = false">
    <text class="app-font clear-copy">
      {{ t('清除后，对话页将不再显示之前的消息，AI 也不再沿用此前的聊天上下文和未确认操作。') }}
    </text>
    <view class="clear-note">
      <text class="app-font muted">
        {{ t('后台聊天记录仍保留，好友、人员别称和已创建事件不受影响，提醒继续执行。') }}
      </text>
    </view>
    <view class="clear-actions">
      <button
        class="app-font secondary clear-cancel"
        :disabled="clearing"
        @click="clearOpen = false"
      >
        {{ t('取消') }}
      </button>
      <button
        class="app-font primary"
        :loading="clearing"
        :disabled="clearing"
        @click="clearContext()"
      >
        {{ t('确认清除') }}
      </button>
    </view>
  </Popup>
</template>
<script setup lang="uts">
import { messageKey } from '@/core/messages.uts';
import { pickImages } from '@/services/images.uts';
import UiIcon from '@/components/UiIcon.uvue';
import VoiceInputStatus from '@/components/VoiceInputStatus.uvue';
import { t as _t } from '@/core/locale.uts';
import { onMounted, onUnmounted, ref, reactive, watch, nextTick, computed } from 'vue';
import AppFrame from '@/components/AppFrame.uvue';
import ChatMessage from '@/components/ChatMessage.uvue';
import ReminderDrawer from '@/components/ReminderDrawer.uvue';
import Popup from '@/components/Popup.uvue';
import {
  setChatVisible,
  syncHistory,
  invalidateHistory,
  savedPending,
  ChatState,
  chat as _chat,
  loadHistory as _loadHistory,
  resume as _resume,
  submit,
  pauseChat,
  stopGeneration as _stopGeneration,
  dismissPending,
} from '@/services/chat.uts';
import { session, requireSession, requestId } from '@/store/session.uts';
import { reminder, upload, bootstrap } from '@/api/request.uts';
import { callNative, setAlarm } from '@/services/native.uts';
import { s as _s, b, obj, arr, payload as _payload, strings, message } from '@/core/json.uts';
import { confirm, toast } from '@/core/ui.uts';
import { markdown as _markdown } from '@/core/markdown.uts';
// #ifdef WEB
import {
  uploadBrowserFile,
  chooseBrowserFiles,
  startBrowserRecording,
  finishBrowserRecording,
  cancelBrowserRecording,
} from '@/services/browser-chat.uts';
const browserFiles = new Map<string, File>();
// #endif
function loadHistory(): Promise<void> {
  return _loadHistory();
}

const chat: ChatState = _chat;
const clearOpen = ref(false),
  clearing = ref(false);
function t(value: string): string {
  return _t(value);
}
function s(row: UTSJSONObject, key: string, fallback: string = ''): string {
  return _s(row, key, fallback);
}
function payload(row: UTSJSONObject): UTSJSONObject {
  return _payload(row);
}
function markdown(value: string): string {
  return _markdown(value);
}
const pendingUser = computed((): UTSJSONObject => ({
  id: 'pending-user-' + s(chat.pending, 'requestId'),
  _renderKey: 'live-user-' + s(chat.pending, 'requestId'),
  messageRole: 'user',
  messageType: 'TEXT',
  content: s(chat.pending, 'content'),
  payload: { fileNames: chat.pending['fileNames'] ?? ([] as string[]) },
}));
const pendingAssistant = computed((): UTSJSONObject => ({
  id: 'pending-ai-' + s(chat.pending, 'requestId'),
  _renderKey: 'live-ai-' + s(chat.pending, 'requestId'),
  messageRole: 'assistant',
  messageType: 'TEXT',
  content: chat.reply,
  reasoningContent: chat.reasoning,
  streaming: chat.busy,
}));
const displayedMessages = computed((): UTSJSONObject[] => s(chat.pending, 'requestId').length > 0
  ? chat.messages.concat([pendingUser.value, pendingAssistant.value]) : chat.messages);

type Attachment = {
  key: string;
  path: string;
  name: string;
  image: boolean;
  state: string;
  id: string;
};
const drawer = ref(false),
  draft = ref(''),
  inputValue = ref(''),
  files = ref<Attachment[]>([]),
  scrollAnimated = ref(false),
  scrollTop = ref(0),
  follow = ref(true),
  showThinking = ref(false),
  confirming = ref(''),
  stopping = ref(false),
  keyboard = ref(0),
  recording = ref(false),
  transcribing = ref(false);
// Native IME owns the live text. Never echo input events back into value:
// replacing UITextView.text can discard its marked (unconfirmed Pinyin) range.
function composerInput(event: UniInputEvent) {
  draft.value = event.detail.value;
}
function setDraft(value: string) {
  draft.value = value;
  inputValue.value = value;
  // An explicit clear must also work when the last programmatic value was "".
  // Do not remount the textarea: preserve its focus and keyboard.
  // #ifdef APP
  const input = uni.getElementById('chat-compose-input') as UniTextareaElement | null;
  if (input != null) input.value = value;
  // #endif
  // #ifdef WEB
  const browserInput = document.querySelector(
    '#chat-compose-input textarea',
  ) as HTMLTextAreaElement | null;
  if (browserInput != null) {
    browserInput.value = value;
    browserInput.dispatchEvent(new Event('input', { bubbles: true }));
  }
  // #endif
}
function releaseAttachment(file: Attachment) {
  // #ifdef WEB
  browserFiles.delete(file.key);
  if (file.path.startsWith('blob:')) URL.revokeObjectURL(file.path);
  // #endif
}
async function resume(): Promise<void> {
  const content = s(savedPending(), 'content');
  try {
    await _resume();
  } catch (e) {
    if (draft.value.length == 0) setDraft(content);
    toast(message(e));
  }
}
let timer: number = 0,
  active = false,
  recordCancelled = false,
  recordDraft = '',
  recordOwner = '',
  recordGeneration = 0,
  syncFailures = 0;
const voiceStage = ref('');
function rowKey(item: UTSJSONObject): string { return messageKey(item); }
const voiceLevel = ref(0);
// #ifdef APP-ANDROID
let androidAudioId = '';
let androidAudioTimer: number = 0;
let recordStopRequestedAt: number = 0;
async function handleRecording(path: string): Promise<void> {
  recording.value = false;
  if (recordCancelled) return;
  transcribing.value = true;
  voiceStage.value = '正在上传录音…';
  const run = recordGeneration;
  const started = Date.now();
  let uploadedAt: number = 0;
  console.info('[speech] recording stopped, stopWaitMs=' + (recordStopRequestedAt > 0 ? started - recordStopRequestedAt : 0));
  try {
    const data = await upload('/app/reminder/audio/transcriptions', path, 125000, (progress: number) => {
      if (run != recordGeneration || recordCancelled || recordOwner != session.userId) return;
      voiceStage.value = progress >= 100 ? '正在识别语音…' : '正在上传录音… ' + Math.floor(progress) + '%';
      if (progress >= 100 && uploadedAt == 0) {
        uploadedAt = Date.now();
        console.info('[speech] upload completed, uploadMs=' + (uploadedAt - started));
      }
    });
    console.info('[speech] response received, totalMs=' + (Date.now() - started) + ', responseWaitMs=' + (uploadedAt > 0 ? Date.now() - uploadedAt : -1));
    if (run == recordGeneration && !recordCancelled && recordOwner == session.userId)
      setDraft(recordDraft + (recordDraft.length > 0 ? '\n' : '') + s(data, 'text'));
    if (run == recordGeneration && s(data, 'text').trim().length == 0)
      throw new Error('未识别到语音，请重试');
  } catch (e) {
    if (run == recordGeneration && !recordCancelled && recordOwner == session.userId) toast(message(e));
  } finally {
    if (run == recordGeneration) transcribing.value = false;
  }
}
async function pollAndroidAudio(run: number): Promise<void> {
  if (run != recordGeneration || androidAudioId.length == 0) return;
  try {
    const data = await callNative('audio.status', { session: androidAudioId });
    if (run != recordGeneration) return;
    voiceLevel.value = (data['level'] as number) ?? 0;
    if (b(data, 'finished')) {
      androidAudioId = '';
      voiceLevel.value = 0;
      await handleRecording(s(data, 'path'));
      return;
    }
    androidAudioTimer = setTimeout(() => { void pollAndroidAudio(run); }, 100);
  } catch (e) {
    if (run != recordGeneration) return;
    recording.value = false;
    transcribing.value = false;
    voiceLevel.value = 0;
    toast(message(e));
  }
}
async function beginAndroidAudio(): Promise<void> {
  if (chat.busy || transcribing.value || recording.value || clearing.value) return;
  recordCancelled = false;
  const run = ++recordGeneration;
  recordStopRequestedAt = 0;
  recordDraft = draft.value;
  recordOwner = session.userId;
  recording.value = true;
  const id = requestId();
  try {
    await callNative('audio.permission');
    if (run != recordGeneration || recordCancelled) return;
    androidAudioId = id;
    await callNative('audio.start', { session: id });
    if (run != recordGeneration || recordCancelled) {
      await callNative('audio.stop', { session: id, cancel: true });
      return;
    }
    void pollAndroidAudio(run);
  } catch (e) {
    if (run != recordGeneration) return;
    androidAudioId = '';
    recording.value = false;
    toast(message(e));
  }
}
// #endif
let liveSpeech = false;
// #ifdef APP-IOS
liveSpeech = true;
// #endif
let keyboardId: number = -1;
let keyboardLayoutTimer: number = 0;
let scrollLockedUntil: number = 0,
  scrollTimer: number = 0,
  scrollHeight: number = 0;
let initialScrollPending = false;
let layoutTimer: number = 0;
let revealTimer: number = 0;
let actualScrollTop: number = 0;
let touching = false;
let userScrolling = false;
function measureScroll() {
  // #ifdef WEB
  const element = document.getElementById('chat-scroll');
  if (element != null) scrollHeight = element.clientHeight;
  // #endif
  // #ifdef APP
  const nativeElement = uni.getElementById('chat-scroll');
  if (nativeElement != null) scrollHeight = nativeElement.getBoundingClientRect().height;
  // #endif
}
function moveScroll(target: number, animated: boolean) {
  const value = Math.max(0, Math.ceil(target));
  if (Math.abs(value - actualScrollTop) < 2) return;
  userScrolling = false;
  scrollAnimated.value = animated;
  scrollLockedUntil = Date.now() + (animated ? 400 : 80);
  // Only commands update the binding. Scroll notifications never write back to native scroll.
  if (scrollTop.value == value) {
    scrollTop.value = actualScrollTop;
    nextTick(() => { if (!touching) scrollTop.value = value; });
  } else scrollTop.value = value;
}
function scrollAfterLayout() {
  layoutTimer = 0;
  if (!follow.value || touching) return;
  measureScroll();
  let contentHeight = 0;
  // #ifdef WEB
  const content = document.getElementById('chat-messages');
  if (content != null) contentHeight = content.getBoundingClientRect().height;
  // #endif
  // #ifdef APP
  const nativeContent = uni.getElementById('chat-messages');
  if (nativeContent != null) contentHeight = nativeContent.getBoundingClientRect().height;
  // #endif
  if (scrollHeight > 0 && contentHeight > 0)
    moveScroll(contentHeight - scrollHeight, !chat.busy && !initialScrollPending);
}
function scrollLatest() {
  if (!follow.value || touching || layoutTimer != 0) return;
  scrollLockedUntil = Date.now() + 100;
  // One coalesced measurement per content update, not a continuous native layout loop.
  layoutTimer = setTimeout(() => { scrollAfterLayout(); }, 40);
}
function revealThinking(id: string) {
  clearTimeout(layoutTimer); layoutTimer = 0;
  clearTimeout(revealTimer);
  follow.value = false;
  // Finish the small expansion, then reveal this panel (never jump to the latest message).
  revealTimer = setTimeout(() => {
    if (touching) return;
    let top = 0, bottom = 0, viewTop = 0, viewBottom = 0;
    // #ifdef WEB
    const panel = document.getElementById(id), viewport = document.getElementById('chat-scroll');
    if (panel == null || viewport == null) return;
    const rect = panel.getBoundingClientRect(), bounds = viewport.getBoundingClientRect();
    top = rect.top; bottom = rect.bottom; viewTop = bounds.top; viewBottom = bounds.bottom;
    // #endif
    // #ifdef APP
    const nativePanel = uni.getElementById(id), nativeViewport = uni.getElementById('chat-scroll');
    if (nativePanel == null || nativeViewport == null) return;
    const nativeRect = nativePanel.getBoundingClientRect(), nativeBounds = nativeViewport.getBoundingClientRect();
    top = nativeRect.top; bottom = nativeRect.bottom; viewTop = nativeBounds.top; viewBottom = nativeBounds.bottom;
    // #endif
    if (bottom > viewBottom - 12) moveScroll(actualScrollTop + Math.min(bottom - viewBottom + 12, top - viewTop - 8), true);
    else if (top < viewTop + 8) moveScroll(actualScrollTop + top - viewTop - 8, true);
  }, 200);
}
function jumpLatest() {
  follow.value = true;
  scrollLatest();
}
function settleInitialScroll() {
  if (!initialScrollPending) return;
  clearInterval(scrollTimer);
  jumpLatest();
  const started = Date.now();
  scrollTimer = setInterval(() => {
    if (!initialScrollPending) { clearInterval(scrollTimer); return; }
    scrollLatest();
    if (Date.now() - started >= 1200) { clearInterval(scrollTimer); initialScrollPending = false; }
  }, 240);
}
function updateKeyboard(height: number) {
  if (keyboard.value == height) return;
  keyboard.value = height;
  clearTimeout(keyboardLayoutTimer);
  // Both keyboard callbacks can report the same change. Apply one layout and one native scroll.
  keyboardLayoutTimer = setTimeout(() => { scrollLatest(); }, 30);
}
const keyboardChange = (event: OnKeyboardHeightChangeCallbackResult) => { updateKeyboard(event.height); };
function inputKeyboardChange(event: UniInputKeyboardHeightChangeEvent) { updateKeyboard(event.detail.height); }
function stopScrollLock() {
  clearTimeout(layoutTimer); layoutTimer = 0;
  clearTimeout(revealTimer);
  initialScrollPending = false;
  clearInterval(scrollTimer);
  scrollLockedUntil = 0;
}
function touchStarted() { touching = true; userScrolling = true; stopScrollLock(); measureScroll(); }
function touchMoved() { follow.value = false; }
function touchEnded() { touching = false; }
function scrolling(event: UniScrollEvent) {
  const detail = event.detail;
  actualScrollTop = detail.scrollTop;
  if (!userScrolling || initialScrollPending || Date.now() < scrollLockedUntil) return;
  // Cache viewport geometry; inertial scrolling does not trigger native layout reads.
  if (scrollHeight == 0) measureScroll();
  follow.value = detail.scrollHeight - actualScrollTop - scrollHeight < 80;
}
let inputConfirmType = 'send';
// #ifdef WEB
inputConfirmType = 'return';
// #endif
async function send() {
  if (
    chat.busy ||
    recording.value ||
    transcribing.value ||
    clearing.value ||
    clearOpen.value ||
    confirming.value.length > 0
  )
    return;
  if (files.value.some((f: Attachment): boolean => f.state != 'ready')) {
    toast('请等待附件解析完成');
    return;
  }
  if (draft.value.trim().length == 0 && files.value.length == 0) return;
  if (s(chat.pending, 'requestId').length > 0) {
    toast('请先确认上一条消息的处理结果');
    return;
  }
  const retained = files.value.slice(),
    text = draft.value,
    ids = files.value.map((f: Attachment): string => f.id);
  follow.value = true;
  try {
    const task = submit(
      text,
      ids,
      retained.map((file: Attachment): string => file.name),
    );
    setDraft('');
    files.value = [];
    scrollLatest();
    await task;
    if (s(chat.pending, 'requestId').length == 0) retained.forEach(releaseAttachment);
    void bootstrap().catch(() => {});
  } catch (e) {
    if (s(chat.pending, 'requestId').length == 0) {
      if (draft.value.length == 0) setDraft(text);
      files.value = retained.concat(files.value);
    }
    toast(message(e));
  }
}
function confirmSend(event: UniInputConfirmEvent) {
  // #ifndef WEB
  draft.value = event.detail.value;
  void send();
  // #endif
}
// #ifdef WEB
function composerKeydown(event: KeyboardEvent) {
  const target = event.target as HTMLElement | null;
  if (target == null || target.closest('#chat-compose-input') == null) return;
  if (event.key != 'Enter' || event.shiftKey || event.isComposing || event.keyCode == 229) return;
  event.preventDefault();
  event.stopPropagation();
  if (!event.repeat) void send();
}
onMounted(() => {
  document.addEventListener('keydown', composerKeydown, true);
});
onUnmounted(() => {
  document.removeEventListener('keydown', composerKeydown, true);
});
// #endif
async function stopGeneration(): Promise<void> {
  if (stopping.value) return;
  stopping.value = true;
  try {
    if (!(await _stopGeneration())) toast('本轮已完成生成或正在执行操作，无法撤回，请等待结果');
  } catch (e) {
    toast('停止失败：' + message(e));
  } finally {
    stopping.value = false;
  }
}
function requestClear() {
  if (
    chat.busy ||
    confirming.value.length > 0 ||
    recording.value ||
    transcribing.value ||
    files.value.some((file: Attachment): boolean => file.state == 'loading')
  ) {
    toast('请先结束当前操作，再清除上下文');
    return;
  }
  clearOpen.value = true;
}
async function clearContext() {
  if (chat.busy || s(chat.pending, 'requestId').length > 0) {
    toast('请先确认当前消息的处理结果');
    return;
  }
  if (
    clearing.value ||
    confirming.value.length > 0 ||
    recording.value ||
    transcribing.value ||
    files.value.some((file: Attachment): boolean => file.state == 'loading')
  )
    return;
  clearing.value = true;
  invalidateHistory();
  try {
    await reminder('chat/context/clear');
    clearOpen.value = false;
    setDraft('');
    files.value.forEach(releaseAttachment);
    files.value = [];
    chat.messages = [];
    follow.value = true;
    await loadHistory();
    void bootstrap().catch(() => {});
    toast('当前上下文已清除，后台记录仍保留');
  } catch (e) {
    toast(message(e));
  } finally {
    clearing.value = false;
  }
}
async function dismiss() {
  if (await confirm('结束本机等待', '这不会取消服务器任务。请先核对事件，避免重复发送。'))
    await dismissPending();
}
async function confirmCandidate(item: UTSJSONObject, alarms: number[]) {
  if (confirming.value.length > 0 || clearing.value || s(item, 'messageType') != 'CANDIDATE')
    return;
  const id = s(payload(item), 'candidateId');
  if (id.length == 0) return;
  confirming.value = id;
  try {
    let result = obj(
      await reminder(
        'candidate/confirm',
        {
          candidateId: id,
          acceptConflicts: arr(payload(item), 'events').some(
            (event: UTSJSONObject): boolean => arr(event, 'scheduleConflicts').length > 0,
          ),
        },
        {},
        300000,
      ),
      'value',
    );
    if (b(result, 'confirmationRequired')) {
      await loadHistory();
      toast('发现新的日程冲突，请查看后确认是否仍要安排');
      return;
    }
    toast('智能提醒已创建', 'success');
    const ids = strings(result, 'eventIds');
    for (const index of alarms) {
      if (index >= ids.length) {
        toast('事件已创建，但未返回事件编号，请到事件详情设置闹铃');
        continue;
      }
      try {
        await setAlarm(obj(await reminder('event/detail', null, { eventId: ids[index] }), 'value'));
        toast('本机系统闹铃已设置，可在事件详情取消');
      } catch (e) {
        toast('事件已创建，闹铃未设置：' + message(e));
      }
    }
    await bootstrap();
  } catch (e) {
    toast(message(e));
  } finally {
    confirming.value = '';
    await loadHistory();
  }
}
async function uploadOne(file: Attachment) {
  file.state = 'loading';
  try {
    let result: UTSJSONObject;
    // #ifdef WEB
    const raw = browserFiles.get(file.key);
    result =
      raw != null
        ? await uploadBrowserFile(raw, '/app/reminder/files/upload')
        : await upload('/app/reminder/files/upload', file.path);
    // #endif
    // #ifndef WEB
    result = await upload('/app/reminder/files/upload', file.path);
    // #endif
    if (s(result, 'extractStatus') != 'SUCCESS')
      throw new Error(s(result, 'extractMessage', '附件解析失败'));
    file.id = s(result, 'id');
    if (file.id.length == 0) throw new Error('未返回附件编号');
    file.state = 'ready';
  } catch (e) {
    file.state = 'error';
    toast(message(e));
  }
}
function removeFile(key: string) {
  const old = files.value.find((file: Attachment): boolean => file.key == key);
  if (old != null) releaseAttachment(old);
  files.value = files.value.filter((f: Attachment): boolean => f.key != key);
}
function addFile(
  path: string,
  name: string,
  size: number,
  image: boolean,
  key: string = requestId(),
) {
  if (clearing.value || clearOpen.value) return;
  if (files.value.length >= 6) {
    toast('每条消息最多6个附件');
    return;
  }
  const ext = name.split('.').pop()!.toLowerCase();
  if (!image || !['png', 'jpg', 'jpeg', 'gif', 'webp'].includes(ext)) {
    toast('仅支持 PNG、JPG、GIF、WEBP 图片');
    return;
  }
  if (size > 8 * 1024 * 1024) {
    toast('图片最大8MB');
    return;
  }
  const file = reactive<Attachment>({
    key: key,
    path: path,
    name: name,
    image: image,
    state: 'loading',
    id: '',
  });
  files.value.push(file);
  void uploadOne(file);
}
// #ifdef WEB
function addBrowserFiles(selected: File[]) {
  for (const file of selected) {
    const key = requestId(),
      image = /\.(png|jpg|jpeg|gif|webp)$/i.test(file.name);
    const path = image ? URL.createObjectURL(file) : '';
    browserFiles.set(key, file);
    addFile(path, file.name, file.size, image, key);
    if (!files.value.some((item: Attachment): boolean => item.key == key)) {
      browserFiles.delete(key);
      if (path.length > 0) URL.revokeObjectURL(path);
    }
  }
}
function pasteImages(event: ClipboardEvent) {
  const target = event.target as HTMLElement | null;
  if (target == null || target.closest('#chat-compose-input') == null) return;
  const images = Array.from(event.clipboardData?.files ?? []).filter((file: File): boolean =>
    file.type.startsWith('image/'),
  );
  if (images.length > 0) {
    event.preventDefault();
    addBrowserFiles(images);
  }
}
onMounted(() => {
  document.addEventListener('paste', pasteImages);
});
onUnmounted(() => {
  document.removeEventListener('paste', pasteImages);
});
// #endif
function chooseAttachment() {
  if (clearing.value || clearOpen.value) return;
  if (files.value.length >= 6) {
    toast('每条消息最多6张图片');
    return;
  }
  // #ifdef WEB
  chooseBrowserFiles('image/png,image/jpeg,image/webp,image/gif', addBrowserFiles);
  return;
  // #endif
  // #ifndef WEB
  pickImages(Math.max(1, 6 - files.value.length), (result) => {
    result.tempFiles.forEach((file) =>
      addFile(file.path, file.path.split('/').pop()!, file.size, true),
    );
  });
  // #endif
}
// #ifdef APP-IOS
let speechId = '',
  speechTimer: number = 0;
async function pollSpeech(run: number): Promise<void> {
  if (run != recordGeneration || speechId.length == 0) return;
  try {
    const data = await callNative('speech.poll', { session: speechId });
    if (run != recordGeneration || recordOwner != session.userId) return;
    voiceLevel.value = (data['level'] as number) ?? 0;
    const text = s(data, 'text');
    if (text.length > 0) setDraft(recordDraft + (recordDraft.trim().length > 0 ? '\n' : '') + text);
    recording.value = b(data, 'recording');
    transcribing.value = !recording.value && !b(data, 'finished');
    if (b(data, 'finished')) {
      speechId = '';
      recording.value = false;
      transcribing.value = false;
      if (s(data, 'message').length > 0) toast(s(data, 'message'));
      return;
    }
    speechTimer = setTimeout(() => {
      void pollSpeech(run);
    }, 180);
  } catch (e) {
    recording.value = false;
    transcribing.value = false;
    toast(message(e));
  }
}
async function beginSpeech(): Promise<void> {
  if (chat.busy || recording.value || transcribing.value || clearing.value) return;
  recordCancelled = false;
  recordDraft = draft.value;
  recordOwner = session.userId;
  const run = ++recordGeneration,
    id = requestId();
  speechId = id;
  recording.value = true;
  try {
    await callNative('speech.start', { session: id });
    if (run == recordGeneration) void pollSpeech(run);
  } catch (e) {
    if (run == recordGeneration) {
      speechId = '';
      recording.value = false;
      toast(message(e));
    }
  }
}
// #endif
function startRecording() {
  uni.hideKeyboard();
  voiceLevel.value = 0;
  // #ifdef APP-IOS
  void beginSpeech();
  // #endif
  // #ifdef APP-ANDROID
  void beginAndroidAudio();
  // #endif
  // #ifdef WEB
  if (chat.busy || recording.value || transcribing.value || clearing.value) return;
  recordCancelled = false;
  recordDraft = draft.value;
  recordOwner = session.userId;
  const run = ++recordGeneration;
  recording.value = true;
  void startBrowserRecording(
    (file: File) => {
      recording.value = false;
      transcribing.value = true;
      void uploadBrowserFile(file, '/app/reminder/audio/transcriptions', 125000)
        .then((data: UTSJSONObject) => {
          if (run != recordGeneration || recordCancelled || recordOwner != session.userId) return;
          const text = s(data, 'text').trim();
          if (text.length == 0) throw new Error('未识别到语音，请重试');
          setDraft(recordDraft + (recordDraft.trim().length > 0 ? '\n' : '') + text);
        })
        .catch((e) => {
          if (run == recordGeneration) toast(message(e));
        })
        .finally(() => {
          if (run == recordGeneration) transcribing.value = false;
        });
    },
    (error: string) => {
      if (run == recordGeneration) {
        recording.value = false;
        transcribing.value = false;
        toast(error);
      }
    },
    (level: number) => {
      if (run == recordGeneration) voiceLevel.value = level;
    },
  ).catch((e) => {
    if (run == recordGeneration) {
      recording.value = false;
      toast(message(e));
    }
  });
  // #endif
}
function finishRecording() {
  // #ifdef APP-IOS
  if (speechId.length > 0) {
    recording.value = false;
    transcribing.value = true;
    void callNative('speech.stop', { session: speechId, cancel: false }).catch((e) =>
      toast(message(e)),
    );
  }
  // #endif
  // #ifdef WEB
  finishBrowserRecording();
  // #endif
  // #ifdef APP-ANDROID
  if (recording.value) {
    if (androidAudioId.length == 0) { recordCancelled = true; recordGeneration++; recording.value = false; return; }
    recordStopRequestedAt = Date.now();
    recording.value = false;
    transcribing.value = true;
    voiceStage.value = '正在结束录音…';
    void callNative('audio.stop', { session: androidAudioId, cancel: recordCancelled }).catch((e) => { toast(message(e)); });
  }
  // #endif
}
function cancelRecording() {
  const restoreDraft = (recording.value || transcribing.value) && recordOwner == session.userId;
  if (restoreDraft) setDraft(recordDraft);
  voiceLevel.value = 0;
  // #ifdef APP-IOS
  clearTimeout(speechTimer);
  if (speechId.length > 0)
    void callNative('speech.stop', { session: speechId, cancel: true }).catch(() => {});
  speechId = '';
  // #endif
  recordCancelled = true;
  recordGeneration++;
  transcribing.value = false;
  // #ifdef WEB
  cancelBrowserRecording();
  // #endif
  // #ifdef APP-ANDROID
  clearTimeout(androidAudioTimer);
  if (androidAudioId.length > 0) void callNative('audio.stop', { session: androidAudioId, cancel: true }).catch(() => {});
  androidAudioId = '';
  // #endif
  recording.value = false;
}
function stopPage() {
  touching = false; userScrolling = false;
  clearTimeout(revealTimer);
  clearTimeout(layoutTimer);
  layoutTimer = 0;
  initialScrollPending = false;
  clearInterval(scrollTimer);
  clearTimeout(keyboardLayoutTimer);
  keyboard.value = 0;
  active = false;
  setChatVisible(false);
  clearTimeout(timer);
  drawer.value = false;
  pauseChat();
  cancelRecording();
  // #ifdef APP
  if (keyboardId >= 0) uni.offKeyboardHeightChange(keyboardId);
  keyboardId = -1;
  // #endif
}
let syncCallback: () => void = () => {};
function scheduleSync(delay: number = 3000) {
  clearTimeout(timer);
  if (!active) return;
  timer = setTimeout(syncCallback, delay);
}
async function refreshMessages() {
  if (!active || !session.visible) {
    scheduleSync();
    return;
  }
  if (clearing.value || confirming.value.length > 0) {
    scheduleSync();
    return;
  }
  try {
    await syncHistory();
    syncFailures = 0;
    void bootstrap().catch(() => {});
  } catch (_) {
    syncFailures = Math.min(4, syncFailures + 1);
  } finally {
    scheduleSync(Math.min(30000, 3000 * Math.pow(2, syncFailures)));
  }
}
// #ifdef WEB
function browserResume() {
  if (active && !document.hidden) {
    void resume();
    scheduleSync(0);
  }
}
function browserLayout() {
  if (active && follow.value)
    nextTick(() => {
      measureScroll();
      scrollLatest();
    });
}
onMounted(() => {
  document.addEventListener('visibilitychange', browserResume);
  window.addEventListener('online', browserResume);
  window.visualViewport?.addEventListener('resize', browserLayout);
});
onUnmounted(() => {
  document.removeEventListener('visibilitychange', browserResume);
  window.removeEventListener('online', browserResume);
  window.visualViewport?.removeEventListener('resize', browserLayout);
});
// #endif
syncCallback = () => {
  void refreshMessages();
};
onShow(() => {
  if (!requireSession()) return;
  active = true;
  setChatVisible(true);
  initialScrollPending = true;
  follow.value = true;
  nextTick(() => {
    measureScroll();
    scrollLatest();
  });
  void loadHistory().then(() => {
    nextTick(settleInitialScroll);
  });
  void resume();
  void bootstrap();
  // #ifdef APP
  keyboardId = uni.onKeyboardHeightChange(keyboardChange);
  // #endif
  scheduleSync(0);
});
onHide(stopPage);
onUnload(() => {
  stopPage();
  files.value.forEach(releaseAttachment);
  // #ifdef WEB
  browserFiles.clear();
  // #endif
  clearInterval(scrollTimer);
  // #ifdef APP-ANDROID
  clearTimeout(androidAudioTimer);
  // #endif
});

watch((): number => chat.messages.length, scrollLatest);
watch((): UTSJSONObject[] => chat.messages, scrollLatest);
watch((): string => chat.reasoning, scrollLatest);
watch((): string => chat.reply, scrollLatest);
watch((): string => s(chat.pending, 'requestId'), scrollLatest);
</script>
