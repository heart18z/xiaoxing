<template>
  <AppFrame :title="t('创建小醒账号')" :subtitle="t('验证邮箱，开启智能提醒')" :back-button="true">
    <scroll-view :scroll-y="true" class="scroll">
      <view class="page-content">
        <view class="card registration-card">
          <text class="app-font welcome">{{ t('欢迎加入小醒') }}</text>
          <text class="app-font intro">{{ t('邮箱用于登录和找回密码，请使用常用邮箱。') }}</text>
          <RegistrationForm v-if="!created" @success="registered" />
          <text v-else class="app-font intro">{{ t('注册成功，正在登录…') }}</text>
        </view>
        <text v-if="error.length > 0" class="app-font error">{{ error }}</text>
        <text class="app-font back-link" @click="back">{{ t('已有账号？返回登录') }}</text>
      </view>
    </scroll-view>
  </AppFrame>
</template>
<script setup lang="uts">
import { updates } from '@/services/updates.uts';
import { ref } from 'vue';
import AppFrame from '@/components/AppFrame.uvue';
import RegistrationForm from '@/components/RegistrationForm.uvue';
import { login } from '@/api/request.uts';
import { syncPush } from '@/services/native.uts';
import { message } from '@/core/json.uts';
import { toast } from '@/core/ui.uts';
import { t as _t } from '@/core/locale.uts';
function t(value: string): string {
  return _t(value);
}
const error = ref(''),
  created = ref(false);
function back() {
  uni.reLaunch({ url: '/pages/login/index' });
}
async function registered(account: string, password: string) {
  created.value = true;
  try {
    await login(account, password);
    uni.setStorageSync('last-account', account);
    void syncPush(true);
    uni.reLaunch({ url: '/pages/chat/index' });
  } catch (e) {
    uni.setStorageSync('last-account', account);
    toast('注册成功，请返回登录');
    error.value = message(e);
  }
}
// #ifdef APP-ANDROID
onBackPress((): boolean => updates.required && updates.available);
// #endif
</script>
<style scoped>
.page-content {
  padding: 18px 18px 40px;
}
.registration-card {
  padding: 24px 20px;
}
.welcome {
  font-size: 24px;
  font-weight: 700;
  color: #273452;
  margin-bottom: 10px;
}
.intro {
  font-size: 13px;
  line-height: 21px;
  color: #7c869c;
  margin-bottom: 24px;
}
.back-link {
  text-align: center;
  font-size: 14px;
  color: #4c5cff;
  padding: 22px;
}
</style>
