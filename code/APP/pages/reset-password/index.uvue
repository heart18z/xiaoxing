<template>
  <AppFrame :title="t('找回密码')" :subtitle="t('通过邮箱验证，重设登录密码')" :back-button="true">
    <scroll-view :scroll-y="true" class="scroll">
      <view class="page-content">
        <view class="card reset-card">
          <text class="app-font title">{{ t('设置新密码') }}</text>
          <text class="app-font intro">
            {{ t('请输入注册时使用的邮箱，验证后即可重置密码。') }}
          </text>
          <text class="app-font label">{{ t('邮箱') }}</text>
          <input
            class="app-font input"
            v-model="email"
            :disabled="busy"
            maxlength="45"
            :placeholder="t('常用邮箱')"
          />
          <EmailCodeField v-model="code" :email="email" purpose="RESET" :disabled="busy" />
          <text class="app-font label space">{{ t('新密码') }}</text>
          <input
            class="app-font input"
            v-model="password"
            :password="true"
            :disabled="busy"
            maxlength="64"
            :placeholder="t('8–64 位密码')"
          />
          <text class="app-font label">{{ t('确认新密码') }}</text>
          <input
            class="app-font input"
            v-model="confirmation"
            :password="true"
            :disabled="busy"
            maxlength="64"
            :placeholder="t('再次输入新密码')"
          />
          <text v-if="error.length > 0" class="app-font error">{{ error }}</text>
          <view class="submit">
            <LoginButton
              :busy="busy"
              :label="t('重置密码')"
              :busy-label="t('正在修改…')"
              @click="submit"
            />
          </view>
          <text class="app-font intro space">{{ t('重置成功后，请使用新密码重新登录。') }}</text>
        </view>
      </view>
    </scroll-view>
  </AppFrame>
</template>
<script setup lang="uts">
import { updates } from '@/services/updates.uts';
import { ref } from 'vue';
import AppFrame from '@/components/AppFrame.uvue';
import EmailCodeField from '@/components/EmailCodeField.uvue';
import LoginButton from '@/components/LoginButton.uvue';
import { post } from '@/api/request.uts';
import { message } from '@/core/json.uts';
import { toast } from '@/core/ui.uts';
import { t as _t } from '@/core/locale.uts';
function t(value: string): string {
  return _t(value);
}
const email = ref(''),
  code = ref(''),
  password = ref(''),
  confirmation = ref(''),
  busy = ref(false),
  error = ref('');
async function submit() {
  if (busy.value) return;
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim()) || !/^[0-9]{6}$/.test(code.value)) {
    error.value = t('请输入正确的邮箱和6位验证码');
    return;
  }
  if (
    password.value.length < 8 ||
    password.value.length > 64 ||
    password.value != confirmation.value
  ) {
    error.value = t('请确认两次密码一致，长度为8–64位');
    return;
  }
  busy.value = true;
  error.value = '';
  try {
    await post(
      '/app/account/reset-password',
      {
        email: email.value.trim(),
        code: code.value,
        password: password.value,
        confirmation: confirmation.value,
      },
      {},
      15000,
      false,
    );
    uni.setStorageSync('last-account', email.value.trim());
    password.value = '';
    confirmation.value = '';
    code.value = '';
    uni.reLaunch({
      url: '/pages/login/index',
      success: () => {
        toast('密码已重置，请重新登录');
      },
    });
  } catch (e) {
    error.value = message(e);
  } finally {
    busy.value = false;
  }
}
// #ifdef APP-ANDROID
onBackPress((): boolean => updates.required && updates.available);
// #endif
</script>
<style scoped>
.page-content {
  padding: 18px 18px 40px;
}
.reset-card {
  padding: 26px 20px;
}
.title {
  font-size: 24px;
  font-weight: 700;
  color: #273452;
  margin-bottom: 12px;
}
.intro {
  font-size: 13px;
  line-height: 22px;
  color: #7c869c;
  margin-bottom: 24px;
}
.label {
  font-size: 14px;
  color: #374151;
  margin-bottom: 8px;
}
.space {
  margin-top: 20px;
}
.submit {
  margin-top: 18px;
}
</style>
