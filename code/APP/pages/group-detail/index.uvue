<template>
  <AppFrame theme="profile" :loading="loading">
    <view class="group-nav">
      <view class="nav-circle" @click="goBack()">
        <UiIcon name="chevron" tone="blue" :size="23" class="back-icon" />
      </view>
      <text class="app-font nav-title">{{ t('群组详情') }}</text>
      <view class="nav-spacer" />
    </view>
    <scroll-view class="detail-scroll" :scroll-y="true" :bounces="false">
      <view class="detail-body">
        <view v-if="error.length > 0" class="surface">
          <text class="app-font error">{{ t(error) }}</text>
          <button class="app-font secondary" @click="load()">{{ t('重新加载') }}</button>
        </view>
        <view v-else-if="s(group, 'id').length > 0">
          <view class="surface hero-card">
            <view class="hero-row">
              <view class="hero-picture" @click="editMetadata()">
                <image
                  class="hero-avatar"
                  :src="asset(s(group, 'avatar', groupAvatars[0]))"
                  mode="aspectFill"
                />
                <text class="app-font avatar-caption">
                  {{ t(manager ? '点击头像可更换' : '群组头像') }}
                </text>
              </view>
              <view class="hero-copy">
                <view class="hero-title-row" @click="editMetadata()">
                  <text class="app-font hero-name">{{ s(group, 'name') }}</text>
                  <view v-if="manager" class="pencil-dot">
                    <UiIcon name="edit" tone="muted" :size="15" />
                  </view>
                </view>
                <view class="hero-title-row intro-row" @click="editMetadata()">
                  <text class="app-font introduction">
                    {{
                      s(group, 'introduction').length > 0 ? s(group, 'introduction') : t('暂无介绍')
                    }}
                  </text>
                  <view v-if="manager" class="pencil-dot">
                    <UiIcon name="edit" tone="muted" :size="14" />
                  </view>
                </view>
              </view>
            </view>
            <view class="hero-actions">
              <view v-if="role == 'OWNER'" class="hero-action" @click="openInvite()">
                <UiIcon name="userPlus" tone="blue" :size="22" />
                <text class="app-font hero-action-text">{{ t('邀请好友') }}</text>
              </view>
              <view v-if="role == 'OWNER'" class="hero-action" @click="openAdmins()">
                <UiIcon name="settings" tone="blue" :size="21" />
                <text class="app-font hero-action-text">{{ t('设置管理员') }}</text>
              </view>
              <view v-if="role == 'OWNER'" class="hero-action action-danger" @click="dissolve()">
                <UiIcon name="trash" tone="red" :size="21" />
                <text class="app-font hero-action-text danger-text">{{ t('解散群') }}</text>
              </view>
              <view v-else class="hero-action" @click="editSelfTags()">
                <UiIcon name="tag" tone="blue" :size="21" />
                <text class="app-font hero-action-text">{{ t('我的标签') }}</text>
              </view>
            </view>
          </view>
          <view class="surface tags-card">
            <view class="section-heading">
              <UiIcon name="layers" tone="blue" :size="24" />
              <text class="app-font section-title grow">{{ t('群组标签') }}</text>
              <view v-if="manager" class="unified-action" @click="openCatalog()">
                <UiIcon name="settings" tone="blue" :size="15" />
                <text class="app-font unified-text">{{ t('统一设置') }}</text>
                <UiIcon name="chevron" :size="14" />
              </view>
            </view>
            <view class="tag-wrap group-tags">
              <view
                v-for="tag in tags"
                :key="s(tag, 'id')"
                :class="['tag-pill', groupTagTone(s(tag, 'name'))]"
                @click="manager && editCatalogTag(tag)"
              >
                <text class="app-font tag-label">{{ s(tag, 'name') }}</text>
                <text class="app-font tag-count">{{ n(tag, 'memberCount') }}</text>
              </view>
              <text v-if="tags.length == 0" class="app-font small-muted">{{ t('暂无标签') }}</text>
            </view>
          </view>
          <view class="surface members-card">
            <view class="section-heading member-heading">
              <UiIcon name="people" tone="blue" :size="24" />
              <text class="app-font section-title">{{ t('群员列表') }}</text>
              <text class="app-font count-text">{{ members.length }} {{ t('人') }}</text>
            </view>
            <view v-for="person in members" :key="s(person, 'id')" class="member-row">
              <image
                class="member-avatar"
                :src="asset(s(person, 'avatar', '/avatars/user/B1.png'))"
                mode="aspectFill"
              />
              <view class="member-info">
                <view class="member-top">
                  <text class="app-font member-name grow">{{ groupPersonName(person) }}</text>
                  <view v-if="canEdit(person)" class="row-action" @click="openPerson(person)">
                    <UiIcon name="edit" tone="blue" :size="12" />
                    <text class="app-font row-action-text">{{ t('编辑') }}</text>
                  </view>
                  <view
                    v-if="role == 'OWNER' && s(person, 'memberRole') != 'OWNER'"
                    class="row-action row-danger"
                    @click="removePerson(person)"
                  >
                    <UiIcon name="userMinus" tone="red" :size="12" />
                    <text class="app-font row-action-text danger-text">{{ t('移出群组') }}</text>
                  </view>
                </view>
                <text class="app-font small-muted">@{{ s(person, 'account') }}</text>
                <view class="tag-wrap">
                  <view
                    v-if="s(person, 'memberRole') == 'OWNER'"
                    class="tag-pill compact-pill tone-4"
                  >
                    <text class="app-font tag-label">♔ {{ t('群主') }}</text>
                  </view>
                  <view
                    v-if="s(person, 'memberRole') == 'ADMIN'"
                    class="tag-pill compact-pill tone-0"
                  >
                    <text class="app-font tag-label">{{ t('管理员') }}</text>
                  </view>
                  <view
                    v-for="tag in arr(person, 'tags')"
                    :key="s(tag, 'id')"
                    :class="['tag-pill', 'compact-pill', groupTagTone(s(tag, 'name'))]"
                  >
                    <text class="app-font tag-label">{{ s(tag, 'name') }}</text>
                  </view>
                  <text
                    v-if="arr(person, 'tags').length == 0 && s(person, 'memberRole') == 'MEMBER'"
                    class="app-font no-tag"
                  >
                    {{ t('未设置标签') }}
                  </text>
                </view>
              </view>
            </view>
          </view>
          <button v-if="role != 'OWNER'" class="app-font danger bottom-action" @click="leave()">
            {{ t('退出群组') }}
          </button>
        </view>
      </view>
    </scroll-view>
  </AppFrame>
  <GroupEditor :open="editing" :group="group" @close="editing = false" @saved="metadataSaved" />
  <Popup
    :open="inviting"
    :title="t('邀请好友')"
    variant="group"
    :busy="saving"
    :fixed-footer="true"
    :panel-height="inviteHeight"
    @close="inviting = false"
  >
    <view class="search-box">
      <UiIcon name="search" :size="21" />
      <input
        class="app-font search-input"
        v-model="inviteQuery"
        :placeholder="t('搜索好友名称或账号')"
        :adjust-position="false"
      />
    </view>
    <view class="selection-count">
      <text class="app-font small-muted">{{ t('已选择') }}</text>
      <text class="app-font selection-number">{{ inviteIds.length }}</text>
      <text class="app-font small-muted">{{ t('人') }}</text>
    </view>
    <text v-if="friendsLoading" class="app-font small-muted">{{ t('正在读取…') }}</text>
    <text v-else-if="availableFriends.length == 0" class="app-font small-muted">
      {{ t('暂无可邀请好友') }}
    </text>
    <view
      v-for="friend in availableFriends"
      :key="s(friend, 'id')"
      :class="['picker-row', canInviteFriend(friend) ? '' : 'invite-disabled']"
      @click="toggleInvite(s(friend, 'id'))"
    >
      <image
        class="picker-avatar"
        :src="asset(s(friend, 'avatar', '/avatars/user/B1.png'))"
        mode="aspectFill"
      />
      <view class="grow">
        <text class="app-font member-name">{{ groupPersonName(friend) }}</text>
        <text class="app-font small-muted">@{{ s(friend, 'account') }}</text>
        <text v-if="!canInviteFriend(friend)" class="app-font invite-reason">
          {{ t('暂无向对方发起提醒的权限') }}
        </text>
      </view>
      <view :class="['check-circle', inviteIds.includes(s(friend, 'id')) ? 'check-selected' : '']">
        <UiIcon v-if="inviteIds.includes(s(friend, 'id'))" name="check" tone="white" :size="18" />
      </view>
    </view>
    <text v-if="formError.length > 0" class="app-font error">{{ t(formError) }}</text>
    <template #footer>
      <view class="form-actions">
        <button class="app-font secondary form-button" :disabled="saving" @click="inviting = false">
          {{ t('取消') }}
        </button>
        <button
          class="app-font primary form-button submit-button"
          :disabled="saving || friendsLoading || inviteIds.length == 0"
          :loading="saving"
          @click="invite()"
        >
          {{ t('发送邀请') }}
        </button>
      </view>
    </template>
  </Popup>
  <Popup
    :open="personOpen"
    :title="t('成员详情')"
    variant="group"
    :busy="saving"
    :fixed-footer="true"
    :panel-height="personHeight"
    @close="personOpen = false"
  >
    <view class="person-profile">
      <image
        class="person-profile-avatar"
        :src="asset(s(selected, 'avatar', '/avatars/user/B1.png'))"
        mode="aspectFill"
      />
      <view class="grow">
        <text class="app-font person-profile-name">{{ groupPersonName(selected) }}</text>
        <text class="app-font profile-account">@{{ s(selected, 'account') }}</text>
      </view>
    </view>
    <view class="tag-section">
      <view class="section-heading">
        <UiIcon name="tag" tone="blue" :size="19" />
        <text class="app-font modal-section-title">{{ t('当前标签') }}</text>
      </view>
      <view class="tag-wrap">
        <view
          v-for="label in personTags"
          :key="label"
          :class="['tag-pill', groupTagTone(label)]"
          @click="togglePersonTag(label)"
        >
          <text class="app-font tag-label">{{ label }}</text>
          <UiIcon v-if="canEditPerson" name="close" :size="13" />
        </view>
        <text v-if="personTags.length == 0" class="app-font small-muted">
          {{ t('未设置标签') }}
        </text>
      </view>
    </view>
    <view v-if="canEditPerson" class="tag-section">
      <view class="section-heading">
        <UiIcon name="plus" tone="blue" :size="19" />
        <text class="app-font modal-section-title">{{ t('添加标签') }}</text>
      </view>
      <view class="tag-wrap">
        <view
          v-for="tag in availablePersonTags"
          :key="s(tag, 'id')"
          :class="['tag-pill', groupTagTone(s(tag, 'name'))]"
          @click="togglePersonTag(s(tag, 'name'))"
        >
          <UiIcon name="plus" tone="blue" :size="14" />
          <text class="app-font tag-label">{{ s(tag, 'name') }}</text>
        </view>
      </view>
      <view v-if="addingPersonTag" class="new-tag-input">
        <input
          class="app-font new-tag-field grow"
          v-model="newPersonTag"
          maxlength="40"
          :focus="addingPersonTag"
          :adjust-position="false"
          :placeholder="t('输入标签内容')"
          @confirm="addPersonTag()"
        />
        <view class="new-tag-done" @click="addPersonTag()">
          <UiIcon name="check" tone="blue" :size="19" />
        </view>
      </view>
      <view v-else class="new-tag-button" @click="addingPersonTag = true">
        <UiIcon name="plus" tone="blue" :size="18" />
        <text class="app-font new-tag-label">{{ t('新建标签') }}</text>
      </view>
    </view>
    <text v-if="formError.length > 0" class="app-font error">{{ t(formError) }}</text>
    <template #footer>
      <view class="form-actions">
        <button
          class="app-font secondary form-button"
          :disabled="saving"
          @click="personOpen = false"
        >
          {{ t('取消') }}
        </button>
        <button
          v-if="canEditPerson"
          class="app-font primary form-button submit-button"
          :disabled="saving"
          :loading="saving"
          @click="savePersonTags()"
        >
          {{ t('保存') }}
        </button>
      </view>
    </template>
  </Popup>
  <Popup
    :open="adminsOpen"
    :title="t('设置管理员')"
    variant="group"
    :busy="saving"
    :fixed-footer="true"
    :panel-height="adminHeight"
    @close="adminsOpen = false"
  >
    <view class="admin-note">
      <UiIcon name="tipInfo" tone="blue" :size="18" />
      <text class="app-font admin-note-text">{{ t('仅可从当前群成员中新增管理员') }}</text>
    </view>
    <view class="section-heading admin-heading">
      <text class="app-font crown">♔</text>
      <text class="app-font modal-section-title">{{ t('当前管理员') }}</text>
      <text class="app-font small-muted">{{ currentAdmins.length }} {{ t('人') }}</text>
    </view>
    <view v-for="person in currentAdmins" :key="s(person, 'id')" class="picker-row admin-person">
      <image
        class="picker-avatar"
        :src="asset(s(person, 'avatar', '/avatars/user/B1.png'))"
        mode="aspectFill"
      />
      <view class="grow">
        <text class="app-font member-name">{{ groupPersonName(person) }}</text>
        <text class="app-font small-muted">@{{ s(person, 'account') }}</text>
      </view>
      <text v-if="s(person, 'memberRole') == 'OWNER'" class="app-font owner-fixed">
        {{ t('群主') }}
      </text>
      <view v-else class="row-action row-danger" @click="toggleAdmin(s(person, 'id'))">
        <UiIcon name="trash" tone="red" :size="14" />
        <text class="app-font row-action-text danger-text">{{ t('移除') }}</text>
      </view>
    </view>
    <view class="section-heading admin-heading admin-divider">
      <UiIcon name="people" tone="blue" :size="21" />
      <text class="app-font modal-section-title">{{ t('选择群成员') }}</text>
      <text class="app-font small-muted">{{ availableAdmins.length }} {{ t('人') }}</text>
    </view>
    <view v-for="person in availableAdmins" :key="s(person, 'id')" class="picker-row admin-person">
      <image
        class="picker-avatar"
        :src="asset(s(person, 'avatar', '/avatars/user/B1.png'))"
        mode="aspectFill"
      />
      <view class="grow">
        <text class="app-font member-name">{{ groupPersonName(person) }}</text>
        <text class="app-font small-muted">@{{ s(person, 'account') }}</text>
      </view>
      <view class="outline-action" @click="toggleAdmin(s(person, 'id'))">
        <text class="app-font row-action-text">{{ t('设为管理员') }}</text>
      </view>
    </view>
    <text v-if="formError.length > 0" class="app-font error">{{ t(formError) }}</text>
    <template #footer>
      <view class="form-actions">
        <button
          class="app-font secondary form-button"
          :disabled="saving"
          @click="adminsOpen = false"
        >
          {{ t('取消') }}
        </button>
        <button
          class="app-font primary form-button submit-button"
          :disabled="saving"
          :loading="saving"
          @click="saveAdmins()"
        >
          {{ t('保存') }}
        </button>
      </view>
    </template>
  </Popup>
  <Popup
    :open="catalogOpen"
    variant="group"
    :title="t(tagEditing ? '标签与人员' : '标签管理')"
    :busy="saving"
    :fixed-footer="true"
    :panel-height="tagEditing ? 590 : Math.min(530, 220 + tags.length * 55)"
    @close="catalogOpen = false"
  >
    <view v-if="!tagEditing">
      <text class="app-font intro-note">
        {{ t('先设置标签，再选择对应的多位成员。标签不会授予管理或提醒权限。') }}
      </text>
      <view v-for="tag in tags" :key="s(tag, 'id')" class="catalog-row" @click="editTag(tag)">
        <view class="grow">
          <view :class="['tag-pill', groupTagTone(s(tag, 'name'))]">
            <text class="app-font tag-label">{{ s(tag, 'name') }}</text>
          </view>
        </view>
        <text class="app-font small-muted">{{ n(tag, 'memberCount') }} {{ t('人') }}</text>
        <UiIcon name="chevron" :size="18" />
      </view>
      <text v-if="tags.length == 0" class="app-font small-muted">
        {{ t('暂无标签，点击下方创建') }}
      </text>
    </view>
    <view v-else>
      <input
        class="app-font input"
        v-model="tagName"
        maxlength="40"
        :adjust-position="false"
        :placeholder="t('例如：消防负责人')"
      />
      <text class="app-font intro-note">
        {{ t('选择拥有该标签的成员') }} · {{ tagPeople.length }}
      </text>
      <view
        v-for="person in members"
        :key="s(person, 'id')"
        class="picker-row"
        @click="toggleTagPerson(s(person, 'id'))"
      >
        <image class="picker-avatar" :src="asset(s(person, 'avatar', '/avatars/user/B1.png'))" />
        <view class="grow">
          <text class="app-font member-name">{{ groupPersonName(person) }}</text>
          <text class="app-font small-muted">@{{ s(person, 'account') }}</text>
        </view>
        <view
          :class="['check-circle', tagPeople.includes(s(person, 'id')) ? 'check-selected' : '']"
        >
          <text v-if="tagPeople.includes(s(person, 'id'))" class="app-font check-mark">✓</text>
        </view>
      </view>
      <button
        v-if="tagId.length > 0"
        class="app-font danger"
        :disabled="saving"
        @click="deleteTag()"
      >
        {{ t('删除此标签') }}
      </button>
    </view>
    <text v-if="formError.length > 0" class="app-font error">{{ t(formError) }}</text>
    <template #footer>
      <button
        class="app-font primary"
        :disabled="saving"
        :loading="saving"
        @click="submitCatalog()"
      >
        {{ t(tagEditing ? '保存标签与人员' : '新增标签') }}
      </button>
    </template>
  </Popup>
</template>
<script setup lang="uts">
import { updates } from '@/services/updates.uts';
import { ref, computed, onBeforeUnmount } from 'vue';
import AppFrame from '@/components/AppFrame.uvue';
import Popup from '@/components/Popup.uvue';
import UiIcon from '@/components/UiIcon.uvue';
import GroupEditor from '@/components/GroupEditor.uvue';
import { t as _t } from '@/core/locale.uts';
import { s as _s, n as _n, arr as _arr, obj, message } from '@/core/json.uts';
import {
  groupRoleLabel as _groupRoleLabel,
  groupMemberRole as _groupMemberRole,
  groupPersonName as _groupPersonName,
  groupCanManage,
  toggleGroupSelection,
  groupAvatars,
  groupTagTone as _groupTagTone,
} from '@/core/groups.uts';
import { asset as _asset, toast, confirm } from '@/core/ui.uts';
import { reminder } from '@/api/request.uts';
import { session, requireSession } from '@/store/session.uts';
// Local methods keep template calls compatible with the Android UTS compiler.
function t(value: string): string {
  return _t(value);
}
function s(row: UTSJSONObject, key: string, fallback: string = ''): string {
  return _s(row, key, fallback);
}
function n(row: UTSJSONObject, key: string): number {
  return _n(row, key);
}
function arr(row: UTSJSONObject, key: string): UTSJSONObject[] {
  return _arr(row, key);
}
function asset(value: string): string {
  return _asset(value);
}
function groupPersonName(person: UTSJSONObject): string {
  return _groupPersonName(person);
}
function groupMemberRole(role: string): string {
  return _groupMemberRole(role);
}
function groupTagTone(name: string): string {
  return _groupTagTone(name);
}
function groupRoleLabel(role: string): string {
  return _groupRoleLabel(role);
}

const groupId = ref(''),
  group = ref<UTSJSONObject>({}),
  loading = ref(false),
  saving = ref(false),
  error = ref(''),
  formError = ref('');
const editing = ref(false),
  inviting = ref(false),
  personOpen = ref(false),
  catalogOpen = ref(false),
  tagEditing = ref(false),
  adminsOpen = ref(false),
  addingPersonTag = ref(false),
  friendsLoading = ref(false);
const adminIds = ref<string[]>([]);
const personHeight = ref(450);
const friends = ref<UTSJSONObject[]>([]),
  inviteIds = ref<string[]>([]),
  inviteQuery = ref('');
const selected = ref<UTSJSONObject>({}),
  personTags = ref<string[]>([]),
  newPersonTag = ref('');
const tagId = ref(''),
  tagName = ref(''),
  tagPeople = ref<string[]>([]);
const members = computed((): UTSJSONObject[] => arr(group.value, 'members'));
const tags = computed((): UTSJSONObject[] => arr(group.value, 'tags'));
const role = computed((): string => s(group.value, 'myRole'));
const manager = computed((): boolean => groupCanManage(role.value));
const canEditPerson = computed(
  (): boolean => manager.value || s(selected.value, 'id') == session.userId,
);
const availablePersonTags = computed((): UTSJSONObject[] =>
  tags.value.filter((tag: UTSJSONObject): boolean => !personTags.value.includes(s(tag, 'name'))),
);
const currentAdmins = computed((): UTSJSONObject[] =>
  members.value.filter(
    (p: UTSJSONObject): boolean =>
      s(p, 'memberRole') == 'OWNER' || adminIds.value.includes(s(p, 'id')),
  ),
);
const availableAdmins = computed((): UTSJSONObject[] =>
  members.value.filter(
    (p: UTSJSONObject): boolean =>
      s(p, 'memberRole') != 'OWNER' && !adminIds.value.includes(s(p, 'id')),
  ),
);
function editMetadata(): void {
  if (manager.value) editing.value = true;
}
function canEdit(person: UTSJSONObject): boolean {
  return manager.value || s(person, 'id') == session.userId;
}
function personSummary(person: UTSJSONObject): string {
  const labels = arr(person, 'tags')
    .map((tag: UTSJSONObject): string => s(tag, 'name'))
    .slice(0, 2)
    .join('、');
  return t(groupMemberRole(s(person, 'memberRole'))) + (labels.length > 0 ? ' · ' + labels : '');
}
function openAdmins(): void {
  if (role.value != 'OWNER') return;
  adminIds.value = members.value
    .filter((p: UTSJSONObject): boolean => s(p, 'memberRole') == 'ADMIN')
    .map((p: UTSJSONObject): string => s(p, 'id'));
  formError.value = '';
  adminsOpen.value = true;
}
function toggleAdmin(id: string): void {
  if (!saving.value) adminIds.value = toggleGroupSelection(adminIds.value, id);
}

const adminHeight = computed((): number => Math.min(640, 260 + members.value.length * 60));
const inviteHeight = computed((): number =>
  Math.min(
    620,
    Math.max(
      330,
      240 +
        friends.value.filter(
          (person: UTSJSONObject): boolean =>
            !members.value.some((m: UTSJSONObject): boolean => s(m, 'id') == s(person, 'id')),
        ).length *
          65,
    ),
  ),
);
const availableFriends = computed((): UTSJSONObject[] =>
  friends.value.filter(
    (person: UTSJSONObject): boolean =>
      !members.value.some((member: UTSJSONObject): boolean => s(member, 'id') == s(person, 'id')) &&
      (groupPersonName(person) + ' ' + s(person, 'account'))
        .toLowerCase()
        .includes(inviteQuery.value.trim().toLowerCase()),
  ),
);
let ticket = 0, pageEpoch = 0, inviteTicket = 0;
let closing = false, disposed = false;
function acceptsResult(epoch: number, owner: string): boolean {
  return !closing && !disposed && epoch == pageEpoch && owner == session.userId;
}
async function load() {
  if (closing || disposed || groupId.value.length == 0 || !requireSession()) return;
  const current = ++ticket,
    owner = session.userId, epoch = pageEpoch;
  loading.value = s(group.value, 'id').length == 0;
  try {
    const result = obj(await reminder('groups/detail', null, { groupId: groupId.value }), 'value');
    if (current != ticket || !acceptsResult(epoch, owner)) return;
    group.value = result;
    error.value = '';
  } catch (e) {
    if (current == ticket && acceptsResult(epoch, owner)) error.value = message(e);
  } finally {
    if (current == ticket && acceptsResult(epoch, owner)) loading.value = false;
  }
}
function goBack(): void {
  if (closing || disposed) return;
  closing = true;
  pageEpoch++;
  ticket++;
  const failed = () => {
    if (disposed) return;
    closing = false;
    saving.value = false;
    friendsLoading.value = false;
    toast('返回失败，请重试');
    void load();
  };
  if (getCurrentPages().length > 1) uni.navigateBack({ fail: (_) => failed() });
  else uni.switchTab({ url: '/pages/me/index', fail: (_) => failed() });
}
async function mutate(action: string, data: UTSJSONObject): Promise<boolean> {
  if (closing || disposed || saving.value) return false;
  saving.value = true;
  formError.value = '';
  const owner = session.userId, epoch = pageEpoch;
  try {
    const result = await reminder('groups/' + action, { ...data, groupId: groupId.value });
    if (!acceptsResult(epoch, owner)) return false;
    if (action != 'member/remove' && action != 'dissolve') group.value = obj(result, 'value');
    return true;
  } catch (e) {
    if (!acceptsResult(epoch, owner)) return false;
    formError.value = message(e);
    toast(message(e));
    return false;
  } finally {
    if (acceptsResult(epoch, owner)) saving.value = false;
  }
}
function metadataSaved(value: UTSJSONObject): void {
  if (closing || disposed) return;
  group.value = value;
  editing.value = false;
  toast('群组资料已保存', 'success');
}
async function openInvite() {
  if (closing || disposed || role.value != 'OWNER') return;
  friends.value = [];
  friendsLoading.value = true;
  const owner = session.userId, epoch = pageEpoch, current = ++inviteTicket;
  inviteIds.value = [];
  inviteQuery.value = '';
  formError.value = '';
  inviting.value = true;
  try {
    const result = await reminder('friends/list');
    if (current == inviteTicket && acceptsResult(epoch, owner) && inviting.value)
      friends.value = (result['value'] as UTSJSONObject[]) ?? [];
  } catch (e) {
    if (current == inviteTicket && acceptsResult(epoch, owner) && inviting.value)
      formError.value = message(e);
  } finally {
    if (current == inviteTicket && acceptsResult(epoch, owner)) friendsLoading.value = false;
  }
}
function canInviteFriend(person: UTSJSONObject): boolean {
  return ['MUTUAL', 'I_CAN_REMIND'].includes(s(person, 'permissionMode'));
}
function toggleInvite(id: string): void {
  const person = friends.value.find((p: UTSJSONObject): boolean => s(p, 'id') == id);
  if (saving.value || person == null || !canInviteFriend(person)) return;
  inviteIds.value = toggleGroupSelection(inviteIds.value, id);
}
async function invite() {
  if (inviteIds.value.length == 0) return;
  if (await mutate('invite', { userIds: inviteIds.value })) {
    inviting.value = false;
    toast('好友已加入群组', 'success');
  }
}
function openPerson(person: UTSJSONObject): void {
  personHeight.value = Math.min(
    590,
    Math.max(
      460,
      400 +
        Math.ceil(arr(person, 'tags').length / 3) * 32 +
        Math.ceil(
          tags.value.filter(
            (tag: UTSJSONObject): boolean =>
              !arr(person, 'tags').some(
                (label: UTSJSONObject): boolean => s(label, 'name') == s(tag, 'name'),
              ),
          ).length / 3,
        ) *
          32,
    ),
  );
  selected.value = person;
  personTags.value = arr(person, 'tags').map((tag: UTSJSONObject): string => s(tag, 'name'));
  newPersonTag.value = '';
  addingPersonTag.value = false;
  formError.value = '';
  personOpen.value = true;
}
function editSelfTags(): void {
  const self = members.value.find(
    (person: UTSJSONObject): boolean => s(person, 'id') == session.userId,
  );
  if (self != null) openPerson(self);
}
function togglePersonTag(name: string): void {
  if (canEditPerson.value) personTags.value = toggleGroupSelection(personTags.value, name);
}
function addPersonTag(): void {
  const value = newPersonTag.value.trim();
  if (value.length == 0) return;
  if (!personTags.value.includes(value)) personTags.value = personTags.value.concat([value]);
  newPersonTag.value = '';
  addingPersonTag.value = false;
}
async function savePersonTags() {
  addPersonTag();
  if (await mutate('member/tags', { userId: s(selected.value, 'id'), tags: personTags.value })) {
    personOpen.value = false;
    toast('标签已保存', 'success');
  }
}
async function removeMember() {
  if (!(await confirm('移出群组', '移出后，该成员不再参与新的群组选人，已创建事件保留。'))) return;
  if (await mutate('member/remove', { userId: s(selected.value, 'id') })) {
    personOpen.value = false;
    await load();
  }
}
function openCatalog(): void {
  catalogOpen.value = true;
  tagEditing.value = false;
  formError.value = '';
}
function editTag(tag: UTSJSONObject): void {
  tagId.value = s(tag, 'id');
  tagName.value = s(tag, 'name');
  tagPeople.value = members.value
    .filter((person: UTSJSONObject): boolean =>
      arr(person, 'tags').some((label: UTSJSONObject): boolean => s(label, 'id') == tagId.value),
    )
    .map((person: UTSJSONObject): string => s(person, 'id'));
  tagEditing.value = true;
  formError.value = '';
}
async function saveAdmins() {
  if (await mutate('admins', { userIds: adminIds.value })) {
    adminsOpen.value = false;
    toast('管理员已更新', 'success');
  }
}
function editCatalogTag(tag: UTSJSONObject): void {
  catalogOpen.value = true;
  editTag(tag);
}
async function removePerson(person: UTSJSONObject) {
  selected.value = person;
  await removeMember();
}
function toggleTagPerson(id: string): void {
  tagPeople.value = toggleGroupSelection(tagPeople.value, id);
}
async function saveTag() {
  if (tagName.value.trim().length == 0) {
    formError.value = '请输入标签名称';
    return;
  }
  if (
    await mutate('tags/save', {
      tagId: tagId.value.length == 0 ? null : tagId.value,
      name: tagName.value.trim(),
      userIds: tagPeople.value,
    })
  ) {
    tagEditing.value = false;
    toast('标签已保存', 'success');
  }
}
function submitCatalog(): void {
  if (tagEditing.value) {
    void saveTag();
  } else {
    editTag({} as UTSJSONObject);
  }
}
async function deleteTag() {
  if (!(await confirm('删除标签', '此标签将从群组所有成员中移除，人员与历史事件保留。'))) return;
  if (await mutate('tags/delete', { tagId: tagId.value })) tagEditing.value = false;
}
async function dissolve() {
  if (
    !(await confirm(
      '解散群组',
      '确定解散这个群组吗？解散后不可恢复，成员不能再通过它发起提醒，已创建事件继续保留和处理。',
    ))
  )
    return;
  if (await mutate('dissolve', {})) {
    toast('群组已解散', 'success');
    goBack();
  }
}
async function leave() {
  if (!(await confirm('退出群组', '退出后不能再查看该群组或以它发起新提醒，已创建事件保留。')))
    return;
  if (await mutate('member/remove', { userId: session.userId })) goBack();
}
onLoad((options) => {
  groupId.value = options['id'] ?? '';
});
onShow(() => {
  void load();
});
function disposePage(): void {
  disposed = true;
  pageEpoch++;
  ticket++;
}
// Native swipe-back does not go through our button handler. Invalidate pending
// callbacks before Vue tears down the component tree as well as on page unload.
onBeforeUnmount(disposePage);
onUnload(disposePage);
// #ifdef APP-ANDROID
onBackPress((): boolean => updates.required && updates.available);
// #endif
</script>
