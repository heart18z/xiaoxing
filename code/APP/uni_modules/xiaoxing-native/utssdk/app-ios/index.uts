import { NativeResult } from '../interface.uts'
export function secureRead(key: string): string {return XiaoxingBridge.read(key)}
export function secureWrite(key: string,value: string): boolean {return XiaoxingBridge.write(key,value)}
export function randomHex(length: number): string {return XiaoxingBridge.random(length.toInt())}
export function nativeCall(action: string,input: string,callback: NativeResult): void {
  if (action.startsWith('stream.')) { XiaoxingStream.call(action,input,callback); return }
  XiaoxingBridge.call(action,input,callback)
}

// Explicitly retain the callback across SSE frames. Register once per app runtime;
// individual stream.watch calls only acknowledge startup and remain one-shot.
@UTSJS.keepAlive
export function onStreamEvent(callback: NativeResult): void {
  XiaoxingStream.listen(callback)
}
