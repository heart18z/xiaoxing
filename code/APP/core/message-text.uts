// iOS uses native text blocks instead of a large rich-text surface inside scroll-view.
// Preserve content and line breaks while keeping each native layout bounded.
export type MessageSpan = { text: string; bold: boolean; code: boolean };
export type MessageBlock = { text: string; kind: string; spans: MessageSpan[] };
function inlineSpans(value: string, heading: boolean): MessageSpan[] {
  const spans: MessageSpan[] = [];
  // Keep unmatched streaming delimiters visible. Text is never interpreted as HTML.
  let remaining = value;
  while (remaining.length > 0) {
    const match = /\*\*([^*]+)\*\*|__([^_]+)__|`([^`]+)`/.exec(remaining);
    if (match == null) { spans.push({text: remaining, bold: heading, code: false}); break; }
    const start = match.index;
    if (start > 0) spans.push({text: remaining.slice(0, start), bold: heading, code: false});
    const code = match[0].startsWith('`');
    spans.push({text: match[0].slice(code ? 1 : 2, code ? -1 : -2), bold: heading || !code, code: code});
    remaining = remaining.slice(start + match[0].length);
  }
  return spans;
}
export function messageBlocks(content: string): MessageBlock[] {
  const blocks: MessageBlock[] = [];
  let code = false;
  for (const line of content.replace(/\r\n/g, '\n').split('\n')) {
    if (line.trim().startsWith('```')) { code = !code; continue; }
    const heading = !code && /^#{1,6}\s/.test(line);
    const formatted = code ? line : line
      .replace(/^#{1,6}\s+/, '')
      .replace(/^\s*[-*+]\s+/, '• ')
      .replace(/^>\s?/, '│ ')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '$1（$2）');
    if (formatted.length == 0) { blocks.push({text: ' ', kind: 'space', spans: [{text:' ',bold:false,code:false}]}); continue; }
    const kind = code ? 'code' : heading ? 'heading' : /^\s*(?:[-*+]\s|\d+[.)]\s|•\s)/.test(line) ? 'list' : 'body';
    const source: MessageSpan[] = code ? [{text:formatted,bold:false,code:true}] : inlineSpans(formatted, heading);
    let spans: MessageSpan[] = [];
    let text = '';
    for (const span of source) {
      let remaining = span.text;
      while (remaining.length > 0) {
        let length = Math.min(900 - text.length, remaining.length);
        const last = remaining.charCodeAt(length - 1) ?? 0;
        if (length < remaining.length && last >= 0xd800 && last <= 0xdbff) length--;
        if (length == 0) { blocks.push({text:text,kind:kind,spans:spans}); text=''; spans=[]; continue; }
        const part = remaining.slice(0, length);
        spans.push({text:part,bold:span.bold,code:span.code}); text += part;
        remaining = remaining.slice(length);
        if (text.length == 900) { blocks.push({text:text,kind:kind,spans:spans}); text=''; spans=[]; }
      }
    }
    if (text.length > 0) blocks.push({text:text,kind:kind,spans:spans});
  }
  return blocks;
}
