export const LEGAL_VERSION = '2026-10-30';
export type LegalSection = { title: string; body: string };

export function legalSections(privacy: boolean, english: boolean): LegalSection[] {
  if (english) return privacy ? [
    { title: '1. Who is responsible', body: 'AI Xiaoxing is operated by Chen Tong, an individual operator. For privacy questions or requests, email 49823778@qq.com. This notice explains the processing of information when you use accounts, AI conversations, reminders, friends, groups and attachments.' },
    { title: '2. Information needed for the service', body: 'We process your account identifier, password verification information, email and verification codes for registration, sign-in, security and recovery. A phone number is optional. Your name, avatar and friend remarks support identification. We process messages, event content and times, recipients, group membership and tags, feedback, read receipts and operation records to deliver and manage reminders. Information you send to another user becomes visible to the relevant recipient; group membership does not grant unrestricted access to private conversations.' },
    { title: '3. Images, audio and AI processing', body: 'When you choose to upload an image or file, or use voice input, the selected content is processed for recognition, transcription, AI analysis or delivery. Relevant conversation context, event information and selected attachments may be sent to the model or speech service configured for this service or in your model settings. Do not upload information you are not entitled to share. AI output may be inaccurate; verify dates, recipients and attachments before confirming. Configuring a personal model involves processing its endpoint, model name and access credentials; credentials are not displayed to other users.' },
    { title: '4. Optional device permissions', body: 'Camera, selected photos/files and microphone or speech permissions are used only for the corresponding actions. Notifications and device push tokens enable reminder delivery. Supported devices may also use local alarms and Live Activities; reminder text may appear on the lock screen. Android may request alarm or installation access for an alarm or app update. Declining optional permissions affects the corresponding feature, not account sign-in or text reminders. You can change permissions and notification previews in system settings.' },
    { title: '5. Storage and service providers', body: 'The app stores session information, language preferences and necessary caches on your device. The server stores account, conversation, event, attachment and delivery records needed to provide the service. Network, operating-system, app-version and diagnostic information may be processed for security and troubleshooting. The app uses the DCloud uni-app runtime and operating-system services, including Apple notification services on iOS. Cloud hosting, email and configured AI or speech services process information needed for their functions. Where legally required, we provide additional notice and obtain separate consent before sharing with another independent processor or transferring personal information abroad. General agreement to this notice does not replace such consent.' },
    { title: '6. Retention and protection', body: 'We retain personal information only for the period necessary for the stated purpose or required by law, and use access controls, encrypted transport and credential protection. Operational records or backups may need to remain for security, dispute handling or legal retention; such retained data is restricted to those purposes. No transmission or storage method is risk-free. We will handle a personal-information incident and notify affected users or authorities when required by law.' },
    { title: '7. Your choices and rights', body: 'You can edit profile details, manage friends and reminder permissions, stop events, and change device permissions in the app or system settings. Settings → Close account permanently disables the account and unbinds its email and phone number; this is not a promise of immediate erasure of every historical record. For access, copies, correction, deletion, withdrawal of consent, retention questions or complaints, email 49823778@qq.com. After verifying identity using proportionate information, we will respond within 15 working days or explain any lawful limitation. Withdrawal does not affect processing lawfully performed before it.' },
    { title: '8. Children and changes', body: 'The service is not intended for children under 14. If you believe a child has provided personal information, contact us for handling. For a material change to processing purposes, methods or information categories, we will give prominent notice and seek renewed consent where required. Updated policies are available from the login page and Settings.' },
  ] : [
    { title: '1. Operator and scope', body: 'AI Xiaoxing is a reminder and collaboration application operated by Chen Tong, an individual operator. Contact: 49823778@qq.com. These terms govern your use of accounts, AI conversations, events, friends, groups, attachments and supported notification features. Read these terms and the Privacy Policy before agreeing and signing in.' },
    { title: '2. Your account', body: 'Provide accurate information you are entitled to use, keep your password and verification codes confidential, and report suspected compromise promptly. You may sign in using supported account or email methods. Confirming a sign-in on another device may end an existing session. Do not impersonate another person or access another account without permission. Children under 14 should not register.' },
    { title: '3. Reminders and collaboration', body: 'Confirm event content, time, time zone, recipients and attachments before sending. Sending reminders to others is subject to the relevant friendship and reminder permissions. Group owners and administrators manage membership and tags; members send only within their own permitted scope. Recipients can provide feedback; changes, completion and stopping are recorded in the event. Do not use the service for spam, harassment or unlawful content.' },
    { title: '4. AI and delivery limitations', body: 'AI can misunderstand text, images, speech, names or times. Review important results and correct errors. Notifications, alarms and Live Activities depend on system permissions, device support, connectivity, battery settings and platform services, so delivery at an exact time is not guaranteed. Keep an independent backup for safety-critical, medical, legal or financial deadlines. These limitations do not exclude responsibilities that cannot lawfully be excluded.' },
    { title: '5. Content and rights', body: 'You retain rights in the content you submit. You authorize only the processing, storage and transmission needed to provide the requested service. Upload and send only material you are entitled to use and disclose. Do not infringe privacy, intellectual property or other lawful rights. The app and its original software and design are protected by applicable law.' },
    { title: '6. Changes, restrictions and closure', body: 'We may maintain, update or adjust the service and will give reasonable notice of material changes where practicable. We may restrict misuse as necessary, explain the reason where permitted and provide a way to contact us. You can stop using the service and request account closure in Settings. Closure disables the account and unbinds contacts; treatment of retained information is described in the Privacy Policy. Any future paid feature will disclose its price and rules before purchase.' },
    { title: '7. Disputes and updated terms', body: 'These terms are governed by applicable laws of the People’s Republic of China, without depriving you of mandatory rights. Contact 49823778@qq.com first to seek resolution; unresolved disputes may be brought before a court with lawful jurisdiction. A material change to these terms will be prominently notified and renewed agreement requested where required. An invalid provision does not invalidate the remaining lawful provisions.' },
  ];
  return privacy ? [
    { title: '一、运营主体与适用范围', body: 'AI小醒由个人主体陈通运营。隐私联系邮箱：49823778@qq.com。本政策说明账号、AI对话、提醒事件、好友、群组和附件等功能中的个人信息处理方式。我们遵循合法、正当、必要原则处理信息。' },
    { title: '二、提供服务所需的信息', body: '注册、登录、验证身份及找回密码需要处理账号标识、密码验证信息、邮箱及验证码；手机号为选填信息。姓名、头像、好友备注用于识别用户。为了创建和跟进提醒，我们处理对话内容、事件内容和时间、接收人、群组成员和标签、反馈、已读状态及操作记录。你向他人发送的提醒及相关附件，会向对应接收人展示；加入群组不代表可以任意查看其他人的私人对话。' },
    { title: '三、图片、语音与AI服务', body: '当你主动选择图片或文件、拍照或使用语音输入时，我们处理你选择的内容，用于识别、转写、AI分析或按你的要求传递。相关对话上下文、事件信息及选定附件可能发送给系统配置或你在模型设置中选择的AI、语音服务进行处理。请勿上传无权分享的信息。AI可能理解错误，请核对日期、接收人及附件后确认。个人模型配置涉及服务地址、模型名称和访问密钥，密钥不会向其他用户展示。' },
    { title: '四、可选的手机权限', body: '相机用于拍照；相册或文件访问用于选择、保存附件；麦克风和语音识别用于语音输入。通知权限和设备推送标识用于发送提醒。受支持设备还可使用本机闹铃、实时活动，提醒内容可能显示在锁屏上。安卓可能在设置闹铃或安装更新时申请相应权限。拒绝可选权限只影响对应功能，不影响账号登录、文字提醒等基础功能。你可以随时在系统设置中调整权限及锁屏预览。' },
    { title: '五、存储与服务提供方', body: '设备本地保存登录状态、语言偏好和必要缓存；服务端保存提供服务所需的账号、对话、事件、附件及投递记录。为保障安全和排查故障，可能处理网络、操作系统、应用版本及诊断信息。应用使用DCloud uni-app运行环境及操作系统服务，iOS通知使用Apple通知服务；云托管、邮件及所配置的AI、语音服务按其功能处理必要信息。涉及向独立个人信息处理者提供信息或向境外提供个人信息时，我们将在法律要求的情形下另行告知并取得单独同意；同意本政策不替代该等单独同意。' },
    { title: '六、保存期限与安全保护', body: '个人信息仅在实现本政策目的所必需的期限内或法律规定期限内保存，并采取访问控制、传输加密、凭据保护等措施。为安全审计、争议处理或法定义务必须保留的记录和备份，将限制在相应目的内使用。没有任何系统能够保证绝对安全；发生个人信息安全事件时，我们将依法处置并履行适用的告知、报告义务。' },
    { title: '七、你的权利与注销', body: '你可以修改资料、管理好友及提醒权限、停止事件，并在系统设置中撤回设备权限。在“设置—注销账号”可永久停用账号并解除邮箱、手机号绑定，这不代表所有历史记录会立即物理删除。如需查阅、复制、更正、删除个人信息、撤回同意，或咨询保存期限、提出投诉，请联系49823778@qq.com。我们在采用必要且适度的方式核验身份后，将在15个工作日内答复，无法依法办理时说明原因。撤回同意不影响此前基于同意已进行的合法处理。' },
    { title: '八、未成年人及政策更新', body: '本服务不面向不满14周岁的儿童。发现儿童已向我们提供个人信息时，请联系上述邮箱处理。处理目的、方式或信息种类发生重大变化时，我们会以显著方式告知，并在法律要求时重新征求同意。你可在登录页及设置中查阅本政策。' },
  ] : [
    { title: '一、服务与运营主体', body: 'AI小醒是由个人主体陈通运营的智能提醒与协作应用，联系邮箱：49823778@qq.com。本协议适用于账号、AI对话、事件、好友、群组、附件及受支持的通知功能。请阅读本协议及《隐私政策》，理解后再同意并登录。' },
    { title: '二、账号使用', body: '请提供真实且有权使用的信息，妥善保管密码和验证码，发现账号被冒用及时联系我们。你可使用支持的账号或邮箱方式登录；确认在其他设备登录时，原设备的会话可能结束。不得冒用他人身份或未经授权访问他人账号。不满14周岁的儿童请勿注册使用本服务。' },
    { title: '三、提醒、群组与协作', body: '发送前请确认事件内容、时间、时区、接收人及附件。向他人发起提醒须符合相应好友关系及提醒权限。群主和管理员管理群组成员及标签；成员仅能在自己具备权限的范围内发送提醒。接收人可反馈进展，事件变更、完成和停止将记录在事件中。不得利用本服务发送垃圾信息、骚扰他人或传播违法内容。' },
    { title: '四、AI与提醒的局限', body: 'AI可能误解文字、图片、语音、姓名或时间，请复核重要结果并及时纠正。消息通知、本机闹铃及实时活动受系统权限、设备支持、网络、电量策略和平台服务影响，无法保证每次在精确时刻送达。涉及人身安全、医疗、法律或重大财务等重要事项，请同时保留独立可靠的提醒方式。这些说明不免除依法不能免除的责任。' },
    { title: '五、内容与权利', body: '你保留所提交内容的合法权利，仅授权我们为提供你请求的服务进行必要处理、存储及传递。请确保上传、发送的文字、图片、录音及文件有合法来源和分享权限，不侵犯他人隐私、知识产权或其他权益。本应用及原创软件、设计受相关法律保护。' },
    { title: '六、服务调整与退出', body: '我们可为维护、安全及产品改进调整服务，对重大变化在可行范围内提前告知。发现滥用时，可采取必要且适度的限制措施，在法律允许范围内说明原因并提供联系渠道。你可停止使用服务，或在设置中申请注销。注销将停用账号并解绑联系方式，保留信息的处理见《隐私政策》。若未来提供收费功能，将在购买前明确说明价格和规则。' },
    { title: '七、争议及协议更新', body: '本协议适用中华人民共和国相关法律，不排除你依法享有的强制性权益。有争议时可先通过49823778@qq.com协商；协商不成，可向依法有管辖权的人民法院解决。本协议重大变更会显著告知，并在法律要求时重新取得同意；部分条款无效不影响其余合法条款的效力。' },
  ];
}
