<script setup lang="uts">
import { watch } from 'vue';
import { checkUpdates, resetUpdateSession } from '@/services/updates.uts';
import { syncLanguage } from '@/api/request.uts';
import { restoreSession, session } from '@/store/session.uts';
import { pauseChat, resume, resetChat } from '@/services/chat.uts';
import {
  startNative,
  syncPush,
  reconcileAlarms,
  checkNotificationTap,
  refreshRingingAlarm,
  refreshNotificationPermission,
  alarmState,
} from '@/services/native.uts';
watch(
  (): string => session.userId,
  () => {
    resetChat();
    alarmState.ringing = false;
    resetUpdateSession();
    if (session.userId.length > 0) void checkUpdates(true);
  },
  { flush: 'sync' },
);
onLaunch(() => {
  restoreSession();
  void startNative().catch(() => {});
});
onShow(() => {
  session.visible = true;
  void refreshNotificationPermission().catch(() => {});
  void syncLanguage().catch(() => {});
  if (session.userId.length > 0) {
    void checkUpdates(true);
    void resume().catch(() => {});
    void syncPush();
    void reconcileAlarms().catch(() => {});
    void checkNotificationTap().catch(() => {});
    void refreshRingingAlarm().catch(() => {});
  }
});
onHide(() => {
  session.visible = false;
  pauseChat();
});
</script>
<style>
@import './styles/theme.css';
</style>
